<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:arknights_random_team.Models"
             xmlns:views="clr-namespace:arknights_random_team.Views"
             mc:Ignorable="d"
             d:DesignWidth="760"
             d:DesignHeight="640"
             x:Class="arknights_random_team.Views.GenerateView"
             x:DataType="views:GenerateView"
             FontFamily="{StaticResource AppFont}">
    <Grid RowDefinitions="Auto,20,*">
        <Border Grid.Row="0" Classes="surface" Padding="0" ClipToBounds="True">
            <Grid RowDefinitions="4,*">
                <Border Grid.Row="0"
                        HorizontalAlignment="Stretch"
                        Background="{StaticResource AppPrimaryBrush}" />
                <Grid Grid.Row="1"
                      Margin="20,16,20,20"
                      ColumnDefinitions="*,20,190,20,112"
                      RowDefinitions="Auto,8,44">
                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Classes="field-label"
                               Text="使用策略" />
                    <ComboBox Name="StrategyCombo"
                              Grid.Row="2"
                              Grid.Column="0"
                              Classes="form-control dense"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="选择策略">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="views:StrategyComboItem">
                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Grid Grid.Row="0" Grid.Column="2" ColumnDefinitions="*,Auto">
                        <TextBlock Classes="field-label" Text="阵容人数" />
                        <Border Grid.Column="1"
                                MinWidth="34"
                                Padding="8,2"
                                Background="{StaticResource AppPrimarySoftBrush}"
                                CornerRadius="5">
                            <TextBlock Name="RandomNumText"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AppPrimaryBrush}"
                                       Text="1" />
                        </Border>
                    </Grid>
                    <Border Grid.Row="2"
                            Grid.Column="2"
                            Classes="input-shell"
                            Padding="10,0">
                        <Slider Name="CountSlider"
                                Height="40"
                                Margin="0"
                                VerticalAlignment="Center"
                                ZIndex="10"
                                ClipToBounds="False"
                                Minimum="1"
                                Maximum="12"
                                TickFrequency="1"
                                TickPlacement="None"
                                IsSnapToTickEnabled="True"
                                Theme="{StaticResource MaterialDiscreteSliderV}"
                                Value="1"
                                PropertyChanged="CountSlider_OnPropertyChanged" />
                    </Border>

                    <Button Grid.Row="2"
                            Grid.Column="4"
                            Height="44"
                            Classes="primary"
                            Content="生成阵容"
                            Click="Generate_Click" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" RowDefinitions="Auto,12,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <Border Width="4"
                            Height="24"
                            Background="{StaticResource AppSignalBrush}"
                            CornerRadius="2" />
                    <TextBlock Classes="section-title"
                               VerticalAlignment="Center"
                               Text="阵容结果" />
                </StackPanel>
                <TextBlock Name="ResultCountText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Classes="caption"
                           Text="0 名干员" />
            </Grid>

            <Border Grid.Row="2" Classes="surface data-frame" ClipToBounds="True">
                <Grid>
                    <DataGrid Name="ResultGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserReorderColumns="False"
                              ItemsSource="{Binding ResultList}"
                              Sorting="ResultGrid_Sorting">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="2*"
                                                MinWidth="150"
                                                Header="名称"
                                                SortMemberPath="Name"
                                                Binding="{Binding Name, x:DataType=models:Staff}" />
                            <DataGridTextColumn Width="1.4*"
                                                MinWidth="110"
                                                Header="等级"
                                                SortMemberPath="Level.Description"
                                                Binding="{Binding Level.Description, x:DataType=models:Staff}" />
                            <DataGridTextColumn Width="*"
                                                MinWidth="80"
                                                Header="稀有度"
                                                SortMemberPath="Star"
                                                Binding="{Binding Star, x:DataType=models:Staff}" />
                            <DataGridTextColumn Width="*"
                                                MinWidth="88"
                                                Header="职业"
                                                SortMemberPath="Career"
                                                Binding="{Binding Career, x:DataType=models:Staff}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Name="ResultEmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Spacing="10">
                        <Border Width="32"
                                Height="3"
                                HorizontalAlignment="Center"
                                Background="{StaticResource AppPrimaryBrush}"
                                CornerRadius="2" />
                        <TextBlock Classes="muted"
                                   HorizontalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="尚未生成阵容" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

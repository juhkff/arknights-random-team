<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:arknights_random_team.Models"
             xmlns:views="clr-namespace:arknights_random_team.Views"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="650"
             x:Class="arknights_random_team.Views.GenerateView"
             x:DataType="views:GenerateView"
             FontFamily="{StaticResource AppFont}">
    <UserControl.Styles>
        <Style Selector="Button.count-preset">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}" />
        </Style>
        <Style Selector="Button.count-preset.selected">
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource AppPrimarySoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="Button.count-preset:pointerover">
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
            <Setter Property="Background" Value="{StaticResource AppSecondaryHoverBrush}" />
        </Style>
        <Style Selector="Button.count-preset:pressed">
            <Setter Property="Background" Value="{StaticResource AppSecondaryPressedBrush}" />
        </Style>
        <Style Selector="Button.count-preset.selected:pointerover">
            <Setter Property="Background" Value="{StaticResource AppPrimaryHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppOnPrimaryBrush}" />
        </Style>
        <Style Selector="Button.count-preset.selected:pressed">
            <Setter Property="Background" Value="{StaticResource AppPrimaryPressedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppOnPrimaryBrush}" />
        </Style>
        <!--
            人数增减按钮：32×32 圆角方块，图标改用矢量 Path（原来用 − / ＋ 两个不同字体字符，
            宽度不一致，全角加号还会渲染出彩色亚像素毛边）。
        -->
        <Style Selector="Button.count-step">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource AppRadiusSurface}" />
            <Setter Property="Background" Value="{StaticResource AppSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.count-step Path">
            <Setter Property="Stroke" Value="{StaticResource AppMutedTextBrush}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeLineCap" Value="Round" />
        </Style>
        <Style Selector="Button.count-step:pointerover">
            <Setter Property="Background" Value="{StaticResource AppPrimarySoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="Button.count-step:pointerover Path">
            <Setter Property="Stroke" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="Button.count-step:pressed">
            <Setter Property="Background" Value="{StaticResource AppSecondaryPressedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryPressedBrush}" />
        </Style>
        <Style Selector="Button.count-step:disabled">
            <Setter Property="Opacity" Value="0.4" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="Button.count-step:disabled Path">
            <Setter Property="Stroke" Value="{StaticResource AppMutedTextBrush}" />
        </Style>


        <!-- 编队卡片 -->
        <Style Selector="TextBlock.roster-name">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.roster-pips">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LetterSpacing" Value="1.5" />
            <Setter Property="Foreground" Value="{StaticResource AppSignalBrush}" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <!--
            阵容人数滑块。
            原先用 Material 的离散滑块主题（MaterialDiscreteSliderV），有三个问题：
              · 圆点被画成 Material 默认青色 #009688，与应用薄荷绿不一致
              · 圆点末端向外探出，且悬停有一圈光环
              · 滑块与两侧「−」「＋」按钮之间只有 0~1px 间隙，光环会直接压到按钮上
            这里按 Avalonia 官方 Slider 模板的结构重写，改用应用配色：
              · 底轨 / 填充段 = Track 的 Increase / Decrease 两个 RepeatButton
                （宽度由 Track 按值分配给它们，所以不能用普通 Border 代替）
              · 卡槽用「中间调填充 + 1px 描边」，比纯暗色更容易看清范围
              · 圆点用自己的主题，无悬停光环
              · 控件上下留白把圆点收在内部，左右留白让轨道两端不贴边
        -->
        <ControlTheme x:Key="AppCountSliderThumb" TargetType="Thumb">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Ellipse Width="20"
                             Height="20"
                             Fill="{StaticResource AppPrimaryBrush}" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <!-- 轨道分段外壳：把 TemplateBinding 的背景画成一条居中的圆角细线 -->
        <ControlTheme x:Key="AppCountSliderTrackPart" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Height="8"
                            VerticalAlignment="Center"
                            CornerRadius="{StaticResource AppRadiusControl}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="AppCountSlider" TargetType="Slider">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Minimum" Value="1" />
            <Setter Property="Maximum" Value="12" />
            <Setter Property="TickPlacement" Value="None" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <!-- Foreground = 已填充段（圆点左侧）；Background = 卡槽（圆点右侧） -->
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource AppWellBrush}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Margin="10,14" VerticalAlignment="Center">
                        <Track Name="PART_Track"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}"
                               Orientation="Horizontal"
                               IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_DecreaseButton"
                                              Theme="{StaticResource AppCountSliderTrackPart}"
                                              Background="{TemplateBinding Foreground}"
                                              BorderBrush="{StaticResource AppPrimaryBrush}"
                                              BorderThickness="1" />
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_IncreaseButton"
                                              Theme="{StaticResource AppCountSliderTrackPart}"
                                              Background="{TemplateBinding Background}"
                                              BorderBrush="{StaticResource AppBorderBrush}"
                                              BorderThickness="1" />
                            </Track.IncreaseButton>
                            <Track.Thumb>
                                <Thumb Theme="{StaticResource AppCountSliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,16,*">
        <Border Grid.Row="0" Classes="surface" Padding="20,16">
            <Grid RowDefinitions="Auto,16,Auto">
                <Grid Name="ConfigGrid" ColumnDefinitions="*,16,*">
                    <Grid Name="StrategyConfig" RowDefinitions="28,6,40,6,Auto">
                        <TextBlock Classes="field-label" Text="作战策略" />
                        <ComboBox Name="StrategyCombo" Grid.Row="2"
                                  Classes="form-control dense"
                                  HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="作战策略"
                                  PlaceholderText="选择策略">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="views:StrategyComboItem">
                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Grid.Row="4" Classes="caption" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Text="不选策略则自由随机；自定义规则前往「随机策略」。" />
                    </Grid>

                    <Grid Name="CountConfig" Grid.Column="2" RowDefinitions="28,6,40,6,32">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="field-label" Text="阵容人数" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5"
                                        VerticalAlignment="Center">
                                <TextBlock Name="RandomNumText" FontFamily="{StaticResource AppMonoFont}"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource AppPrimaryBrush}" Text="1" />
                                <TextBlock Name="TeamSizeLimitText" Classes="caption"
                                           VerticalAlignment="Center" Text="/ 12" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2" ColumnDefinitions="32,16,*,16,32">
                            <Button Name="DecreaseCountButton" Classes="count-step"
                                    AutomationProperties.Name="减少一名干员" ToolTip.Tip="减少一名干员"
                                    Click="DecreaseCount_Click">
                                <Path Width="12" Height="2" Stretch="None" Data="M 0,1 H 12" />
                            </Button>
                            <Slider Name="CountSlider" Grid.Column="2" Height="40"
                                    VerticalAlignment="Center" ZIndex="10" ClipToBounds="False"
                                    Minimum="1" Maximum="12" TickFrequency="1" TickPlacement="None"
                                    IsSnapToTickEnabled="True"
                                    SmallChange="1" LargeChange="1"
                                    AutomationProperties.Name="阵容人数"
                                    Theme="{StaticResource AppCountSlider}" Value="1"
                                    PropertyChanged="CountSlider_OnPropertyChanged" />
                            <Button Name="IncreaseCountButton" Grid.Column="4" Classes="count-step"
                                    AutomationProperties.Name="增加一名干员" ToolTip.Tip="增加一名干员"
                                    Click="IncreaseCount_Click">
                                <Path Width="12" Height="12" Stretch="None" Data="M 0,6 H 12 M 6,0 V 12" />
                            </Button>
                        </Grid>
                        <Grid Grid.Row="4" ColumnDefinitions="*,8,*,8,*,8,*">
                            <Button Name="SoloPresetButton" Classes="compact count-preset" Content="1 人" Tag="1"
                                    AutomationProperties.Name="选择一人阵容" Click="CountPreset_Click" />
                            <Button Name="FourPresetButton" Grid.Column="2" Classes="compact count-preset" Content="4 人" Tag="4"
                                    AutomationProperties.Name="选择四人阵容" Click="CountPreset_Click" />
                            <Button Name="SixPresetButton" Grid.Column="4" Classes="compact count-preset" Content="6 人" Tag="6"
                                    AutomationProperties.Name="选择六人阵容" Click="CountPreset_Click" />
                            <Button Name="FullPresetButton" Grid.Column="6" Classes="compact count-preset" Content="满编"
                                    Tag="{x:Static models:AppOptions.MaxTeamSize}"
                                    AutomationProperties.Name="选择满编阵容" Click="CountPreset_Click" />
                        </Grid>
                    </Grid>
                </Grid>

                <Button Name="GenerateButton" Grid.Row="2" Classes="primary" Height="44"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="生成随机阵容"
                        Content="生成阵容"
                        Click="Generate_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" RowDefinitions="Auto,12,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <TextBlock Classes="section-title" VerticalAlignment="Center" Text="出战名单" />
                <Border Grid.Column="1" Classes="chip" VerticalAlignment="Center"
                        Background="{StaticResource AppPrimarySoftBrush}"
                        BorderBrush="{StaticResource AppSecondaryBorderBrush}">
                    <TextBlock Name="ResultCountText" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource AppPrimaryBrush}" Text="0 名干员" />
                </Border>
            </Grid>

            <Border Grid.Row="2" Classes="surface" Padding="0" ClipToBounds="True">
                <Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl Name="RosterItems" Margin="16,16,16,8" ItemsSource="{Binding ResultList}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <views:AdaptiveWrapPanel MinItemWidth="248"
                                                                 MaxItemWidth="320"
                                                                 Spacing="12"
                                                                 FixedItemHeight="96" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerTheme>
                                    <ControlTheme TargetType="ContentPresenter">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    </ControlTheme>
                                </ItemsControl.ItemContainerTheme>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:Staff">
                                        <ContentControl Theme="{StaticResource AppRosterCardTheme}"
                                                        ToolTip.Tip="{Binding LevelLine}">
                                            <Grid ColumnDefinitions="64,12,*">
                                                <Border Classes="avatar-frame"
                                                        Width="64"
                                                        Height="64"
                                                        CornerRadius="{StaticResource AppRadiusSurface}"
                                                        BorderBrush="{StaticResource AppBorderBrush}"
                                                        Background="{StaticResource AppWellBrush}">
                                                    <views:StaffThumb Sources="{Binding AvatarUris}"
                                                                      PlaceholderSources="{Binding CareerIconUris}"
                                                                      PlaceholderSize="28"
                                                                      PlaceholderOpacity="0.7"
                                                                      Stretch="UniformToFill"
                                                                      VerticalArtAlignment="Center" />
                                                </Border>
                                                <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">
                                                    <Grid ColumnDefinitions="*,8,Auto">
                                                        <TextBlock Classes="roster-name"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding Name}" />
                                                        <Image Grid.Column="2"
                                                               Width="16"
                                                               Height="16"
                                                               Stretch="Uniform"
                                                               VerticalAlignment="Center"
                                                               views:ArtImage.Sources="{Binding CareerIconUris}" />
                                                    </Grid>
                                                    <StackPanel Grid.Row="2"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center"
                                                                Spacing="8">
                                                        <TextBlock Classes="roster-pips"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{Binding RarityBrush}"
                                                                   Text="{Binding RarityMark}" />
                                                        <TextBlock Classes="caption"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding LevelLine}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </ContentControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                    <StackPanel Name="ResultEmptyState" Margin="16,48,16,0"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False" Spacing="8">
                        <Path Width="38" Height="38" HorizontalAlignment="Center" Stretch="Uniform"
                              Stroke="{StaticResource AppPrimaryBrush}" StrokeThickness="1.4" Opacity="0.75"
                              Data="M 0,12 L 0,0 12,0 M 28,0 L 40,0 40,12 M 40,28 L 40,40 28,40 M 12,40 L 0,40 0,28 M 14,20 L 26,20 M 20,14 L 20,26" />
                        <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="等待部署" />
                        <TextBlock Classes="caption" HorizontalAlignment="Center" Text="选好策略与人数，点击「生成阵容」开始。" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

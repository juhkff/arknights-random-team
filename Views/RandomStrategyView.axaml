<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:domain="clr-namespace:arknights_random_team.Domain"
             mc:Ignorable="d"
             d:DesignWidth="760"
             d:DesignHeight="640"
             x:Class="arknights_random_team.Views.RandomStrategyView"
             FontFamily="{StaticResource AppFont}">
    <UserControl.Styles>
        <Style Selector="Border.strategy-card">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="Border.strategy-card:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="Border.rule-summary">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="{StaticResource AppWellBrush}" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,16,*">
        <Grid ColumnDefinitions="*,16,Auto">
            <TextBlock Name="StrategyCountText"
                       VerticalAlignment="Center"
                       Classes="caption"
                       Text="0 个方案" />
            <Button Grid.Column="2"
                    MinWidth="128"
                    VerticalAlignment="Center"
                    Classes="primary"
                    Content="新建策略"
                    Click="AddStrategy_Click" />
        </Grid>

        <Grid Grid.Row="2">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl Name="StrategyItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="domain:RandomStrategyDefinition">
                            <Border Classes="surface strategy-card">
                                <Grid RowDefinitions="Auto,8,Auto">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Margin="0,0,16,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="4">
                                            <Button Classes="text"
                                                    MinWidth="64"
                                                    Content="编辑"
                                                    Tag="{Binding}"
                                                    Click="EditStrategy_Click" />
                                            <Button Classes="icon compact"
                                                    Width="32" Height="32" MinWidth="32"
                                                    Content="⋯"
                                                    Tag="{Binding}"
                                                    AutomationProperties.Name="更多">
                                                <Button.Flyout>
                                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                        <MenuItem Header="删除策略"
                                                                  Tag="{Binding}"
                                                                  Click="DeleteStrategy_Click" />
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Rules}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="domain:StrategyRule">
                                                <Border Classes="rule-summary">
                                                    <TextBlock VerticalAlignment="Center"
                                                               Text="{Binding SummaryLine}"
                                                               TextWrapping="Wrap" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Name="StrategyEmptyState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Spacing="12">
                <TextBlock Classes="muted"
                           HorizontalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="暂无随机策略" />
                <TextBlock Classes="caption"
                           HorizontalAlignment="Center"
                           Text="新建规则，控制稀有度、职业与干员范围。" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

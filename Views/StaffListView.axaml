<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:domain="clr-namespace:arknights_random_team.Domain"
             xmlns:models="clr-namespace:arknights_random_team.Models"
             xmlns:views="clr-namespace:arknights_random_team.Views"
             xmlns:assists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             mc:Ignorable="d"
             d:DesignWidth="760"
             d:DesignHeight="640"
             x:Class="arknights_random_team.Views.StaffListView"
             x:Name="Root"
             x:DataType="domain:ListModel"
             FontFamily="{StaticResource AppFont}">
    <UserControl.Styles>
        <!-- 视图切换按钮（表格 / 卡片、头像 / 半身像） -->
        <Style Selector="ToggleButton.view-switch">
            <Setter Property="Theme" Value="{StaticResource AppActionButtonTheme}" />
            <Setter Property="MinWidth" Value="60" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.view-switch:pointerover">
            <Setter Property="Background" Value="{StaticResource AppSecondaryHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        </Style>
        <Style Selector="ToggleButton.view-switch:checked">
            <Setter Property="Background" Value="{StaticResource AppPrimarySoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- 仿游戏干员卡 -->
        <Style Selector="Border.operator-card">
            <!-- 竖版，接近官方干员卡 2:3 的比例 -->
            <Setter Property="Width" Value="146" />
            <Setter Property="Height" Value="214" />
            <Setter Property="Background" Value="{StaticResource AppWellBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
                </Transitions>
            </Setter>
        </Style>
        <!-- 职业色描边：悬停时加粗并配一圈同色外发光，让所选职业更醒目 -->
        <Style Selector="Border.operator-card:pointerover">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Background" Value="{StaticResource AppSurfaceSubtleBrush}" />
        </Style>
        <Style Selector="TextBlock.operator-card-stars">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="LetterSpacing" Value="0.5" />
            <Setter Property="Foreground" Value="{StaticResource AppSignalBrush}" />
        </Style>
        <Style Selector="TextBlock.operator-card-name">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        </Style>
        <Style Selector="CheckBox.card-select">
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style Selector="Button.card-delete">
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <!-- 删除按钮平时隐藏，悬停卡片或它本身时才显现，避免卡片上堆满控件 -->
        <Style Selector="Border.operator-card:pointerover Button.card-delete">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.card-delete:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="DataGridRow">
            <Setter Property="MinHeight" Value="64" />
        </Style>
        <Style Selector="CheckBox.staff-select">
            <Setter Property="assists:SelectionControlAssist.Size" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="Border.cell-hit">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ComboBox.staff-choice">
            <Setter Property="Theme" Value="{StaticResource MaterialComboBox}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="MaxHeight" Value="44" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource AppSurfaceSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="ClipToBounds" Value="False" />
        </Style>
        <Style Selector="DataGridCell TextBox.staff-editor">
            <Setter Property="Theme" Value="{StaticResource SoloTextBox}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="MaxHeight" Value="44" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Background" Value="{StaticResource AppInputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox.staff-choice:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="ComboBox.staff-choice:focus-within">
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="DataGridCell TextBox.staff-editor:focus-within">
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="Button.delete-staff">
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="Width" Value="48" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="22" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,18,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,16,Auto">
            <StackPanel VerticalAlignment="Center" Spacing="6">
                <TextBlock Classes="eyebrow" Text="OPERATOR ROSTER" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="4"
                            Height="28"
                            Background="{StaticResource AppSignalBrush}"
                            CornerRadius="2" />
                    <TextBlock Classes="section-title"
                               VerticalAlignment="Center"
                               Text="干员名单" />
                    <Border Padding="10,5"
                            Background="{StaticResource AppSurfaceSubtleBrush}"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppMutedTextBrush}"
                                   Text="{Binding StaffCount, StringFormat='共 {0} 名'}" />
                    </Border>
                    <Border Padding="10,5"
                            Background="{StaticResource AppAccentSoftBrush}"
                            BorderBrush="{StaticResource AppAccentBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppAccentBrush}"
                                   Text="{Binding SelectedStaffCount, StringFormat='已启用 {0} 名'}" />
                    </Border>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="10">
                <!-- 立绘加载统计：直观看出缓存命中程度 -->
                <TextBlock Classes="caption"
                           VerticalAlignment="Center"
                           IsVisible="{Binding IsCardView}"
                           Text="{Binding ArtLoadInfo}" />

                <!-- 视图切换：表格（可编辑排序）/ 卡片（看立绘） -->
                <Border Padding="3"
                        Background="{StaticResource AppWellBrush}"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <ToggleButton Name="GridViewButton"
                                      Classes="view-switch"
                                      Content="表格"
                                      AutomationProperties.Name="切换到表格视图"
                                      IsChecked="{Binding IsGridView, Mode=OneWay}"
                                      Click="GridView_Click" />
                        <ToggleButton Name="CardViewButton"
                                      Classes="view-switch"
                                      Content="卡片"
                                      AutomationProperties.Name="切换到卡片视图"
                                      IsChecked="{Binding IsCardView, Mode=OneWay}"
                                      Click="CardView_Click" />
                    </StackPanel>
                </Border>

                <!-- 卡片立绘规格：头像 / 半身像 -->
                <Border Name="GalleryToggle"
                        Padding="3"
                        Background="{StaticResource AppWellBrush}"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        IsVisible="{Binding IsCardView}">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <ToggleButton Name="AvatarModeButton"
                                      Classes="view-switch"
                                      Content="头像"
                                      AutomationProperties.Name="卡片显示头像"
                                      IsChecked="{Binding !UsePortrait, Mode=OneWay}"
                                      Click="AvatarMode_Click" />
                        <ToggleButton Name="PortraitModeButton"
                                      Classes="view-switch"
                                      Content="半身像"
                                      AutomationProperties.Name="卡片显示半身立绘"
                                      IsChecked="{Binding UsePortrait, Mode=OneWay}"
                                      Click="PortraitMode_Click" />
                    </StackPanel>
                </Border>

                <Button Name="ClearAllButton"
                        MinWidth="112"
                        Classes="danger"
                        Content="清空列表"
                        Click="ClearAll_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Classes="surface data-frame" ClipToBounds="True">
            <Grid>
                <DataGrid Name="StaffGrid"
                          IsVisible="{Binding IsGridView}"
                          AutoGenerateColumns="False"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="True"
                          HorizontalScrollBarVisibility="Auto"
                          SelectionMode="Single"
                          ItemsSource="{Binding StaffList}"
                          PreparingCellForEdit="StaffGrid_PreparingCellForEdit"
                          CellEditEnded="StaffGrid_CellEditEnded"
                          SelectionChanged="StaffGrid_SelectionChanged"
                          Sorting="StaffGrid_Sorting">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="64" MinWidth="64" MaxWidth="64" CanUserSort="False">
                            <DataGridTemplateColumn.Header>
                                <Border Classes="cell-hit" PointerPressed="SelectAllHeader_PointerPressed">
                                    <CheckBox Classes="staff-select"
                                              IsThreeState="True"
                                              IsChecked="{Binding #Root.((domain:ListModel)DataContext).IsAllStaffSelected, Mode=OneWay}"
                                              Click="SelectAll_Click" />
                                </Border>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Staff">
                                    <Border Classes="cell-hit" PointerPressed="SelectCell_PointerPressed">
                                        <CheckBox Classes="staff-select"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="2*"
                                                MinWidth="140"
                                                Header="名称"
                                                SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Staff">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate x:DataType="models:Staff">
                                    <TextBox Classes="staff-editor"
                                             Text="{Binding Name, Mode=TwoWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="1.3*"
                                                MinWidth="112"
                                                Header="等级"
                                                SortMemberPath="Level.Description">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Staff">
                                    <TextBlock Text="{Binding Level.Description}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate x:DataType="models:Staff">
                                    <TextBox Classes="staff-editor"
                                             Text="{Binding Level.Description, Mode=TwoWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="88"
                                                MinWidth="88"
                                                Header="稀有度"
                                                SortMemberPath="Star">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Staff">
                                    <TextBlock Text="{Binding Star}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate x:DataType="models:Staff">
                                    <ComboBox Classes="staff-choice dense"
                                              ItemsSource="{x:Static models:AppOptions.Stars}"
                                              SelectedItem="{Binding Star, Mode=TwoWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="104"
                                                MinWidth="96"
                                                Header="职业"
                                                SortMemberPath="Career">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Staff">
                                    <TextBlock Text="{Binding Career}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate x:DataType="models:Staff">
                                    <ComboBox Classes="staff-choice dense"
                                              ItemsSource="{x:Static models:AppOptions.Careers}"
                                              SelectedItem="{Binding Career, Mode=TwoWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="72" MinWidth="72" MaxWidth="72" Header="操作" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Staff">
                                    <Button Classes="danger compact delete-staff"
                                            Content="×"
                                            ToolTip.Tip="删除干员"
                                            Tag="{Binding}"
                                            Click="Delete_Click" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!--
                    卡片视图：仿游戏干员卡——立绘、职业徽记与配色描边、稀有度、精英等级，
                    并可直接勾选参与随机 / 删除。
                -->
                <ScrollViewer IsVisible="{Binding IsCardView}"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl Name="StaffCards"
                                  Margin="16"
                                  ItemsSource="{Binding StaffList}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Staff">
                                <Border Classes="operator-card"
                                        BorderBrush="{Binding CareerBrush}"
                                        Margin="0,0,12,12"
                                        ToolTip.Tip="点击卡片切换参与随机">
                                    <Grid>
                                        <!--
                                            立绘按比例缩放并顶部对齐：半身像是 1:2 的竖图，
                                            用 UniformToFill 会放大后居中裁切，把头切掉且过度放大。
                                            这里改为按宽铺满 + 顶部对齐：横向铺满卡片，纵向从顶部开始，
                                            露出头部与上身，超出卡片的部分由 ClipToBounds 裁掉。
                                            半身像是 1:2 竖图，卡片接近 2:3，保留的是上半段。
                                        -->
                                        <Image Stretch="UniformToFill"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Top"
                                               Opacity="{Binding IsSelected, Converter={x:Static views:StaffCardVisual.ArtOpacity}}"
                                               views:ArtImage.Sources="{Binding DisplayArtUris}"
                                               views:ArtImage.AlternateSources="{Binding AlternateArtUris}" />

                                        <!-- 底部渐深，保证名字与数值始终读得清 -->
                                        <Border VerticalAlignment="Bottom"
                                                Height="74">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                    <GradientStop Offset="0" Color="#000B1118" />
                                                    <GradientStop Offset="0.45" Color="#D90B1118" />
                                                    <GradientStop Offset="1" Color="#F20B1118" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <!-- 顶部压深，突出职业图标与勾选 -->
                                        <Border VerticalAlignment="Top"
                                                Height="44">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                    <GradientStop Offset="0" Color="#B30B1118" />
                                                    <GradientStop Offset="1" Color="#000B1118" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <!-- 无立绘时（手动录入的干员）用官方职业图标占位 -->
                                        <Image Width="56"
                                               Height="56"
                                               Opacity="0.3"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !HasArt}"
                                               views:ArtImage.Sources="{Binding CareerIconUris}" />

                                        <!-- 官方职业图标 -->
                                        <Image Width="26"
                                               Height="26"
                                               Margin="7"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               views:ArtImage.Sources="{Binding CareerIconUris}" />

                                        <!-- 稀有度：官方干员卡是顶部一排星 -->
                                        <TextBlock Classes="operator-card-stars"
                                                   Margin="7,7,0,0"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Top"
                                                   Text="{Binding StarGlyphs}" />

                                        <!-- 名称 / 职业 / 精英等级 -->
                                        <StackPanel Margin="9,0,9,8"
                                                    VerticalAlignment="Bottom"
                                                    Spacing="3">
                                            <TextBlock Classes="operator-card-name"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Name}" />
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <TextBlock FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding CareerBrush}"
                                                           Text="{Binding CareerName}" />
                                                <TextBlock Classes="mono"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource AppMutedTextBrush}"
                                                           Text="{Binding LevelDigits}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!--
                                            启用状态角标：把方块勾选框换成斜切角标，
                                            拼成「战术标记」的语感。整张卡都可点击切换。
                                        -->
                                        <Border Width="26"
                                                Height="26"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                IsHitTestVisible="False"
                                                Opacity="{Binding IsSelected, Converter={x:Static views:StaffCardVisual.ArtOpacity}}">
                                            <Path Stretch="None"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Data="M 0,0 L 9,9 L 0,18"
                                                  Stroke="{StaticResource AppPrimaryBrush}"
                                                  StrokeThickness="2.5"
                                                  StrokeLineCap="Round"
                                                  StrokeJoin="Round" />
                                        </Border>

                                        <!-- 删除：平时隐藏，悬停卡片才显现 -->
                                        <Button Classes="danger compact card-delete"
                                                Margin="0,0,6,6"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Content="删除"
                                                Tag="{Binding}"
                                                Click="Delete_Click" />

                                        <!-- 启用态：亮框 + 外发光，一眼区分已启用与未启用 -->
                                        <Border IsHitTestVisible="False"
                                                BorderBrush="{Binding CareerBrush}"
                                                BorderThickness="2"
                                                CornerRadius="10"
                                                BoxShadow="0 0 14 0 #4D65E6C4"
                                                IsVisible="{Binding IsSelected}" />

                                        <!-- 启用态：左下角一道职业色细条，兼作状态提示 -->
                                        <Border Width="28"
                                                Height="3"
                                                Margin="9,0,0,26"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Bottom"
                                                IsHitTestVisible="False"
                                                Background="{StaticResource AppPrimaryBrush}"
                                                IsVisible="{Binding IsSelected}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Name="StaffEmptyState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Spacing="10">
                    <Border Width="32"
                            Height="3"
                            HorizontalAlignment="Center"
                            Background="{StaticResource AppPrimaryBrush}"
                            CornerRadius="2" />
                    <TextBlock Classes="muted"
                               HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="暂无干员" />
                    <TextBlock Classes="caption"
                               HorizontalAlignment="Center"
                               Text="先录入或同步干员，再启用阵容候选。" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:domain="clr-namespace:arknights_random_team.Domain"
             xmlns:models="clr-namespace:arknights_random_team.Models"
             xmlns:views="clr-namespace:arknights_random_team.Views"
             mc:Ignorable="d"
             d:DesignWidth="760"
             d:DesignHeight="640"
             x:Class="arknights_random_team.Views.StaffListView"
             x:Name="Root"
             x:DataType="domain:ListModel"
             AutomationProperties.AutomationId="staff-list"
             FontFamily="{StaticResource AppFont}">
    <UserControl.Resources>
        <!-- 编辑 / 删除共用一套极简模板，避免 danger 实心底和默认按钮的 1px 下移把文字顶偏。 -->
        <ControlTheme x:Key="StaffActionButtonTheme" TargetType="Button">
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="{StaticResource AppRadiusControl}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            UseLayoutRounding="True">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{StaticResource AppSecondaryHoverBrush}" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Background" Value="{StaticResource AppSecondaryPressedBrush}" />
            </Style>
            <Style Selector="^.delete">
                <Setter Property="Foreground" Value="{StaticResource AppDangerBrush}" />
            </Style>
            <Style Selector="^.delete:pointerover">
                <Setter Property="Background" Value="{StaticResource AppDangerSoftBrush}" />
            </Style>
            <Style Selector="^.delete:pressed">
                <Setter Property="Background" Value="{StaticResource AppDangerHoverBrush}" />
            </Style>
        </ControlTheme>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="ToggleButton.view-switch">
            <Setter Property="Theme" Value="{StaticResource AppActionButtonTheme}" />
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource AppRadiusControl}" />
            <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.view-switch:pointerover">
            <Setter Property="Background" Value="{StaticResource AppSecondaryHoverBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        </Style>
        <Style Selector="ToggleButton.view-switch:checked">
            <Setter Property="Background" Value="{StaticResource AppPrimarySoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="ToggleButton.view-switch:checked:pointerover">
            <Setter Property="Background" Value="{StaticResource AppSidebarActiveHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="Button.clear-all">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MaxHeight" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="{StaticResource AppWellBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppDangerBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppDangerBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource AppRadiusControl}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.clear-all:pointerover">
            <Setter Property="Background" Value="{StaticResource AppDangerSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppDangerBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppDangerBrush}" />
        </Style>
        <Style Selector="Button.clear-all:pressed">
            <Setter Property="Background" Value="{StaticResource AppDangerHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppDangerBrush}" />
        </Style>
        <Style Selector="Button.clear-all:disabled">
            <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="Background" Value="{StaticResource AppWellBrush}" />
        </Style>
        <Style Selector="Path.sort-arrow">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="Data" Value="F1 M -5.215,6.099L 5.215,6.099L 0,0L -5.215,6.099 Z" />
        </Style>
        <!-- 触摸命中区：方案要求主操作不小于 44×44。
             图标按钮直接放大到 44；嵌在小药丸里的控件用负边距把「命中区」撑到 44，
             视觉尺寸保持不变（否则会给相邻控件让位、挤乱药丸与卡片名牌）。 -->
        <Style Selector="Button.more-button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Padding" Value="0" />
            <!-- 命中区 44，但用负边距把布局占位收回 32：卡片名牌一行里塞不下 44 的占位，
                 直接放大按钮会把干员名挤成省略号。 -->
            <Setter Property="Margin" Value="-6" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="DataGrid#StaffGrid Button.table-action">
            <Setter Property="Theme" Value="{StaticResource StaffActionButtonTheme}" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MaxHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="DataGrid#StaffGrid DataGridColumnHeader">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="DataGrid#StaffGrid DataGridColumnHeader:pointerover">
            <Setter Property="Background" Value="{StaticResource AppInputHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        </Style>
        <Style Selector="DataGrid#StaffGrid DataGridColumnHeader:pressed">
            <Setter Property="Background" Value="{StaticResource AppTableHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        </Style>
        <Style Selector="DataGrid#StaffGrid DataGridColumnHeader:focus-visible">
            <Setter Property="Background" Value="{StaticResource AppTableHeaderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        </Style>
        <Style Selector="DataGrid#StaffGrid DataGridCell">
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style Selector="DataGrid#StaffGrid DataGridCell TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="DataGrid#StaffGrid ScrollBar:vertical">
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="Width" Value="10" />
        </Style>
        <Style Selector="DataGrid#StaffGrid DataGridRow">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="DataGrid#StaffGrid DataGridRow:selected">
            <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
        </Style>
        <Style Selector="DataGrid#StaffGrid DataGridRow:nth-child(even):selected">
            <Setter Property="Background" Value="{StaticResource AppTableAlternateBrush}" />
        </Style>
        <Style Selector="DataGrid#StaffGrid DataGridRow.in-pool">
            <Setter Property="Background" Value="{StaticResource AppPoolRowBrush}" />
        </Style>
        <Style Selector="DataGrid#StaffGrid DataGridRow.in-pool:nth-child(even)">
            <Setter Property="Background" Value="{StaticResource AppPoolRowBrush}" />
        </Style>
        <Style Selector="DataGrid#StaffGrid DataGridRow.in-pool:pointerover">
            <Setter Property="Background" Value="{StaticResource AppPoolRowHoverBrush}" />
        </Style>
        <Style Selector="DataGrid#StaffGrid DataGridRow.in-pool:selected">
            <Setter Property="Background" Value="{StaticResource AppPoolRowBrush}" />
        </Style>
        <Style Selector="DataGrid#StaffGrid DataGridRow.in-pool:nth-child(even):selected">
            <Setter Property="Background" Value="{StaticResource AppPoolRowBrush}" />
        </Style>
        <Style Selector="Border.table-pill">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource AppWellBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource AppRadiusControl}" />
        </Style>
        <Style Selector="Button.chip-clear">
            <Setter Property="Theme" Value="{StaticResource StaffActionButtonTheme}" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="MaxHeight" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.chip-clear Path">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stroke" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
        </Style>
        <Style Selector="Button.chip-clear:pointerover">
            <Setter Property="Background" Value="{StaticResource AppSecondaryHoverBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.chip-clear:pressed">
            <Setter Property="Background" Value="{StaticResource AppSecondaryPressedBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.chip-clear:pointerover Path">
            <Setter Property="Stroke" Value="{StaticResource AppTextBrush}" />
        </Style>
        <Style Selector="Button.chip-clear:pressed Path">
            <Setter Property="Stroke" Value="{StaticResource AppPrimaryHoverBrush}" />
        </Style>
        <Style Selector="ItemsControl#FilterChipsList ContentPresenter">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.filter-choice">
            <Setter Property="Theme" Value="{StaticResource AppActionButtonTheme}" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Background" Value="{StaticResource AppSurfaceSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource AppRadiusControl}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.filter-choice:checked">
            <Setter Property="Background" Value="{StaticResource AppPrimarySoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.filter-choice:pointerover">
            <Setter Property="Background" Value="{StaticResource AppSecondaryHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppSecondaryBorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        </Style>
        <Style Selector="ToggleButton.filter-choice:checked:pointerover">
            <Setter Property="Background" Value="{StaticResource AppSidebarActiveHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="Button.operator-card">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{StaticResource AppCardBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource AppRadiusSurface}" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.operator-card:pointerover">
            <Setter Property="Background" Value="{StaticResource AppCardHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppSecondaryBorderBrush}" />
        </Style>
        <Style Selector="Button.operator-card:pressed">
            <Setter Property="Background" Value="{StaticResource AppCardHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppSecondaryBorderBrush}" />
        </Style>
        <Style Selector="Button.operator-card.in-pool">
            <Setter Property="Background" Value="{StaticResource AppCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppSecondaryBorderBrush}" />
        </Style>
        <Style Selector="Button.operator-card.in-pool:pointerover">
            <Setter Property="Background" Value="{StaticResource AppCardHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppSecondaryBorderBrush}" />
        </Style>
        <Style Selector="Button.operator-card.in-pool:pressed">
            <Setter Property="Background" Value="{StaticResource AppCardHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppSecondaryBorderBrush}" />
        </Style>
        <Style Selector="Button.operator-card /template/ Border#PART_RootBorder">
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <!--
            卡片焦点环画在内部（外层那圈 Margin=-4，会被卡片的 ClipToBounds 裁掉）。
            默认透明度必须用样式给：直接写在控件上的本地值优先级高于样式，
            会让 :focus-visible 的样式永远生效不了（实测确认）。
        -->
        <Style Selector="Button.operator-card Border#CardFocusRing">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Button.operator-card:focus-visible Border#CardFocusRing">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.operator-card Grid#PoolChrome">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Button.operator-card.in-pool Grid#PoolChrome">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.operator-card Path.pool-corner">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
        </Style>
        <Style Selector="DataGridRow">
            <Setter Property="MinHeight" Value="56" />
        </Style>
        <Style Selector="DataGrid#StaffGrid">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.card-action">
            <Setter Property="Theme" Value="{StaticResource StaffActionButtonTheme}" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MaxHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="Button.table-action.delete, Button.card-action.delete">
            <Setter Property="Foreground" Value="{StaticResource AppDangerBrush}" />
        </Style>
        <Style Selector="Button.table-action:pointerover, Button.card-action:pointerover">
            <Setter Property="Background" Value="{StaticResource AppSecondaryHoverBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.table-action:pressed, Button.card-action:pressed">
            <Setter Property="Background" Value="{StaticResource AppSecondaryPressedBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.table-action.delete:pointerover, Button.card-action.delete:pointerover">
            <Setter Property="Background" Value="{StaticResource AppDangerSoftBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.table-action.delete:pressed, Button.card-action.delete:pressed">
            <Setter Property="Background" Value="{StaticResource AppDangerHoverBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.table-action Path.action-icon, Button.card-action Path.action-icon">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stroke" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
        </Style>
        <Style Selector="Button.table-action.delete Path.action-icon, Button.card-action.delete Path.action-icon">
            <Setter Property="Stroke" Value="{StaticResource AppDangerBrush}" />
        </Style>
        <Style Selector="DataGrid#StaffGrid DataGridCell:focus-within">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.sort-summary">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="MaxWidth" Value="420" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Border.sort-summary TextBlock.sort-summary-label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.sort-summary TextBlock.sort-summary-value">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.sort-summary.active TextBlock.sort-summary-value">
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        </Style>
        <Style Selector="Border.art-metric">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="Background" Value="{StaticResource AppWellBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource AppRadiusControl}" />
        </Style>
        <Style Selector="Border.art-metric TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.art-metric.danger">
            <Setter Property="Background" Value="{StaticResource AppDangerSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppDangerBorderBrush}" />
        </Style>
        <Style Selector="Border.art-metric.danger TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppDangerBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <Border Name="ListChrome" Classes="surface" Padding="16,14">
        <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <StackPanel Name="SummaryPanel" VerticalAlignment="Center" Spacing="4">
                    <TextBlock FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppTextBrush}"
                               TextWrapping="Wrap"
                               Text="{Binding SummaryText}" />
                    <TextBlock Classes="caption"
                               IsVisible="{Binding HasActiveFilters}"
                               Text="{Binding VisibleSummaryText}" />
                </StackPanel>
                <StackPanel Name="ListHeaderActions"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Margin="8,0,0,0">
                <Button Name="ClearAllButton"
                        Classes="clear-all"
                        VerticalAlignment="Center"
                        Content="清空全部干员"
                        ToolTip.Tip="清空列表中的全部干员，不受当前筛选限制"
                        AutomationProperties.Name="清空全部干员"
                        AutomationProperties.AutomationId="staff-clear-all"
                        IsEnabled="{Binding ShowBatchBar}"
                        Click="ClearAll_Click" />
                </StackPanel>
            </Grid>

            <WrapPanel Name="ArtStatsBar"
                       AutomationProperties.Name="图片加载统计"
                       AutomationProperties.AutomationId="staff-art-stats">
                <Border Classes="art-metric">
                    <TextBlock Text="{Binding ArtPreloadText}" />
                </Border>
                <Border Classes="art-metric">
                    <TextBlock Text="{Binding ArtCacheText}" />
                </Border>
                <Border Classes="art-metric">
                    <TextBlock Text="{Binding ArtSourceText}" />
                </Border>
                <Border Classes="art-metric danger"
                        IsVisible="{Binding HasArtLoadFailures}">
                    <TextBlock Text="{Binding ArtFailureText}" />
                </Border>
            </WrapPanel>

            <Border Height="1"
                    Opacity="0.7"
                    Background="{StaticResource AppBorderBrush}" />

            <WrapPanel>
                <TextBox Name="SearchBox"
                         Classes="form-control"
                         Width="240"
                         Margin="0,0,8,8"
                         PlaceholderText="搜索干员名称……"
                         AutomationProperties.Name="搜索干员"
                         AutomationProperties.AutomationId="staff-search"
                         TextChanged="SearchBox_TextChanged" />
                <Button Name="FilterButton"
                        Classes="filter-trigger"
                        Classes.active="{Binding HasFlyoutFilters}"
                        Margin="0,0,8,8"
                        Content="筛选"
                        AutomationProperties.Name="筛选"
                        AutomationProperties.AutomationId="staff-filter">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                            <StackPanel Width="280" Spacing="12">
                                <TextBlock Classes="field-label" Text="职业" />
                                <ItemsControl ItemsSource="{Binding CareerFilters}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:CompileBindings="False">
                                            <ToggleButton Classes="filter-choice"
                                                          Content="{Binding Label}"
                                                          IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Classes="field-label" Text="稀有度" />
                                <ItemsControl ItemsSource="{Binding RarityFilters}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:CompileBindings="False">
                                            <ToggleButton Classes="filter-choice"
                                                          Content="{Binding Label}"
                                                          IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Classes="field-label" Text="随机池" />
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton Classes="filter-choice"
                                                  Content="全部"
                                                  IsChecked="{Binding IsPoolFilterAll, Mode=OneWay}"
                                                  Click="PoolAll_Click" />
                                    <ToggleButton Classes="filter-choice"
                                                  Content="已入池"
                                                  IsChecked="{Binding IsPoolFilterIn, Mode=OneWay}"
                                                  Click="PoolIn_Click" />
                                    <ToggleButton Classes="filter-choice"
                                                  Content="未入池"
                                                  IsChecked="{Binding IsPoolFilterOut, Mode=OneWay}"
                                                  Click="PoolOut_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Border Name="ViewModeSwitch"
                        Height="40"
                        Margin="0,0,8,8"
                        Padding="3"
                        VerticalAlignment="Center"
                        Background="{StaticResource AppWellBrush}"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource AppRadiusSurface}">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <ToggleButton Name="GridViewButton"
                                      Classes="view-switch"
                                      Content="表格"
                                      AutomationProperties.Name="切换到表格视图"
                                      AutomationProperties.AutomationId="staff-view-table"
                                      IsChecked="{Binding IsGridView, Mode=OneWay}"
                                      Click="GridView_Click" />
                        <ToggleButton Name="HalfBodyModeButton"
                                      Classes="view-switch"
                                      Content="半身像"
                                      AutomationProperties.Name="切换到半身像视图"
                                      AutomationProperties.AutomationId="staff-view-half-body"
                                      IsChecked="{Binding IsHalfBodyView, Mode=OneWay}"
                                      Click="HalfBodyMode_Click" />
                    </StackPanel>
                </Border>
                <Border Classes="sort-summary"
                        Classes.active="{Binding HasSorts}"
                        ToolTip.Tip="点击表头可追加多列排序，左侧为第一优先级"
                        AutomationProperties.Name="当前排序"
                        AutomationProperties.AutomationId="staff-sort-summary">
                    <StackPanel Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                        <TextBlock Classes="sort-summary-label" Text="排序" />
                        <TextBlock Classes="sort-summary-value" Text="{Binding SortSummary}" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <WrapPanel IsVisible="{Binding HasActiveFilters}">
                <ItemsControl Name="FilterChipsList"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding ActiveFilters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel VerticalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="domain:FilterChip">
                            <Border Classes="filter-chip" Margin="0,0,8,4">
                                <Grid ColumnDefinitions="Auto,Auto">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="12"
                                               LineHeight="16"
                                               Text="{Binding Label}" />
                                    <Button Grid.Column="1"
                                            Classes="chip-clear"
                                            Tag="{Binding}"
                                            ToolTip.Tip="移除此筛选"
                                            AutomationProperties.Name="移除此筛选"
                                            Click="RemoveChip_Click">
                                        <Path Data="M 2,2 L 10,10 M 10,2 L 2,10" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="text compact"
                        VerticalAlignment="Center"
                        Margin="0,0,8,4"
                        Content="清除筛选"
                        Click="ClearFilters_Click" />
            </WrapPanel>

            <TextBlock Name="SelectAllScopeLabel"
                       Classes="caption"
                       IsVisible="{Binding HasActiveFilters}"
                       Text="{Binding SelectAllScopeText}" />
        </StackPanel>
        </Border>

        <DockPanel Grid.Row="1" Margin="0,12,0,0">
        <Border Name="BatchFooter"
                DockPanel.Dock="Bottom"
                Padding="0,12,0,0"
                Background="{StaticResource AppBackgroundBrush}">
        <Grid Name="BatchRow">
            <StackPanel Name="BatchBar"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Spacing="8">
                <Button Classes="secondary"
                        Content="将当前筛选结果加入随机池"
                        AutomationProperties.AutomationId="staff-batch-add"
                        IsEnabled="{Binding CanBatch}"
                        Click="BatchAdd_Click" />
                <Button Content="将当前筛选结果移出随机池"
                        AutomationProperties.AutomationId="staff-batch-remove"
                        IsEnabled="{Binding CanBatch}"
                        Click="BatchRemove_Click" />
            </StackPanel>
            <Button Name="BatchMenuButton"
                    HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="staff-batch-menu"
                    IsVisible="False"
                    Content="{Binding BatchMenuText}">
                <Button.Flyout>
                    <MenuFlyout Placement="TopEdgeAlignedLeft">
                        <MenuItem Header="将当前筛选结果加入随机池"
                                  IsEnabled="{Binding CanBatch}"
                                  Click="BatchAdd_Click" />
                        <MenuItem Header="将当前筛选结果移出随机池"
                                  IsEnabled="{Binding CanBatch}"
                                  Click="BatchRemove_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>
        </Border>

        <Border Classes="surface data-frame" Padding="0" ClipToBounds="True">
            <Grid>
                <DataGrid Name="StaffGrid"
                          AutomationProperties.Name="干员表格"
                          AutomationProperties.AutomationId="staff-table"
                          IsVisible="{Binding ShowGrid}"
                          AutoGenerateColumns="False"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="False"
                          IsReadOnly="True"
                          HorizontalAlignment="Stretch"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          SelectionMode="Single"
                          ItemsSource="{Binding VisibleStaff}"
                          LoadingRow="StaffGrid_LoadingRow"
                          UnloadingRow="StaffGrid_UnloadingRow"
                          SelectionChanged="StaffGrid_SelectionChanged"
                          Sorting="StaffGrid_Sorting"
                          KeyDown="StaffGrid_KeyDown">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="*"
                                                MinWidth="180"
                                                SortMemberPath="Name">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="点击按名称排序，再点切换降序，第三次取消该列">
                                    <TextBlock Text="干员" VerticalAlignment="Center" />
                                    <Path Classes="sort-arrow"
                                          IsVisible="{Binding #Root.((domain:ListModel)DataContext).NameSort, Converter={x:Static views:SortVisual.IsAscending}}" />
                                    <Path Classes="sort-arrow"
                                          IsVisible="{Binding #Root.((domain:ListModel)DataContext).NameSort, Converter={x:Static views:SortVisual.IsDescending}}"
                                          RenderTransform="scale(1,-1)" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Staff">
                                    <!-- 名字必须占 * 列：横排 StackPanel 在 WASM 上常把剩余宽度算成 0，
                                         CharacterEllipsis 就会把整段名字画没。 -->
                                    <Grid ColumnDefinitions="Auto,Auto,*"
                                          Margin="-4,0,0,0"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          ToolTip.Tip="点击切换是否加入随机池">
                                        <Border Width="2"
                                                Margin="0,8"
                                                CornerRadius="1"
                                                IsHitTestVisible="False"
                                                Opacity="{Binding IsSelected, Converter={x:Static views:StaffCardVisual.PoolOpacity}}">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#0065E6C4" Offset="0" />
                                                    <GradientStop Color="#E665E6C4" Offset="0.5" />
                                                    <GradientStop Color="#0065E6C4" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Panel Grid.Column="1"
                                               Width="40"
                                               Height="40"
                                               Margin="10,0,10,0"
                                               VerticalAlignment="Center">
                                            <Border Width="40"
                                                    Height="40"
                                                    CornerRadius="{StaticResource AppRadiusControl}"
                                                    ClipToBounds="True"
                                                    Background="{StaticResource AppWellBrush}"
                                                    BorderBrush="{Binding IsSelected, Converter={x:Static views:StaffCardVisual.PoolRing}}"
                                                    BorderThickness="1">
                                                <views:StaffThumb Sources="{Binding AvatarUris}"
                                                                  PlaceholderSources="{Binding CareerIconUris}"
                                                                  PlaceholderSize="18"
                                                                  PlaceholderOpacity="0.75" />
                                            </Border>
                                            <Border Width="15"
                                                    Height="15"
                                                    Margin="0,0,-3,-3"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom"
                                                    Background="#E609251F"
                                                    BorderBrush="{StaticResource AppPrimaryBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource AppRadiusPill}"
                                                    IsHitTestVisible="False"
                                                    Opacity="{Binding IsSelected, Converter={x:Static views:StaffCardVisual.PoolOpacity}}">
                                                <Path Width="8"
                                                      Height="8"
                                                      Stretch="Uniform"
                                                      Stroke="{StaticResource AppPrimaryBrush}"
                                                      StrokeThickness="1.6"
                                                      StrokeLineCap="Round"
                                                      StrokeJoin="Round"
                                                      Fill="Transparent"
                                                      Data="M 1,5 L 3.4,7.4 L 8,2" />
                                            </Border>
                                        </Panel>
                                        <TextBlock Grid.Column="2"
                                                   Margin="0,0,8,0"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{StaticResource AppTextBrush}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Stretch"
                                                   TextAlignment="Left"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Name}"
                                                   ToolTip.Tip="{Binding Name}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="88"
                                                MinWidth="80"
                                                SortMemberPath="Star">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="点击按稀有度排序，再点切换降序，第三次取消该列">
                                    <TextBlock Text="稀有度" VerticalAlignment="Center" />
                                    <Path Classes="sort-arrow"
                                          IsVisible="{Binding #Root.((domain:ListModel)DataContext).StarSort, Converter={x:Static views:SortVisual.IsAscending}}" />
                                    <Path Classes="sort-arrow"
                                          IsVisible="{Binding #Root.((domain:ListModel)DataContext).StarSort, Converter={x:Static views:SortVisual.IsDescending}}"
                                          RenderTransform="scale(1,-1)" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Staff">
                                    <Border Classes="table-pill">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding RarityBrush}"
                                                   Text="{Binding RarityMark}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="108"
                                                MinWidth="96"
                                                SortMemberPath="Career">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="点击按职业排序，再点切换降序，第三次取消该列">
                                    <TextBlock Text="职业" VerticalAlignment="Center" />
                                    <Path Classes="sort-arrow"
                                          IsVisible="{Binding #Root.((domain:ListModel)DataContext).CareerSort, Converter={x:Static views:SortVisual.IsAscending}}" />
                                    <Path Classes="sort-arrow"
                                          IsVisible="{Binding #Root.((domain:ListModel)DataContext).CareerSort, Converter={x:Static views:SortVisual.IsDescending}}"
                                          RenderTransform="scale(1,-1)" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Staff">
                                    <Border Classes="table-pill" Background="{Binding CareerSoftBrush}">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Spacing="6">
                                            <Image Width="16"
                                                   Height="16"
                                                   Stretch="Uniform"
                                                   views:ArtImage.Sources="{Binding CareerIconUris}" />
                                            <TextBlock VerticalAlignment="Center"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AppTextBrush}"
                                                       TextAlignment="Center"
                                                       TextWrapping="NoWrap"
                                                       Text="{Binding CareerName}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="132"
                                                MinWidth="116"
                                                CanUserSort="True"
                                                SortMemberPath="LevelSortKey">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="点击按精英阶段与等级排序：精零到精二、同阶段按等级从低到高；再点切换为精二优先，第三次取消该列">
                                    <TextBlock Text="精英 / 等级" VerticalAlignment="Center" />
                                    <Path Classes="sort-arrow"
                                          IsVisible="{Binding #Root.((domain:ListModel)DataContext).LevelSort, Converter={x:Static views:SortVisual.IsAscending}}" />
                                    <Path Classes="sort-arrow"
                                          IsVisible="{Binding #Root.((domain:ListModel)DataContext).LevelSort, Converter={x:Static views:SortVisual.IsDescending}}"
                                          RenderTransform="scale(1,-1)" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Staff">
                                    <Border Classes="table-pill">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Spacing="6">
                                            <TextBlock FontFamily="{StaticResource AppFont}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AppTextBrush}"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding EliteLabel}" />
                                            <TextBlock FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource AppMutedTextBrush}"
                                                       Text="{Binding RankMark}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="96"
                                                MinWidth="96"
                                                CanUserResize="False"
                                                CanUserSort="False">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="操作"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Staff">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="4"
                                                Margin="0,0,8,0">
                                        <Button Classes="table-action"
                                                VerticalAlignment="Center"
                                                Tag="{Binding}"
                                                ToolTip.Tip="编辑干员详情"
                                                AutomationProperties.Name="编辑"
                                                AutomationProperties.AutomationId="staff-table-edit"
                                                Click="Detail_Click">
                                            <Path Classes="action-icon"
                                                  Data="M 11,2.8 L 13.2,5 L 5.6,12.6 L 3,13 L 3.4,10.4 Z M 10.2,3.6 L 12.4,5.8" />
                                        </Button>
                                        <Button Classes="table-action delete"
                                                VerticalAlignment="Center"
                                                Tag="{Binding}"
                                                ToolTip.Tip="删除干员"
                                                AutomationProperties.Name="删除"
                                                AutomationProperties.AutomationId="staff-table-delete"
                                                Click="Delete_Click">
                                            <Path Classes="action-icon"
                                                  Data="M 4,5 H 12 M 5,5 L 5.4,13 H 10.6 L 11,5 M 6.8,5 V 3.6 H 9.2 V 5 M 7,7.2 V 11 M 9,7.2 V 11" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <ScrollViewer Name="StaffCardsScroll"
                              IsVisible="{Binding ShowCards}"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsRepeater Name="StaffCards"
                                   Margin="16"
                                   AutomationProperties.Name="干员半身像列表"
                                   AutomationProperties.AutomationId="staff-half-body-list"
                                   ItemsSource="{Binding VisibleStaff}">
                        <ItemsRepeater.Layout>
                            <!-- 虚拟化网格：只实例化可见区及其邻近的卡片，几百名干员时
                                 不再一次性创建全部卡片控件。
                                 ItemsStretch=None：单元尺寸由代码按可用宽度算出并夹在
                                 128–168 之间；主体高宽比约 1.85，下方工具条 36px。 -->
                            <UniformGridLayout MinItemWidth="128"
                                               MinItemHeight="273"
                                               MinRowSpacing="10"
                                               MinColumnSpacing="10"
                                               ItemsStretch="None"
                                               ItemsJustification="Center" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:Staff">
                                <Button Classes="operator-card"
                                        Classes.in-pool="{Binding IsSelected}"
                                        ToolTip.Tip="点击切换是否加入随机池"
                                        AutomationProperties.Name="{Binding PoolAutomationName}"
                                        AutomationProperties.AutomationId="staff-card"
                                        AutomationProperties.HelpText="按空格或回车切换随机池；底部按钮可编辑或删除"
                                        KeyDown="OperatorCard_KeyDown"
                                        Click="OperatorCard_Click">
                                    <!--
                                        焦点环画在卡片内部：卡片自身 ClipToBounds=True（要裁艺术图），
                                        而按钮主题里的焦点环是 Margin=-4 画在边界外的，
                                        在外层会被整圈裁掉（实测确认，键盘用户看不到焦点）。
                                    -->
                                    <Grid>
                                        <Border Name="CardFocusRing"
                                                Margin="1"
                                                ZIndex="3"
                                                IsHitTestVisible="False"
                                                BorderBrush="{StaticResource AppSignalBrush}"
                                                BorderThickness="2"
                                                CornerRadius="{StaticResource AppRadiusSurface}" />
                                        <Grid RowDefinitions="*,36">
                                            <views:SquadPortrait ShowChrome="False" />
                                            <Grid Grid.Row="1"
                                                  ColumnDefinitions="*,*"
                                                  Height="36"
                                                  Margin="8,0">
                                                <Button Classes="card-action"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Tag="{Binding}"
                                                        ToolTip.Tip="编辑干员详情"
                                                        AutomationProperties.Name="编辑"
                                                        AutomationProperties.AutomationId="staff-card-edit"
                                                        Click="Detail_Click">
                                                    <Path Classes="action-icon"
                                                          Data="M 11,2.8 L 13.2,5 L 5.6,12.6 L 3,13 L 3.4,10.4 Z M 10.2,3.6 L 12.4,5.8" />
                                                </Button>
                                                <Button Grid.Column="1"
                                                        Classes="card-action delete"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Tag="{Binding}"
                                                        ToolTip.Tip="删除干员"
                                                        AutomationProperties.Name="删除"
                                                        AutomationProperties.AutomationId="staff-card-delete"
                                                        Click="Delete_Click">
                                                    <Path Classes="action-icon"
                                                          Data="M 4,5 H 12 M 5,5 L 5.4,13 H 10.6 L 11,5 M 6.8,5 V 3.6 H 9.2 V 5 M 7,7.2 V 11 M 9,7.2 V 11" />
                                                </Button>
                                            </Grid>
                                        </Grid>
                                        <!-- 立绘 / 名牌 / 工具条共用同一层透明度，避免下半段靠 BoxShadow 另走一套动画。
                                             行高与 SquadPortrait 的 *,54 以及底部 36px 工具条对齐；角标只画在立绘行。 -->
                                        <Grid Name="PoolChrome"
                                              RowDefinitions="*,54,36"
                                              ZIndex="1"
                                              IsHitTestVisible="False">
                                            <Grid.Transitions>
                                                <Transitions>
                                                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                                                </Transitions>
                                            </Grid.Transitions>
                                            <Panel>
                                                <Border Background="#2E65E6C4" />
                                                <Border Height="2"
                                                        Margin="12,0"
                                                        VerticalAlignment="Bottom">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#0065E6C4" Offset="0" />
                                                            <GradientStop Color="#E665E6C4" Offset="0.5" />
                                                            <GradientStop Color="#0065E6C4" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <Path Classes="pool-corner"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Top"
                                                      Margin="7"
                                                      Data="M 1,17 L 1,1 L 17,1" />
                                                <Path Classes="pool-corner"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Top"
                                                      Margin="7"
                                                      Data="M 1,1 L 17,1 L 17,17" />
                                                <Path Classes="pool-corner"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Bottom"
                                                      Margin="7"
                                                      Data="M 1,1 L 1,17 L 17,17" />
                                                <Path Classes="pool-corner"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Bottom"
                                                      Margin="7"
                                                      Data="M 17,1 L 17,17 L 1,17" />
                                                <Border Width="22"
                                                        Height="22"
                                                        Margin="8"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Background="#E609251F"
                                                        BorderBrush="{StaticResource AppPrimaryBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource AppRadiusPill}">
                                                    <Path Width="11"
                                                          Height="11"
                                                          Stretch="Uniform"
                                                          Stroke="{StaticResource AppPrimaryBrush}"
                                                          StrokeThickness="1.8"
                                                          StrokeLineCap="Round"
                                                          StrokeJoin="Round"
                                                          Fill="Transparent"
                                                          Data="M 1,6 L 4.2,9.2 L 10,2.2" />
                                                </Border>
                                            </Panel>
                                            <Border Grid.Row="1" Background="#2E65E6C4" />
                                            <Border Grid.Row="2" Background="#2E65E6C4" />
                                        </Grid>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>

                <StackPanel Name="StaffEmptyState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{Binding ShowStaffEmpty}"
                            Spacing="12">
                    <TextBlock Classes="muted"
                               HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="暂无干员" />
                    <TextBlock Classes="caption"
                               HorizontalAlignment="Center"
                               Text="先录入或同步干员，再编入随机池。" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                        <Button Classes="primary" Content="手动录入" Click="AddManual_Click" />
                        <Button Classes="secondary" Content="数据库同步" Click="AddSync_Click" />
                    </StackPanel>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{Binding ShowFilterEmpty}"
                            Spacing="12">
                    <TextBlock Classes="muted"
                               HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="没有符合条件的干员" />
                    <TextBlock Classes="caption"
                               HorizontalAlignment="Center"
                               Text="调整搜索或筛选条件后再试。" />
                    <Button Classes="secondary"
                            HorizontalAlignment="Center"
                            Content="清除筛选"
                            Click="ClearFilters_Click" />
                </StackPanel>
            </Grid>
        </Border>
        </DockPanel>
    </Grid>
</UserControl>

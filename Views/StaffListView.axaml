<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:domain="clr-namespace:arknights_random_team.Domain"
             xmlns:models="clr-namespace:arknights_random_team.Models"
             xmlns:views="clr-namespace:arknights_random_team.Views"
             xmlns:assists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             mc:Ignorable="d"
             d:DesignWidth="760"
             d:DesignHeight="640"
             x:Class="arknights_random_team.Views.StaffListView"
             x:Name="Root"
             x:DataType="domain:ListModel"
             FontFamily="{StaticResource AppFont}">
    <UserControl.Styles>
        <!-- 视图切换按钮（表格 / 卡片、头像 / 半身像） -->
        <Style Selector="ToggleButton.view-switch">
            <Setter Property="Theme" Value="{StaticResource AppActionButtonTheme}" />
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.view-switch:pointerover">
            <Setter Property="Background" Value="{StaticResource AppSecondaryHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        </Style>
        <Style Selector="ToggleButton.view-switch:checked">
            <Setter Property="Background" Value="{StaticResource AppPrimarySoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="ToggleButton.filter-chip">
            <Setter Property="Theme" Value="{StaticResource AppActionButtonTheme}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="{StaticResource AppWellBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.filter-chip:pointerover">
            <Setter Property="Background" Value="{StaticResource AppSecondaryHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        </Style>
        <Style Selector="ToggleButton.filter-chip:checked">
            <Setter Property="Background" Value="{StaticResource AppPrimarySoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Border.operator-card-host">
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BoxShadow" Value="0 6 18 0 #24000000" />
            <Setter Property="Transitions">
                <Transitions>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.operator-card-host:pointerover">
            <Setter Property="BoxShadow" Value="0 14 32 0 #66000000" />
        </Style>

        <!-- 仿游戏干员卡：竖版，接近官方 2:3 -->
        <Style Selector="Border.operator-card">
            <Setter Property="Width" Value="158" />
            <Setter Property="Height" Value="236" />
            <Setter Property="Background" Value="{StaticResource AppWellBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
                    <ThicknessTransition Property="BorderThickness" Duration="0:0:0.14" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.operator-card-host:pointerover Border.operator-card">
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Background" Value="{StaticResource AppSurfaceSubtleBrush}" />
        </Style>
        <Style Selector="TextBlock.operator-card-stars">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LetterSpacing" Value="0.6" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.operator-card-name">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        </Style>
        <Style Selector="Button.card-delete">
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Width" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Opacity" Value="0.92" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <!-- 触控没有 pointerover：删除始终可点；桌面悬停时再加一点对比 -->
        <Style Selector="Border.operator-card-host:pointerover Button.card-delete">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.card-delete:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Border.operator-card-ring">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style Selector="DataGridRow">
            <Setter Property="MinHeight" Value="60" />
        </Style>
        <Style Selector="DataGridCell TextBlock.cell-start">
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="CheckBox.staff-select">
            <Setter Property="assists:SelectionControlAssist.Size" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="Border.cell-hit">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ComboBox.staff-choice">
            <Setter Property="Theme" Value="{StaticResource MaterialComboBox}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MaxHeight" Value="36" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource AppSurfaceSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="ClipToBounds" Value="False" />
        </Style>
        <Style Selector="DataGridCell TextBox.staff-editor">
            <Setter Property="Theme" Value="{StaticResource SoloTextBox}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MaxHeight" Value="36" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Background" Value="{StaticResource AppInputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox.staff-choice:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="ComboBox.staff-choice:focus-within">
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="DataGridCell TextBox.staff-editor:focus-within">
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="Button.delete-staff">
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Width" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="16" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,16,*">
        <Border Grid.Row="0" Classes="command-bar">
            <Grid>
                <Path Width="220"
                      Height="86"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      IsHitTestVisible="False"
                      Opacity="0.18"
                      Stroke="{StaticResource AppPrimaryBrush}"
                      StrokeThickness="1"
                      Stretch="Fill"
                      Data="M 0,86 L 70,0 H 220 M 40,86 L 110,0 M 90,86 L 160,0" />
                <Grid RowDefinitions="Auto,12,Auto,10,Auto,12,Auto">
                <Grid ColumnDefinitions="*,20,Auto">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="eyebrow" Text="OPERATOR ROSTER" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="4"
                                    Height="28"
                                    Background="{StaticResource AppSignalBrush}"
                                    CornerRadius="2" />
                            <TextBlock Classes="section-title"
                                       VerticalAlignment="Center"
                                       Text="干员名单" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="10">
                        <Border Padding="3"
                                Background="{StaticResource AppWellBrush}"
                                BorderBrush="{StaticResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <ToggleButton Name="GridViewButton"
                                              Classes="view-switch"
                                              Content="表格"
                                              AutomationProperties.Name="切换到表格视图"
                                              IsChecked="{Binding IsGridView, Mode=OneWay}"
                                              Click="GridView_Click" />
                                <ToggleButton Name="CardViewButton"
                                              Classes="view-switch"
                                              Content="卡片"
                                              AutomationProperties.Name="切换到卡片视图"
                                              IsChecked="{Binding IsCardView, Mode=OneWay}"
                                              Click="CardView_Click" />
                            </StackPanel>
                        </Border>

                        <Border Name="GalleryToggle"
                                Padding="3"
                                Background="{StaticResource AppWellBrush}"
                                BorderBrush="{StaticResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                IsVisible="{Binding IsCardView}">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <ToggleButton Name="AvatarModeButton"
                                              Classes="view-switch"
                                              Content="头像"
                                              AutomationProperties.Name="卡片显示头像"
                                              IsChecked="{Binding !UsePortrait, Mode=OneWay}"
                                              Click="AvatarMode_Click" />
                                <ToggleButton Name="PortraitModeButton"
                                              Classes="view-switch"
                                              Content="半身像"
                                              AutomationProperties.Name="卡片显示半身立绘"
                                              IsChecked="{Binding UsePortrait, Mode=OneWay}"
                                              Click="PortraitMode_Click" />
                            </StackPanel>
                        </Border>

                        <Button Name="ClearAllButton"
                                MinWidth="112"
                                Classes="danger"
                                Content="清空列表"
                                Click="ClearAll_Click" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="*,10,Auto">
                    <TextBox Name="SearchBox"
                             Classes="form-control dense"
                             HorizontalAlignment="Stretch"
                             PlaceholderText="搜索干员名称"
                             Text="{Binding SearchText, Mode=TwoWay}" />
                    <Button Grid.Column="1"
                            Name="ClearFilterButton"
                            Classes="text compact"
                            VerticalAlignment="Center"
                            Content="清除筛选"
                            IsVisible="{Binding HasActiveFilter}"
                            Click="ClearFilters_Click" />
                </Grid>
                <WrapPanel Name="FilterChipHost"
                           Grid.Row="4"
                           Orientation="Horizontal">
                    <ToggleButton Classes="filter-chip" Tag="1" Content="1★"
                                  AutomationProperties.Name="筛选 1 星" Click="StarFilter_Click" />
                    <ToggleButton Classes="filter-chip" Tag="2" Content="2★"
                                  AutomationProperties.Name="筛选 2 星" Click="StarFilter_Click" />
                    <ToggleButton Classes="filter-chip" Tag="3" Content="3★"
                                  AutomationProperties.Name="筛选 3 星" Click="StarFilter_Click" />
                    <ToggleButton Classes="filter-chip" Tag="4" Content="4★"
                                  AutomationProperties.Name="筛选 4 星" Click="StarFilter_Click" />
                    <ToggleButton Classes="filter-chip" Tag="5" Content="5★"
                                  AutomationProperties.Name="筛选 5 星" Click="StarFilter_Click" />
                    <ToggleButton Classes="filter-chip" Tag="6" Content="6★"
                                  AutomationProperties.Name="筛选 6 星" Click="StarFilter_Click" />
                    <ToggleButton Classes="filter-chip" Tag="先锋" Content="先锋" Click="CareerFilter_Click" />
                    <ToggleButton Classes="filter-chip" Tag="近卫" Content="近卫" Click="CareerFilter_Click" />
                    <ToggleButton Classes="filter-chip" Tag="狙击" Content="狙击" Click="CareerFilter_Click" />
                    <ToggleButton Classes="filter-chip" Tag="重装" Content="重装" Click="CareerFilter_Click" />
                    <ToggleButton Classes="filter-chip" Tag="医疗" Content="医疗" Click="CareerFilter_Click" />
                    <ToggleButton Classes="filter-chip" Tag="辅助" Content="辅助" Click="CareerFilter_Click" />
                    <ToggleButton Classes="filter-chip" Tag="术师" Content="术师" Click="CareerFilter_Click" />
                    <ToggleButton Classes="filter-chip" Tag="特种" Content="特种" Click="CareerFilter_Click" />
                    <ToggleButton Name="SelectedFilterButton"
                                  Classes="filter-chip"
                                  Content="编入"
                                  AutomationProperties.Name="只看已编入"
                                  Click="SelectedFilter_Click" />
                    <ToggleButton Name="StandbyFilterButton"
                                  Classes="filter-chip"
                                  Content="待命"
                                  AutomationProperties.Name="只看待命"
                                  Click="StandbyFilter_Click" />
                </WrapPanel>
                <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="8">
                    <Border Classes="stat-hud">
                        <StackPanel Spacing="1">
                            <TextBlock Classes="stat-value" Text="{Binding StaffCount}" />
                            <TextBlock Classes="stat-label" Text="在册" />
                        </StackPanel>
                    </Border>
                    <Border Classes="stat-hud"
                            Background="{StaticResource AppAccentSoftBrush}"
                            BorderBrush="{StaticResource AppPrimaryBrush}">
                        <StackPanel Spacing="1">
                            <TextBlock Classes="stat-value"
                                       Foreground="{StaticResource AppPrimaryBrush}"
                                       Text="{Binding SelectedStaffCount}" />
                            <TextBlock Classes="stat-label"
                                       Foreground="{StaticResource AppPrimaryBrush}"
                                       Text="编入" />
                        </StackPanel>
                    </Border>
                    <Border Classes="stat-hud">
                        <StackPanel Spacing="1">
                            <TextBlock Classes="stat-value"
                                       Foreground="{StaticResource AppMutedTextBrush}"
                                       Text="{Binding UnselectedStaffCount}" />
                            <TextBlock Classes="stat-label" Text="待命" />
                        </StackPanel>
                    </Border>
                    <TextBlock Classes="caption"
                               Margin="8,0,0,0"
                               VerticalAlignment="Bottom"
                               IsVisible="{Binding HasActiveFilter}"
                               Text="{Binding FilterSummary}" />
                    <TextBlock Classes="caption"
                               Margin="8,0,0,0"
                               VerticalAlignment="Bottom"
                               IsVisible="{Binding IsCardView}"
                               Text="{Binding ArtLoadInfo}" />
                </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Classes="surface data-frame" Padding="0" ClipToBounds="True">
            <Grid>
                <Grid RowDefinitions="3,*">
                    <Grid Grid.Row="0" ColumnDefinitions="88,*,0.4*">
                        <Border Background="{StaticResource AppSignalBrush}" />
                        <Border Grid.Column="1" Background="{StaticResource AppPrimaryGlowBrush}" />
                        <Border Grid.Column="2" Background="{StaticResource AppBorderBrush}" />
                    </Grid>

                    <Grid Grid.Row="1">
                <DataGrid Name="StaffGrid"
                          IsVisible="{Binding IsGridView}"
                          AutoGenerateColumns="False"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="True"
                          HorizontalScrollBarVisibility="Auto"
                          SelectionMode="Single"
                          ItemsSource="{Binding FilteredStaffList}"
                          PreparingCellForEdit="StaffGrid_PreparingCellForEdit"
                          CellEditEnded="StaffGrid_CellEditEnded"
                          SelectionChanged="StaffGrid_SelectionChanged"
                          Sorting="StaffGrid_Sorting">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="64" MinWidth="64" MaxWidth="64" CanUserSort="False">
                            <DataGridTemplateColumn.Header>
                                <Border Classes="cell-hit" PointerPressed="SelectAllHeader_PointerPressed">
                                    <CheckBox Classes="staff-select"
                                              IsThreeState="True"
                                              IsChecked="{Binding #Root.((domain:ListModel)DataContext).IsAllStaffSelected, Mode=OneWay}"
                                              Click="SelectAll_Click" />
                                </Border>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Staff">
                                    <Border Classes="cell-hit" PointerPressed="SelectCell_PointerPressed">
                                        <CheckBox Classes="staff-select"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="2.4*"
                                                MinWidth="188"
                                                Header="干员"
                                                SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Staff">
                                    <Grid ColumnDefinitions="48,12,*" Margin="4,0">
                                        <Border Classes="avatar-frame"
                                                BorderBrush="{Binding CareerBrush}"
                                                Background="{Binding CareerSoftBrush}">
                                            <Panel>
                                                <Image Stretch="UniformToFill"
                                                       IsVisible="{Binding HasArt}"
                                                       views:ArtImage.Sources="{Binding AvatarUris}" />
                                                <Image Width="22"
                                                       Height="22"
                                                       Opacity="0.7"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding !HasArt}"
                                                       views:ArtImage.Sources="{Binding CareerIconUris}" />
                                            </Panel>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Classes="cell-start"
                                                       FontWeight="SemiBold"
                                                       FontSize="15"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Name}" />
                                            <TextBlock Classes="cell-start"
                                                       FontSize="11"
                                                       Foreground="{Binding CareerBrush}"
                                                       Text="{Binding CareerName}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate x:DataType="models:Staff">
                                    <TextBox Classes="staff-editor"
                                             Text="{Binding Name, Mode=TwoWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="1.15*"
                                                MinWidth="112"
                                                Header="等级"
                                                SortMemberPath="Level.Description">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Staff">
                                    <Border HorizontalAlignment="Center"
                                            Padding="10,4"
                                            Background="{StaticResource AppWellBrush}"
                                            BorderBrush="{StaticResource AppBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <TextBlock Classes="mono"
                                                   FontSize="12"
                                                   Foreground="{StaticResource AppTextBrush}"
                                                   Text="{Binding Level.Description}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate x:DataType="models:Staff">
                                    <TextBox Classes="staff-editor"
                                             Text="{Binding Level.Description, Mode=TwoWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="108"
                                                MinWidth="100"
                                                Header="稀有度"
                                                SortMemberPath="Star">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Staff">
                                    <Border HorizontalAlignment="Center"
                                            Padding="8,4"
                                            Background="{Binding RaritySoftBrush}"
                                            BorderBrush="{Binding RarityBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <TextBlock FontSize="11"
                                                   FontWeight="Bold"
                                                   LetterSpacing="0.4"
                                                   Foreground="{Binding RarityBrush}"
                                                   Text="{Binding StarGlyphs}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate x:DataType="models:Staff">
                                    <ComboBox Classes="staff-choice dense"
                                              ItemsSource="{x:Static models:AppOptions.Stars}"
                                              SelectedItem="{Binding Star, Mode=TwoWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="112"
                                                MinWidth="104"
                                                Header="职业"
                                                SortMemberPath="Career">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Staff">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Spacing="7">
                                        <Border Width="26"
                                                Height="26"
                                                CornerRadius="6"
                                                Background="{Binding CareerSoftBrush}"
                                                BorderBrush="{Binding CareerBrush}"
                                                BorderThickness="1">
                                            <Image Width="16"
                                                   Height="16"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   views:ArtImage.Sources="{Binding CareerIconUris}" />
                                        </Border>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding CareerBrush}"
                                                   Text="{Binding CareerName}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate x:DataType="models:Staff">
                                    <ComboBox Classes="staff-choice dense"
                                              ItemsSource="{x:Static models:AppOptions.Careers}"
                                              SelectedItem="{Binding Career, Mode=TwoWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="72" MinWidth="72" MaxWidth="72" Header="操作" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Staff">
                                    <Button Classes="danger compact delete-staff"
                                            Content="×"
                                            ToolTip.Tip="删除干员"
                                            Tag="{Binding}"
                                            Click="Delete_Click" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!--
                    卡片视图：仿游戏干员卡——立绘、稀有度色框、职业徽记、精英角标，
                    点击整卡切换编入随机池。
                -->
                <ScrollViewer IsVisible="{Binding IsCardView}"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl Name="StaffCards"
                                  Margin="16"
                                  ItemsSource="{Binding FilteredStaffList}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Staff">
                                <Border Classes="operator-card-host"
                                        ToolTip.Tip="点击卡片编入 / 移出随机池">
                                    <Grid>
                                        <Border Classes="operator-card"
                                                BorderBrush="{Binding RarityBrush}">
                                            <Grid>
                                                <!--
                                                    图源始终是 180×360 立绘（精二用 _2）。
                                                    半身像铺满卡片；头像放大后只露出上半截，相当于 180×180 头像那一块。
                                                -->
                                                <Image Stretch="UniformToFill"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Top"
                                                       RenderTransformOrigin="0.5,0"
                                                       RenderTransform="{Binding UsePortrait, Converter={x:Static views:StaffCardVisual.ArtViewportTransform}}"
                                                       Opacity="{Binding IsSelected, Converter={x:Static views:StaffCardVisual.ArtOpacity}}"
                                                       views:ArtImage.Sources="{Binding DisplayArtUris}" />

                                                <!-- 底部名牌：稀有度色软底，保证名字始终可读 -->
                                                <Border VerticalAlignment="Bottom" Height="86">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                            <GradientStop Offset="0" Color="#000B1118" />
                                                            <GradientStop Offset="0.28" Color="#B30B1118" />
                                                            <GradientStop Offset="1" Color="#F50B1118" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>

                                                <!-- 顶部压深，突出职业图标与星级 -->
                                                <Border VerticalAlignment="Top" Height="48">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                            <GradientStop Offset="0" Color="#D90B1118" />
                                                            <GradientStop Offset="1" Color="#000B1118" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>

                                                <!-- 稀有度顶栏，对齐游戏卡框 -->
                                                <Border Height="4"
                                                        VerticalAlignment="Top"
                                                        Background="{Binding RarityBrush}" />

                                                <!-- 无立绘时（手动录入的干员）用官方职业图标占位 -->
                                                <Image Width="56"
                                                       Height="56"
                                                       Opacity="0.35"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding !HasArt}"
                                                       views:ArtImage.Sources="{Binding CareerIconUris}" />

                                                <!-- 左上：职业徽记 + 精英阶段 -->
                                                <StackPanel Margin="8,10,0,0"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Orientation="Horizontal"
                                                            Spacing="6">
                                                    <Border Classes="class-badge"
                                                            BorderBrush="{Binding CareerBrush}"
                                                            Background="{Binding CareerSoftBrush}">
                                                        <Image Width="16"
                                                               Height="16"
                                                               Stretch="Uniform"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               views:ArtImage.Sources="{Binding CareerIconUris}" />
                                                    </Border>
                                                    <Border Classes="elite-chip" VerticalAlignment="Center">
                                                        <TextBlock FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource AppTextBrush}"
                                                                   Text="{Binding EliteLabel}" />
                                                    </Border>
                                                </StackPanel>

                                                <!-- 右上：稀有度星 -->
                                                <TextBlock Classes="operator-card-stars"
                                                           Margin="0,10,8,0"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Top"
                                                           Foreground="{Binding RarityBrush}"
                                                           Text="{Binding StarGlyphs}" />

                                                <!-- 名称 / 职业 / 等级 / 编入状态 -->
                                                <Grid Margin="10,0,10,8"
                                                      VerticalAlignment="Bottom"
                                                      RowDefinitions="Auto,6,Auto">
                                                    <Grid ColumnDefinitions="*,8,Auto">
                                                        <TextBlock Classes="operator-card-name"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Text="{Binding Name}" />
                                                        <Border Grid.Column="2"
                                                                Padding="7,2"
                                                                CornerRadius="4"
                                                                VerticalAlignment="Center"
                                                                Background="{StaticResource AppPrimaryBrush}"
                                                                IsVisible="{Binding IsSelected}">
                                                            <TextBlock FontSize="10"
                                                                       FontWeight="Bold"
                                                                       Foreground="{StaticResource AppOnPrimaryBrush}"
                                                                       Text="编入" />
                                                        </Border>
                                                    </Grid>
                                                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                                            <TextBlock FontSize="11"
                                                                       VerticalAlignment="Center"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{Binding CareerBrush}"
                                                                       Text="{Binding CareerName}" />
                                                            <TextBlock Classes="mono"
                                                                       FontSize="11"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{StaticResource AppMutedTextBrush}"
                                                                       Text="{Binding LevelDigits}" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1"
                                                                Width="36"
                                                                Height="3"
                                                                VerticalAlignment="Center"
                                                                CornerRadius="2"
                                                                Background="{Binding RarityBrush}" />
                                                    </Grid>
                                                </Grid>

                                                <!-- 战术角标：编入时四角亮起 -->
                                                <Path Margin="6,8,0,0"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Top"
                                                      IsHitTestVisible="False"
                                                      Stroke="{StaticResource AppPrimaryBrush}"
                                                      StrokeThickness="1.6"
                                                      IsVisible="{Binding IsSelected}"
                                                      Data="M 0,12 L 0,0 12,0" />
                                                <Path Margin="0,8,6,0"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Top"
                                                      IsHitTestVisible="False"
                                                      Stroke="{StaticResource AppPrimaryBrush}"
                                                      StrokeThickness="1.6"
                                                      IsVisible="{Binding IsSelected}"
                                                      Data="M 0,0 L 12,0 12,12" />
                                                <Path Margin="6,0,0,6"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Bottom"
                                                      IsHitTestVisible="False"
                                                      Stroke="{StaticResource AppPrimaryBrush}"
                                                      StrokeThickness="1.6"
                                                      IsVisible="{Binding IsSelected}"
                                                      Data="M 0,0 L 0,12 12,12" />
                                                <Path Margin="0,0,6,6"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Bottom"
                                                      IsHitTestVisible="False"
                                                      Stroke="{StaticResource AppPrimaryBrush}"
                                                      StrokeThickness="1.6"
                                                      IsVisible="{Binding IsSelected}"
                                                      Data="M 12,0 L 12,12 0,12" />

                                                <!-- 删除始终可见，触控不必先悬停 -->
                                                <Button Classes="danger compact card-delete"
                                                        Margin="0,0,8,78"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Content="×"
                                                        ToolTip.Tip="删除干员"
                                                        Tag="{Binding}"
                                                        Click="Delete_Click" />
                                            </Grid>
                                        </Border>

                                        <Border Classes="operator-card-ring"
                                                BorderBrush="{StaticResource AppPrimaryBrush}"
                                                BoxShadow="0 0 16 0 #4065E6C4"
                                                IsVisible="{Binding IsSelected}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Name="StaffEmptyState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">
                    <Path Width="42"
                          Height="42"
                          HorizontalAlignment="Center"
                          Stretch="Uniform"
                          Stroke="{StaticResource AppPrimaryBrush}"
                          StrokeThickness="1.4"
                          Opacity="0.8"
                          Data="M 0,12 L 0,0 12,0 M 30,0 L 42,0 42,12 M 42,30 L 42,42 30,42 M 12,42 L 0,42 0,30 M 12,21 H 30 M 21,12 V 30" />
                    <TextBlock Classes="muted"
                               HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="暂无干员" />
                    <TextBlock Classes="caption"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="360"
                               Text="先录入或同步干员，再编入随机池。" />
                    <TextBlock Name="StaffEmptyWebHint"
                               Classes="caption"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="360"
                               IsVisible="False"
                               Text="网页版数据只在本次会话有效，刷新即清空。长期使用请下载桌面客户端。" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="8">
                        <Button Classes="primary compact"
                                Content="去干员录入"
                                Click="GoToInput_Click" />
                        <Button Name="StaffEmptyDownloadButton"
                                Classes="text compact"
                                Content="下载桌面版"
                                IsVisible="False"
                                Click="OpenDesktop_Click" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Name="FilterEmptyState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12"
                            IsVisible="False">
                    <TextBlock Classes="muted"
                               HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="没有符合条件的干员" />
                    <TextBlock Classes="caption"
                               HorizontalAlignment="Center"
                               Text="试试改搜索词，或点「清除筛选」。" />
                    <Button Classes="secondary compact"
                            HorizontalAlignment="Center"
                            Content="清除筛选"
                            Click="ClearFilters_Click" />
                </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

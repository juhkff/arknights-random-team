<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:domain="clr-namespace:arknights_random_team.Domain"
             xmlns:models="clr-namespace:arknights_random_team.Models"
             xmlns:views="clr-namespace:arknights_random_team.Views"
             xmlns:assists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             mc:Ignorable="d"
             d:DesignWidth="760"
             d:DesignHeight="640"
             x:Class="arknights_random_team.Views.StaffListView"
             x:Name="Root"
             x:DataType="domain:ListModel"
             FontFamily="{StaticResource AppFont}">
    <UserControl.Styles>
        <Style Selector="ToggleButton.view-switch">
            <Setter Property="Theme" Value="{StaticResource AppActionButtonTheme}" />
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.view-switch:pointerover">
            <Setter Property="Background" Value="{StaticResource AppSecondaryHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        </Style>
        <Style Selector="ToggleButton.view-switch:checked">
            <Setter Property="Background" Value="{StaticResource AppPrimarySoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Path.sort-arrow">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="Data" Value="F1 M -5.215,6.099L 5.215,6.099L 0,0L -5.215,6.099 Z" />
        </Style>
        <Style Selector="ToggleButton.filter-choice">
            <Setter Property="Theme" Value="{StaticResource AppActionButtonTheme}" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Background" Value="{StaticResource AppSurfaceSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.filter-choice:checked">
            <Setter Property="Background" Value="{StaticResource AppPrimarySoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="Button.operator-card">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{StaticResource AppCardBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.operator-card:pointerover">
            <Setter Property="Background" Value="{StaticResource AppCardHoverBrush}" />
        </Style>
        <Style Selector="TextBlock.operator-card-name">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        </Style>
        <Style Selector="DataGridRow">
            <Setter Property="MinHeight" Value="56" />
        </Style>
        <Style Selector="DataGrid#StaffGrid.compact DataGridRow">
            <Setter Property="MinHeight" Value="44" />
        </Style>
        <Style Selector="Border.row-avatar">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
        </Style>
        <Style Selector="DataGrid#StaffGrid.compact Border.row-avatar">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
        </Style>
        <Style Selector="Image.row-career-icon">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
        </Style>
        <Style Selector="DataGrid#StaffGrid.compact Image.row-career-icon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="DataGridCell TextBlock.cell-start">
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="CheckBox.staff-select">
            <Setter Property="assists:SelectionControlAssist.Size" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="DataGrid#StaffGrid DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="CheckBox.card-pool">
            <Setter Property="assists:SelectionControlAssist.Size" Value="16" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        </Style>
        <Style Selector="Border.cell-hit">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ComboBox.staff-choice">
            <Setter Property="Theme" Value="{StaticResource MaterialComboBox}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MaxHeight" Value="36" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource AppSurfaceSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="ClipToBounds" Value="False" />
        </Style>
        <Style Selector="DataGridCell TextBox.staff-editor">
            <Setter Property="Theme" Value="{StaticResource SoloTextBox}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MaxHeight" Value="36" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Background" Value="{StaticResource AppInputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox.staff-choice:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="ComboBox.staff-choice:focus-within">
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="DataGridCell TextBox.staff-editor:focus-within">
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,12,Auto">
                <StackPanel VerticalAlignment="Center" Spacing="4">
                    <TextBlock FontSize="14"
                               Foreground="{StaticResource AppMutedTextBrush}"
                               Text="{Binding SummaryText}" />
                    <TextBlock Classes="caption"
                               IsVisible="{Binding HasActiveFilters}"
                               Text="{Binding VisibleSummaryText}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Classes="primary" Content="添加干员" AutomationProperties.Name="添加干员">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="手动录入" Click="AddManual_Click" />
                                <MenuItem Header="数据库同步" Click="AddSync_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Classes="icon"
                            Content="⋯"
                            AutomationProperties.Name="更多操作">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="清空全部干员"
                                          IsEnabled="{Binding ShowBatchBar}"
                                          Click="ClearAll_Click" />
                                <MenuItem Header="图片加载统计" Click="ArtStats_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <WrapPanel>
                <TextBox Name="SearchBox"
                         Classes="form-control"
                         Width="240"
                         Margin="0,0,8,8"
                         PlaceholderText="搜索干员名称……"
                         TextChanged="SearchBox_TextChanged" />
                <Button Margin="0,0,8,8" Content="筛选" AutomationProperties.Name="筛选">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                            <StackPanel Width="280" Spacing="12">
                                <TextBlock Classes="field-label" Text="职业" />
                                <ItemsControl ItemsSource="{Binding CareerFilters}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:CompileBindings="False">
                                            <ToggleButton Classes="filter-choice"
                                                          Content="{Binding Label}"
                                                          IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Classes="field-label" Text="稀有度" />
                                <ItemsControl ItemsSource="{Binding RarityFilters}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:CompileBindings="False">
                                            <ToggleButton Classes="filter-choice"
                                                          Content="{Binding Label}"
                                                          IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Classes="field-label" Text="随机池" />
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton Classes="filter-choice"
                                                  Content="全部"
                                                  IsChecked="{Binding IsPoolFilterAll, Mode=OneWay}"
                                                  Click="PoolAll_Click" />
                                    <ToggleButton Classes="filter-choice"
                                                  Content="已入池"
                                                  IsChecked="{Binding IsPoolFilterIn, Mode=OneWay}"
                                                  Click="PoolIn_Click" />
                                    <ToggleButton Classes="filter-choice"
                                                  Content="未入池"
                                                  IsChecked="{Binding IsPoolFilterOut, Mode=OneWay}"
                                                  Click="PoolOut_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <ComboBox Width="148"
                          Margin="0,0,8,8"
                          Classes="form-control"
                          ToolTip.Tip="排序"
                          AutomationProperties.Name="排序"
                          SelectedIndex="{Binding SortIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="默认排序" />
                    <ComboBoxItem Content="名称" />
                    <ComboBoxItem Content="稀有度" />
                    <ComboBoxItem Content="职业" />
                    <ComboBoxItem Content="等级" />
                </ComboBox>
                <TextBlock Margin="0,0,8,8"
                           VerticalAlignment="Center"
                           Classes="caption"
                           MaxWidth="220"
                           TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding HasSorts}"
                           Text="{Binding SortSummary}"
                           ToolTip.Tip="点击表头可追加多列排序，左侧为第一优先级"
                           AutomationProperties.Name="当前排序" />
                <Border Margin="0,0,8,8"
                        Padding="3"
                        Background="{StaticResource AppWellBrush}"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <ToggleButton Name="GridViewButton"
                                      Classes="view-switch"
                                      Content="表格"
                                      AutomationProperties.Name="切换到表格视图"
                                      IsChecked="{Binding IsGridView, Mode=OneWay}"
                                      Click="GridView_Click" />
                        <ToggleButton Name="AvatarModeButton"
                                      Classes="view-switch"
                                      Content="头像"
                                      AutomationProperties.Name="切换到头像视图"
                                      IsChecked="{Binding IsAvatarView, Mode=OneWay}"
                                      Click="AvatarMode_Click" />
                        <ToggleButton Name="PortraitModeButton"
                                      Classes="view-switch"
                                      Content="立绘"
                                      AutomationProperties.Name="切换到立绘视图"
                                      IsChecked="{Binding IsPortraitView, Mode=OneWay}"
                                      Click="PortraitMode_Click" />
                    </StackPanel>
                </Border>
                <ToggleButton Name="CompactToggle"
                              Margin="0,0,8,8"
                              Classes="view-switch"
                              Content="紧凑"
                              IsVisible="{Binding IsGridView}"
                              AutomationProperties.Name="切换表格紧凑行高"
                              ToolTip.Tip="紧凑行高 44；关闭为 56"
                              IsChecked="{Binding IsCompactTable, Mode=TwoWay}" />
            </WrapPanel>

            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasActiveFilters}">
                <ItemsControl ItemsSource="{Binding ActiveFilters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="domain:FilterChip">
                            <Border Classes="filter-chip" Margin="0,0,8,4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock VerticalAlignment="Center" FontSize="12" Text="{Binding Label}" />
                                    <Button Classes="text compact"
                                            MinWidth="24" Width="24" Height="24"
                                            Padding="0"
                                            Content="×"
                                            Tag="{Binding}"
                                            Click="RemoveChip_Click" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Grid.Column="1"
                        Classes="text"
                        Content="清除筛选"
                        Click="ClearFilters_Click" />
            </Grid>

            <TextBlock Classes="caption"
                       IsVisible="{Binding HasActiveFilters}"
                       Text="{Binding SelectAllScopeText}" />

            <Border Classes="surface-subtle"
                    Padding="12,8"
                    IsVisible="{Binding HasArtLoadFailures}">
                <TextBlock Classes="caption"
                           Text="部分图片加载失败，名称和操作仍可使用。" />
            </Border>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,12,0,0">
        <Border Name="BatchFooter"
                DockPanel.Dock="Bottom"
                Padding="0,12,0,0"
                Background="{StaticResource AppBackgroundBrush}">
        <Grid Name="BatchRow">
            <StackPanel Name="BatchBar"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Spacing="8">
                <Button Classes="secondary"
                        Content="将当前筛选结果加入随机池"
                        IsEnabled="{Binding CanBatch}"
                        Click="BatchAdd_Click" />
                <Button Content="将当前筛选结果移出随机池"
                        IsEnabled="{Binding CanBatch}"
                        Click="BatchRemove_Click" />
            </StackPanel>
            <Button Name="BatchMenuButton"
                    HorizontalAlignment="Left"
                    IsVisible="False"
                    Content="{Binding BatchMenuText}">
                <Button.Flyout>
                    <MenuFlyout Placement="TopEdgeAlignedLeft">
                        <MenuItem Header="将当前筛选结果加入随机池"
                                  IsEnabled="{Binding CanBatch}"
                                  Click="BatchAdd_Click" />
                        <MenuItem Header="将当前筛选结果移出随机池"
                                  IsEnabled="{Binding CanBatch}"
                                  Click="BatchRemove_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>
        </Border>

        <Border Classes="surface data-frame" Padding="0" ClipToBounds="True">
            <Grid>
                <DataGrid Name="StaffGrid"
                          Classes.compact="{Binding IsCompactTable}"
                          IsVisible="{Binding ShowGrid}"
                          AutoGenerateColumns="False"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="False"
                          HorizontalScrollBarVisibility="Auto"
                          SelectionMode="Single"
                          ItemsSource="{Binding VisibleStaff}"
                          PreparingCellForEdit="StaffGrid_PreparingCellForEdit"
                          CellEditEnded="StaffGrid_CellEditEnded"
                          SelectionChanged="StaffGrid_SelectionChanged"
                          Sorting="StaffGrid_Sorting">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="56"
                                                MinWidth="56"
                                                MaxWidth="56"
                                                CanUserResize="False"
                                                CanUserSort="False">
                            <DataGridTemplateColumn.Header>
                                <Border Classes="cell-hit" PointerPressed="SelectAllHeader_PointerPressed"
                                        PointerMoved="SelectAllHeader_PointerMoved"
                                        PointerReleased="SelectAllHeader_PointerReleased">
                                    <CheckBox Classes="staff-select"
                                              IsThreeState="True"
                                              ToolTip.Tip="{Binding #Root.((domain:ListModel)DataContext).SelectAllScopeText}"
                                              IsChecked="{Binding #Root.((domain:ListModel)DataContext).IsAllStaffSelected, Mode=OneWay}"
                                              Click="SelectAll_Click" />
                                </Border>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Staff">
                                    <Border Classes="cell-hit" PointerPressed="SelectCell_PointerPressed"
                                            PointerMoved="SelectCell_PointerMoved"
                                            PointerReleased="SelectCell_PointerReleased">
                                        <CheckBox Classes="staff-select"
                                                  AutomationProperties.Name="{Binding PoolAutomationName}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="2.4*"
                                                MinWidth="168"
                                                SortMemberPath="Name">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="4"
                                            Margin="4,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="点击按名称排序，再点切换降序，第三次取消该列">
                                    <TextBlock Text="干员" VerticalAlignment="Center" />
                                    <Path Classes="sort-arrow"
                                          IsVisible="{Binding #Root.((domain:ListModel)DataContext).NameSort, Converter={x:Static views:SortVisual.IsAscending}}" />
                                    <Path Classes="sort-arrow"
                                          IsVisible="{Binding #Root.((domain:ListModel)DataContext).NameSort, Converter={x:Static views:SortVisual.IsDescending}}"
                                          RenderTransform="scale(1,-1)" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Staff">
                                    <Grid ColumnDefinitions="Auto,12,*" Margin="4,0" ToolTip.Tip="双击编辑名称">
                                        <Border Classes="row-avatar"
                                                CornerRadius="6"
                                                ClipToBounds="True"
                                                Background="{StaticResource AppWellBrush}"
                                                BorderBrush="{StaticResource AppBorderBrush}"
                                                BorderThickness="1">
                                            <Panel>
                                                <Image Name="RowArt"
                                                       Stretch="UniformToFill"
                                                       views:ArtImage.Sources="{Binding AvatarUris}" />
                                                <Image Classes="row-career-icon"
                                                       Opacity="0.75"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding (views:ArtImage.LoadState), ElementName=RowArt, Converter={x:Static views:StaffCardVisual.IsArtPlaceholder}}"
                                                       views:ArtImage.Sources="{Binding CareerIconUris}" />
                                            </Panel>
                                        </Border>
                                        <TextBlock Grid.Column="2"
                                                   Classes="cell-start"
                                                   FontWeight="SemiBold"
                                                   FontSize="15"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Name}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate x:DataType="models:Staff">
                                    <TextBox Classes="staff-editor"
                                             Text="{Binding Name, Mode=TwoWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="100"
                                                MinWidth="88"
                                                SortMemberPath="Star">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="点击按稀有度排序，再点切换降序，第三次取消该列">
                                    <TextBlock Text="稀有度" VerticalAlignment="Center" />
                                    <Path Classes="sort-arrow"
                                          IsVisible="{Binding #Root.((domain:ListModel)DataContext).StarSort, Converter={x:Static views:SortVisual.IsAscending}}" />
                                    <Path Classes="sort-arrow"
                                          IsVisible="{Binding #Root.((domain:ListModel)DataContext).StarSort, Converter={x:Static views:SortVisual.IsDescending}}"
                                          RenderTransform="scale(1,-1)" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Staff">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding RarityBrush}"
                                               ToolTip.Tip="双击编辑稀有度"
                                               Text="{Binding RarityMark}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate x:DataType="models:Staff">
                                    <ComboBox Classes="staff-choice dense"
                                              ItemsSource="{x:Static models:AppOptions.Stars}"
                                              SelectedItem="{Binding Star, Mode=TwoWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="112"
                                                MinWidth="104"
                                                SortMemberPath="Career">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="4"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="点击按职业排序，再点切换降序，第三次取消该列">
                                    <TextBlock Text="职业" VerticalAlignment="Center" />
                                    <Path Classes="sort-arrow"
                                          IsVisible="{Binding #Root.((domain:ListModel)DataContext).CareerSort, Converter={x:Static views:SortVisual.IsAscending}}" />
                                    <Path Classes="sort-arrow"
                                          IsVisible="{Binding #Root.((domain:ListModel)DataContext).CareerSort, Converter={x:Static views:SortVisual.IsDescending}}"
                                          RenderTransform="scale(1,-1)" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Staff">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Spacing="8"
                                                ToolTip.Tip="双击编辑职业">
                                        <Image Width="16" Height="16"
                                               Stretch="Uniform"
                                               views:ArtImage.Sources="{Binding CareerIconUris}" />
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{Binding CareerName}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate x:DataType="models:Staff">
                                    <ComboBox Classes="staff-choice dense"
                                              ItemsSource="{x:Static models:AppOptions.Careers}"
                                              SelectedItem="{Binding Career, Mode=TwoWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="1.2*"
                                                MinWidth="120"
                                                SortMemberPath="Level">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="4"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="点击按精英阶段与等级排序，再点切换降序，第三次取消该列">
                                    <TextBlock Text="精英 / 等级" VerticalAlignment="Center" />
                                    <Path Classes="sort-arrow"
                                          IsVisible="{Binding #Root.((domain:ListModel)DataContext).LevelSort, Converter={x:Static views:SortVisual.IsAscending}}" />
                                    <Path Classes="sort-arrow"
                                          IsVisible="{Binding #Root.((domain:ListModel)DataContext).LevelSort, Converter={x:Static views:SortVisual.IsDescending}}"
                                          RenderTransform="scale(1,-1)" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Staff">
                                    <TextBlock HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               ToolTip.Tip="双击编辑，格式如 精二90级"
                                               Text="{Binding LevelLine}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate x:DataType="models:Staff">
                                    <TextBox Classes="staff-editor"
                                             Text="{Binding Level.Description, Mode=TwoWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="64"
                                                MinWidth="64"
                                                MaxWidth="64"
                                                CanUserResize="False"
                                                CanUserSort="False">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="更多"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Staff">
                                            <Button Classes="text compact"
                                            MinWidth="32" Width="32" Height="32"
                                            HorizontalAlignment="Center"
                                            Content="⋯"
                                            Tag="{Binding}"
                                            AutomationProperties.Name="更多">
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuItem Header="详情 / 编辑"
                                                          Tag="{Binding}"
                                                          Click="Detail_Click" />
                                                <MenuItem Header="删除干员"
                                                          Tag="{Binding}"
                                                          Click="Delete_Click" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <ScrollViewer IsVisible="{Binding ShowCards}"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsRepeater Name="StaffCards"
                                   Margin="16"
                                   ItemsSource="{Binding VisibleStaff}">
                        <ItemsRepeater.Layout>
                            <!-- 虚拟化网格：只实例化可见区及其邻近的卡片，几百名干员时
                                 不再一次性创建全部卡片控件（方案 §5.3）。 -->
                            <UniformGridLayout MinItemWidth="156"
                                               MinItemHeight="224"
                                               MinRowSpacing="12"
                                               MinColumnSpacing="12"
                                               ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:Staff">
                                <Button Classes="operator-card"
                                        BorderBrush="{Binding IsSelected, Converter={x:Static views:StaffCardVisual.PoolBorder}}"
                                        ToolTip.Tip="{Binding Name}"
                                        AutomationProperties.Name="{Binding PoolAutomationName}"
                                        AutomationProperties.HelpText="按空格或回车切换随机池状态；按 Tab 可聚焦卡片内的入池勾选框；⋯ 菜单可查看详情或删除"
                                        PointerPressed="OperatorCard_PointerPressed"
                                        PointerMoved="OperatorCard_PointerMoved"
                                        PointerReleased="OperatorCard_PointerReleased"
                                        KeyDown="OperatorCard_KeyDown"
                                        Click="OperatorCard_Click">
                                    <Grid RowDefinitions="*,68">
                                        <Panel ClipToBounds="True">
                                            <views:StaffThumb Sources="{Binding DisplayArtUris}"
                                                              PlaceholderSources="{Binding CareerIconUris}"
                                                              PlaceholderSize="48"
                                                              PlaceholderOpacity="0.45"
                                                              Stretch="{Binding UsePortrait, Converter={x:Static views:StaffCardVisual.ArtStretch}}"
                                                              VerticalArtAlignment="{Binding UsePortrait, Converter={x:Static views:StaffCardVisual.ArtAlignment}}" />
                                            <Border Height="40"
                                                    VerticalAlignment="Top"
                                                    IsHitTestVisible="False">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#D0101418" Offset="0" />
                                                        <GradientStop Color="#00101418" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Grid Margin="8" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Top">
                                                <TextBlock FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding RarityBrush}"
                                                           Text="{Binding RarityMark}" />
                                                <Border Grid.Column="2"
                                                        Padding="6,2"
                                                        CornerRadius="6"
                                                        Background="#C0101418">
                                                    <CheckBox Classes="card-pool"
                                                              Content="{Binding PoolCheckLabel}"
                                                              AutomationProperties.Name="{Binding PoolAutomationName}"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              Click="CardPoolCheck_Click" />
                                                </Border>
                                            </Grid>
                                        </Panel>
                                        <Grid Grid.Row="1"
                                              Margin="8,4,4,6"
                                              ColumnDefinitions="*,Auto"
                                              RowDefinitions="Auto,*">
                                            <TextBlock Classes="operator-card-name"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Name}" />
                                            <Button Grid.Column="1"
                                                    Classes="text compact"
                                                    MinWidth="32" Width="32" Height="32"
                                                    Content="⋯"
                                                    Tag="{Binding}"
                                                    AutomationProperties.Name="更多">
                                                <Button.Flyout>
                                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                        <MenuItem Header="详情 / 编辑"
                                                                  Tag="{Binding}"
                                                                  Click="Detail_Click" />
                                                        <MenuItem Header="删除干员"
                                                                  Tag="{Binding}"
                                                                  Click="Delete_Click" />
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                            <StackPanel Grid.Row="1"
                                                        Grid.ColumnSpan="2"
                                                        Orientation="Horizontal"
                                                        Spacing="6">
                                                <Image Width="14" Height="14"
                                                       Stretch="Uniform"
                                                       VerticalAlignment="Center"
                                                       views:ArtImage.Sources="{Binding CareerIconUris}" />
                                                <TextBlock FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource AppMutedTextBrush}"
                                                           Text="{Binding CareerName}" />
                                                <TextBlock FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource AppMutedTextBrush}"
                                                           Text="{Binding LevelLine}" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>

                <StackPanel Name="StaffEmptyState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{Binding ShowStaffEmpty}"
                            Spacing="12">
                    <TextBlock Classes="muted"
                               HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="暂无干员" />
                    <TextBlock Classes="caption"
                               HorizontalAlignment="Center"
                               Text="先录入或同步干员，再编入随机池。" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                        <Button Classes="primary" Content="手动录入" Click="AddManual_Click" />
                        <Button Classes="secondary" Content="数据库同步" Click="AddSync_Click" />
                    </StackPanel>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{Binding ShowFilterEmpty}"
                            Spacing="12">
                    <TextBlock Classes="muted"
                               HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="没有符合条件的干员" />
                    <TextBlock Classes="caption"
                               HorizontalAlignment="Center"
                               Text="调整搜索或筛选条件后再试。" />
                    <Button Classes="secondary"
                            HorizontalAlignment="Center"
                            Content="清除筛选"
                            Click="ClearFilters_Click" />
                </StackPanel>
            </Grid>
        </Border>
        </DockPanel>
    </Grid>
</UserControl>

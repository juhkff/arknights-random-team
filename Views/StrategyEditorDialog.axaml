<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:domain="clr-namespace:arknights_random_team.Domain"
             xmlns:models="clr-namespace:arknights_random_team.Models"
             mc:Ignorable="d"
             x:Class="arknights_random_team.Views.StrategyEditorDialog"
             Width="960"
             Height="740"
             MinWidth="600"
             MinHeight="440"
             FontFamily="{StaticResource AppFont}"
             FontSize="14"
             Background="Transparent">
    <UserControl.Styles>
        <Style Selector="TextBox.inline">
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="MaxHeight" Value="44" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.inline">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="MaxHeight" Value="44" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style Selector="ListBox#RulesList">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBox#RulesList ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.rule-row">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{StaticResource AppSurfaceSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ListBox#RulesList ListBoxItem:pointerover Border.rule-row">
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="ListBox#RulesList ListBoxItem:selected">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox#RulesList ListBoxItem:selected Border.rule-row">
            <Setter Property="Background" Value="{StaticResource AppPrimarySoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="ListBox#RulesList ListBoxItem:selected TextBlock.rule-text">
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="ListBox#RulesList ListBoxItem:focus-visible Border.rule-row">
            <Setter Property="BorderBrush" Value="{StaticResource AppSignalBrush}" />
        </Style>
        <Style Selector="ListBox#RulesList Button.cancel-edit">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ListBox#RulesList ListBoxItem:selected Button.cancel-edit">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="TextBlock.rules-hint.editing">
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.form-section">
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Border.form-section.editing">
            <Setter Property="Background" Value="{StaticResource AppPrimarySoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Border.staff-chip">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.staff-chip TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.staff-chip Button">
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="Width" Value="40" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="92,*,80">
        <Border Grid.Row="0"
                Padding="24,0"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel VerticalAlignment="Center" Spacing="4">
                <TextBlock Classes="eyebrow" Text="STRATEGY / RULE BUILDER" />
                <TextBlock FontSize="22" FontWeight="Bold" Text="随机策略编辑器" />
                <TextBlock Classes="caption" Text="配置阵容生成时需要满足的规则" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1"
              Margin="24,20"
              ColumnDefinitions="280,20,*">
            <Grid Grid.Column="0" RowDefinitions="Auto,18,*">
                <Border Grid.Row="0" Classes="surface" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="field-label" Text="策略名称" />
                        <TextBox Name="NameBox"
                                 Classes="form-control dense"
                                 HorizontalAlignment="Stretch"
                                 PlaceholderText="输入策略名称" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Classes="surface" Padding="16">
                    <Grid RowDefinitions="Auto,14,*,12,Auto">
                        <StackPanel Grid.Row="0" Spacing="5">
                            <TextBlock Classes="section-title" Text="已有规则" />
                            <TextBlock Classes="caption" Text="选择后可编辑" />
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <ListBox Name="RulesList"
                                     SelectionMode="Single"
                                     SelectionChanged="RulesList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="domain:StrategyRule">
                                        <Border Classes="rule-row">
                                            <Grid RowDefinitions="Auto,12,Auto">
                                                <Grid Grid.Row="0" ColumnDefinitions="3,10,*">
                                                    <Border Width="3"
                                                            Margin="0,2"
                                                            Background="{StaticResource AppPrimaryBrush}"
                                                            CornerRadius="2" />
                                                    <TextBlock Grid.Column="2"
                                                               Classes="rule-text"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding SummaryLine}"
                                                               TextWrapping="Wrap" />
                                                </Grid>
                                                <StackPanel Grid.Row="2"
                                                            HorizontalAlignment="Right"
                                                            Orientation="Horizontal"
                                                            Spacing="8">
                                                    <Button Classes="secondary compact cancel-edit"
                                                            Content="取消编辑"
                                                            Click="CancelRuleEdit_Click" />
                                                    <Button Classes="danger compact"
                                                            MinWidth="64"
                                                            Content="移除"
                                                            Tag="{Binding}"
                                                            Click="RemoveRule_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Name="RulesEmptyState"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Classes="muted"
                                       FontWeight="SemiBold"
                                       Text="暂无规则" />
                        </Grid>

                        <TextBlock Name="RulesHintText"
                                   Grid.Row="4"
                                   Classes="caption rules-hint"
                                   TextWrapping="Wrap"
                                   Text="未选择规则" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="2" RowDefinitions="Auto,14,*">
                <StackPanel Grid.Row="0" Spacing="5">
                    <TextBlock Classes="section-title" Text="规则构建器" />
                    <TextBlock Classes="caption" Text="稀有度、职业与指定干员" />
                </StackPanel>

                <ScrollViewer Grid.Row="2"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <Border Name="RaritySection" Classes="form-section">
                            <StackPanel Spacing="14">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="稀有度人数" />
                                <Grid ColumnDefinitions="*,12,*,12,80"
                                      RowDefinitions="Auto,8,44">
                                    <TextBlock Grid.Column="0" Classes="caption" Text="稀有度" />
                                    <TextBlock Grid.Column="2" Classes="caption" Text="人数" />
                                    <ComboBox Name="StarCombo"
                                              Grid.Row="2"
                                              Grid.Column="0"
                                              Classes="inline dense"
                                              HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Static models:AppOptions.Stars}" />
                                    <TextBox Name="RarityCountBox"
                                             Grid.Row="2"
                                             Grid.Column="2"
                                             Classes="inline dense"
                                             HorizontalAlignment="Stretch"
                                             PlaceholderText="数量" />
                                    <Button Name="RarityRuleSubmitButton"
                                            Grid.Row="2"
                                            Grid.Column="4"
                                            Classes="primary inline"
                                            HorizontalAlignment="Stretch"
                                            Content="添加"
                                            Click="AddRarityRule_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Name="CareerSection" Classes="form-section">
                            <StackPanel Spacing="14">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="职业人数" />
                                <Grid ColumnDefinitions="*,12,*"
                                      RowDefinitions="Auto,8,44">
                                    <TextBlock Grid.Column="0" Classes="caption" Text="职业" />
                                    <TextBlock Grid.Column="2" Classes="caption" Text="约束" />
                                    <ComboBox Name="CareerCombo"
                                              Grid.Row="2"
                                              Grid.Column="0"
                                              Classes="inline dense"
                                              HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Static models:AppOptions.Careers}" />
                                    <ComboBox Name="CareerConstraintModeCombo"
                                              Grid.Row="2"
                                              Grid.Column="2"
                                              Classes="inline dense"
                                              HorizontalAlignment="Stretch"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="固定值" />
                                        <ComboBoxItem Content="范围" />
                                    </ComboBox>
                                </Grid>
                                <Grid ColumnDefinitions="*,12,80"
                                      RowDefinitions="Auto,8,44">
                                    <TextBlock Grid.Column="0" Classes="caption" Text="人数 / 范围" />
                                    <Grid Grid.Row="2" Grid.Column="0">
                                        <TextBox Name="CareerCountBox"
                                                 Classes="inline dense"
                                                 HorizontalAlignment="Stretch"
                                                 PlaceholderText="数量" />
                                        <Grid ColumnDefinitions="*,10,*">
                                            <TextBox Name="CareerRangeMinBox"
                                                     Grid.Column="0"
                                                     Classes="inline dense"
                                                     HorizontalAlignment="Stretch"
                                                     PlaceholderText="最小"
                                                     IsVisible="False" />
                                            <TextBox Name="CareerRangeMaxBox"
                                                     Grid.Column="2"
                                                     Classes="inline dense"
                                                     HorizontalAlignment="Stretch"
                                                     PlaceholderText="最大"
                                                     IsVisible="False" />
                                        </Grid>
                                    </Grid>
                                    <Button Name="CareerRuleSubmitButton"
                                            Grid.Row="2"
                                            Grid.Column="2"
                                            Classes="primary inline"
                                            HorizontalAlignment="Stretch"
                                            Content="添加"
                                            Click="AddCareerConstraint_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Name="StaffSection" Classes="form-section">
                            <StackPanel Spacing="14">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="指定干员人数" />
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="caption" Text="干员范围" />
                                    <WrapPanel Name="StaffSubsetFlowPanel" MinHeight="52">
                                        <Button Name="StaffSubsetAddButton"
                                                Classes="secondary inline"
                                                MinWidth="112"
                                                Margin="0,0,8,8"
                                                Content="选择干员"
                                                Click="StaffSubsetAddButton_Click" />
                                    </WrapPanel>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,12,1.5*"
                                      RowDefinitions="Auto,8,44,14,44">
                                    <TextBlock Grid.Column="0" Classes="caption" Text="约束" />
                                    <TextBlock Grid.Column="2" Classes="caption" Text="人数 / 范围" />
                                    <ComboBox Name="StaffSubsetModeCombo"
                                              Grid.Row="2"
                                              Grid.Column="0"
                                              Classes="inline dense"
                                              HorizontalAlignment="Stretch"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="固定值" />
                                        <ComboBoxItem Content="范围" />
                                    </ComboBox>
                                    <TextBox Name="StaffSubsetExactCountBox"
                                             Grid.Row="2"
                                             Grid.Column="2"
                                             Classes="inline dense"
                                             HorizontalAlignment="Stretch"
                                             PlaceholderText="数量" />
                                    <Grid Name="StaffSubsetRangeInputPanel"
                                          Grid.Row="2"
                                          Grid.Column="2"
                                          ColumnDefinitions="*,10,*"
                                          IsVisible="False">
                                        <TextBox Name="StaffSubsetRangeMinBox"
                                                 Grid.Column="0"
                                                 Classes="inline dense"
                                                 HorizontalAlignment="Stretch"
                                                 PlaceholderText="最小" />
                                        <TextBox Name="StaffSubsetRangeMaxBox"
                                                 Grid.Column="2"
                                                 Classes="inline dense"
                                                 HorizontalAlignment="Stretch"
                                                 PlaceholderText="最大" />
                                    </Grid>
                                    <Button Name="StaffSubsetRuleSubmitButton"
                                            Grid.Row="4"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="3"
                                            MinWidth="104"
                                            HorizontalAlignment="Right"
                                            Classes="primary inline"
                                            Content="添加"
                                            Click="AddStaffSubsetRule_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Padding="24,0"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="12">
                <Button Classes="secondary" MinWidth="96" Content="取消" Click="Cancel_Click" />
                <Button Classes="primary" MinWidth="128" Content="保存策略" Click="Ok_Click" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

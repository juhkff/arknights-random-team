<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             xmlns:views="clr-namespace:arknights_random_team.Views"
             mc:Ignorable="d"
             d:DesignWidth="1240"
             d:DesignHeight="820"
             x:Class="arknights_random_team.Views.MainView"
             FontFamily="{StaticResource AppFont}"
             FontSize="14"
             Background="{StaticResource AppBackgroundBrush}"
             Foreground="{StaticResource AppTextBrush}">
    <UserControl.Styles>
        <Style Selector="Button.nav-item">
            <Setter Property="Theme" Value="{StaticResource AppActionButtonTheme}" />
            <Setter Property="Height" Value="44" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AppSidebarTextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource AppRadiusControl}" />
        </Style>
        <Style Selector="Button.nav-item:pointerover">
            <Setter Property="Background" Value="{StaticResource AppSidebarHoverBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        </Style>
        <Style Selector="Button.nav-item:pressed">
            <Setter Property="Background" Value="{StaticResource AppSidebarPressedBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        </Style>
        <Style Selector="Button.nav-item.active">
            <Setter Property="Background" Value="{StaticResource AppSidebarActiveBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="Button.nav-item.active:pointerover">
            <Setter Property="Background" Value="{StaticResource AppSidebarActiveHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="Button.nav-item.active:pressed">
            <Setter Property="Background" Value="{StaticResource AppSidebarActivePressedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="Button.nav-item Border.nav-indicator">
            <Setter Property="Background" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Button.nav-item.active Border.nav-indicator">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.nav-item Path.nav-icon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stroke" Value="{StaticResource AppSidebarMutedBrush}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
        </Style>
        <Style Selector="Button.nav-item.active Path.nav-icon">
            <Setter Property="Stroke" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="Button.nav-item:pointerover Path.nav-icon">
            <Setter Property="Stroke" Value="{StaticResource AppTextBrush}" />
        </Style>
        <Style Selector="Button.nav-item.active:pointerover Path.nav-icon">
            <Setter Property="Stroke" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="Button.nav-item TextBlock.nav-label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AppSidebarTextBrush}" />
        </Style>
        <Style Selector="Button.nav-item.active TextBlock.nav-label">
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="Button.nav-item:pointerover TextBlock.nav-label">
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        </Style>
        <Style Selector="Button.nav-item.active:pointerover TextBlock.nav-label">
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="Button.nav-item.compact TextBlock.nav-label">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Button.nav-item.compact">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <views:ThemedTitleBar Name="ShellTitleBar"
                              DockPanel.Dock="Top"
                              IsVisible="False" />
        <Grid>
        <controls:SnackbarHost HostName="MainSnackbar"
                               SnackbarHorizontalAlignment="Center"
                               SnackbarVerticalAlignment="Bottom">
            <Grid>
                <Grid Name="MainContent">
                    <Grid RowDefinitions="Auto,*">
                        <Border Name="PageHeader"
                                Height="64"
                                Padding="24,0"
                                Background="{StaticResource AppSurfaceBrush}"
                                BorderBrush="{StaticResource AppBorderBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="Auto,*">
                                <Button Name="MenuButton"
                                        Classes="icon"
                                        Width="40"
                                        Height="40"
                                        Padding="0"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        IsVisible="False"
                                        AutomationProperties.Name="打开导航"
                                        Click="MenuButton_Click">
                                    <Path Width="16" Height="16"
                                          Stretch="None"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          StrokeThickness="1.6"
                                          StrokeLineCap="Round"
                                          Data="M 2,4 H 14 M 2,8 H 14 M 2,12 H 14" />
                                </Button>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Name="WindowTitle"
                                               Classes="page-title"
                                               FontSize="24"
                                               Text="阵容生成" />
                                    <TextBlock Name="WindowSubtitle"
                                               Classes="caption"
                                               Text="从已启用的干员中生成一支阵容" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ContentControl Name="PageHost"
                                        Grid.Row="1"
                                        Margin="24"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        ClipToBounds="False" />
                    </Grid>
                </Grid>

                <Border Name="NavScrim"
                        Background="{StaticResource AppVeilBrush}"
                        IsVisible="False"
                        PointerPressed="NavScrim_PointerPressed" />

                <Border Name="Sidebar"
                        Width="208"
                        HorizontalAlignment="Left"
                        ClipToBounds="True"
                        Background="{StaticResource AppSidebarBrush}"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Grid Name="BrandBlock" Margin="16,16,16,12">
                            <Border Name="BrandMark"
                                    Width="40" Height="40" CornerRadius="{StaticResource AppRadiusControl}"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource AppPrimarySoftBrush}"
                                    BorderBrush="{StaticResource AppPrimaryBrush}"
                                    BorderThickness="1">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AppPrimaryBrush}"
                                           Text="RT" />
                            </Border>
                            <Border Name="BrandCopy" Margin="52,0,0,0" VerticalAlignment="Center">
                                <StackPanel Spacing="4">
                                    <TextBlock FontSize="16" FontWeight="Bold" Text="明日方舟" />
                                    <TextBlock FontSize="12"
                                               FontFamily="{StaticResource AppMonoFont}"
                                               Foreground="{StaticResource AppMutedTextBrush}"
                                               Text="RANDOM TEAM" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="8,0" Spacing="4">
                            <Button Name="GenerateNavButton"
                                    Classes="nav-item"
                                    AutomationProperties.Name="阵容生成"
                                    ToolTip.Tip="阵容生成"
                                    Click="ChangeToGenerate">
                                <Grid ColumnDefinitions="4,40,*">
                                    <Border Classes="nav-indicator" Margin="0,8,0,8" CornerRadius="{StaticResource AppRadiusIndicator}" />
                                    <Path Grid.Column="1" Classes="nav-icon" Width="16" Height="16"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M 2,6 H 10 M 7,3 L 10,6 7,9 M 6,10 H 14 M 9,7 L 6,10 9,13" />
                                    <TextBlock Grid.Column="2" Classes="nav-label" VerticalAlignment="Center" Text="阵容生成" />
                                </Grid>
                            </Button>
                            <Button Name="InputNavButton"
                                    Classes="nav-item"
                                    AutomationProperties.Name="干员录入"
                                    ToolTip.Tip="干员录入"
                                    Click="ChangeToInput">
                                <Grid ColumnDefinitions="4,40,*">
                                    <Border Classes="nav-indicator" Margin="0,8,0,8" CornerRadius="{StaticResource AppRadiusIndicator}" />
                                    <Path Grid.Column="1" Classes="nav-icon" Width="16" Height="16"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M 8,3 V 13 M 3,8 H 13" />
                                    <TextBlock Grid.Column="2" Classes="nav-label" VerticalAlignment="Center" Text="干员录入" />
                                </Grid>
                            </Button>
                            <Button Name="ListNavButton"
                                    Classes="nav-item"
                                    AutomationProperties.Name="干员列表"
                                    ToolTip.Tip="干员列表"
                                    Click="ChangeToList">
                                <Grid ColumnDefinitions="4,40,*">
                                    <Border Classes="nav-indicator" Margin="0,8,0,8" CornerRadius="{StaticResource AppRadiusIndicator}" />
                                    <Path Grid.Column="1" Classes="nav-icon" Width="16" Height="16"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M 3,3 H 7 V 7 H 3 Z M 9,3 H 13 V 7 H 9 Z M 3,9 H 7 V 13 H 3 Z M 9,9 H 13 V 13 H 9 Z" />
                                    <TextBlock Grid.Column="2" Classes="nav-label" VerticalAlignment="Center" Text="干员列表" />
                                </Grid>
                            </Button>
                            <Button Name="StrategyNavButton"
                                    Classes="nav-item"
                                    AutomationProperties.Name="随机策略"
                                    ToolTip.Tip="随机策略"
                                    Click="ChangeToRandomStrategy">
                                <Grid ColumnDefinitions="4,40,*">
                                    <Border Classes="nav-indicator" Margin="0,8,0,8" CornerRadius="{StaticResource AppRadiusIndicator}" />
                                    <Path Grid.Column="1" Classes="nav-icon" Width="16" Height="16"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M 2,4 H 14 M 2,8 H 14 M 2,12 H 14 M 6,2 V 6 M 11,6 V 10 M 5,10 V 14" />
                                    <TextBlock Grid.Column="2" Classes="nav-label" VerticalAlignment="Center" Text="随机策略" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <Border Name="StoragePanel"
                                Grid.Row="2"
                                Margin="12,12,12,16"
                                Padding="12"
                                Background="{StaticResource AppPrimarySoftBrush}"
                                BorderBrush="{StaticResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource AppRadiusSurface}">
                            <Grid>
                                <Border Name="StorageDot"
                                        Width="8" Height="8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        CornerRadius="{StaticResource AppRadiusControl}"
                                        Background="{StaticResource AppPrimaryBrush}"
                                        IsVisible="False" />
                                <StackPanel Name="StorageCopy" Spacing="4">
                                    <TextBlock Name="StorageTitle"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AppPrimaryBrush}"
                                               Text="本地数据" />
                                    <TextBlock Name="StorageDetail"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource AppTextBrush}"
                                               Text="退出时自动保存" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </controls:SnackbarHost>

        <ContentControl Name="DialogHost"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
    </Grid>
    </DockPanel>
</UserControl>

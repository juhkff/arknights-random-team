<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:arknights_random_team.Models"
             mc:Ignorable="d"
             x:Class="arknights_random_team.Views.StaffPickDialog"
             Width="520"
             Height="620"
             MinWidth="420"
             MinHeight="420"
             FontFamily="{StaticResource AppFont}"
             FontSize="14"
             Background="Transparent">
    <UserControl.Styles>
        <Style Selector="ListBox#StaffList">
            <Setter Property="Padding" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBox#StaffList ListBoxItem">
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ListBox#StaffList ListBoxItem:pointerover">
            <Setter Property="Background" Value="{StaticResource AppInputHoverBrush}" />
        </Style>
        <Style Selector="ListBox#StaffList ListBoxItem:selected">
            <Setter Property="Background" Value="{StaticResource AppPrimarySoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="ListBox#StaffList ListBoxItem:selected TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="ListBox#StaffList ListBoxItem:focus-visible">
            <Setter Property="BorderBrush" Value="{StaticResource AppSignalBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="88,*,80">
        <Border Grid.Row="0"
                Padding="24,0"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel VerticalAlignment="Center" Spacing="4">
                <TextBlock Classes="eyebrow" Text="OPERATOR SELECT" />
                <TextBlock FontSize="20" FontWeight="Bold" Text="选择干员" />
                <TextBlock Classes="caption" Text="可同时选择多名干员" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1"
              Margin="24,18"
              RowDefinitions="Auto,16,Auto,12,*">
            <TextBox Name="SearchBox"
                     Grid.Row="0"
                     Classes="form-control dense"
                     HorizontalAlignment="Stretch"
                     PlaceholderText="搜索干员名称"
                     TextChanged="SearchBox_TextChanged" />

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                <TextBlock Name="ResultCountText"
                           VerticalAlignment="Center"
                           Classes="caption"
                           Text="0 名可选" />
                <Border Grid.Column="1"
                        Padding="10,6"
                        Background="{StaticResource AppPrimarySoftBrush}"
                        BorderBrush="{StaticResource AppPrimaryBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <TextBlock Name="SelectedCountText"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppPrimaryBrush}"
                               Text="已选 0 名" />
                </Border>
            </Grid>

            <Border Grid.Row="4" Classes="surface data-frame" ClipToBounds="True">
                <Grid>
                    <ListBox Name="StaffList"
                             SelectionMode="Multiple,Toggle"
                             SelectionChanged="StaffList_SelectionChanged"
                             DoubleTapped="StaffList_DoubleTapped"
                             KeyDown="StaffList_KeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:Staff">
                                <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <TextBlock VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="12,0"
                                                   VerticalAlignment="Center"
                                                   Classes="caption"
                                                   Text="{Binding Star, StringFormat='{}{0} 星'}" />
                                        <TextBlock Grid.Column="2"
                                                   MinWidth="44"
                                                   VerticalAlignment="Center"
                                                   Classes="caption"
                                                   Text="{Binding Career}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Name="SearchEmptyState"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Classes="muted"
                               FontWeight="SemiBold"
                               Text="没有符合条件的干员" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Padding="24,0"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="12">
                <Button Classes="secondary" MinWidth="96" Content="取消" Click="Cancel_Click" />
                <Button Classes="primary" MinWidth="112" Content="确定" Click="Ok_Click" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

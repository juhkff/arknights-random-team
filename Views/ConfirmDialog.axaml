<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="arknights_random_team.Views.ConfirmDialog"
        Title="确认操作"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppSurfaceBrush}"
        FontFamily="{StaticResource AppFont}"
        FontSize="14"
        KeyDown="Window_KeyDown">
    <Grid RowDefinitions="Auto,Auto,66">
        <Grid Margin="22,20,22,0" ColumnDefinitions="4,*">
            <Border Width="4"
                    Margin="0,2,14,2"
                    Background="{StaticResource AppDangerBrush}"
                    CornerRadius="2" />
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       FontSize="18"
                       FontWeight="Bold"
                       Text="确认操作" />
        </Grid>

        <ScrollViewer Grid.Row="1"
                      MaxHeight="260"
                      Margin="40,16,22,20"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <TextBlock Name="MessageText"
                       LineHeight="23"
                       Foreground="{StaticResource AppMutedTextBrush}"
                       TextWrapping="Wrap" />
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="22,0"
                Background="{StaticResource AppSurfaceSubtleBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                <Button Name="CancelButton"
                        Classes="secondary"
                        MinWidth="76"
                        Content="取消"
                        Click="Cancel_Click" />
                <Button Name="OkButton"
                        Classes="primary"
                        MinWidth="76"
                        Content="确定"
                        Click="Ok_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

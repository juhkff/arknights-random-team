<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:assists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
        xmlns:domain="clr-namespace:arknights_random_team.Domain"
        xmlns:models="clr-namespace:arknights_random_team.Models"
        mc:Ignorable="d"
        x:Class="arknights_random_team.Views.StrategyEditorWindow"
        Title="编辑随机策略"
        Width="640"
        SizeToContent="Height"
        MaxHeight="860"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}"
        FontSize="14"
        Background="{DynamicResource MaterialPaperBrush}">
    <Window.Styles>
        <!-- 与旧项目 StrategyInlineRowHeight=32 一致：同行下拉框 / 数字框同高，下划线贴齐 -->
        <Style Selector="ComboBox.inline">
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style Selector="TextBox.inline">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MaxHeight" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="UseFloatingPlaceholder" Value="False" />
            <Setter Property="RenderTransform" Value="translateY(-1px)" />
        </Style>
        <Style Selector="TextBox.inline /template/ DockPanel#PART_RootPanel">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MaxHeight" Value="32" />
        </Style>
        <Style Selector="TextBox.inline /template/ Panel#PART_TextFieldPanel">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MaxHeight" Value="32" />
        </Style>
        <Style Selector="TextBox.inline /template/ Border#PART_BackgroundTextField">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="TextBox.inline /template/ TextBlock#PART_HintsText">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Height" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="TextBox.inline /template/ DockPanel#PART_InnerPanel > Panel#PART_TextContainer">
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style Selector="TextBox.inline /template/ TextBlock#PART_PlaceholderText">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.inline /template/ ScrollViewer#PART_ScrollViewer">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.inline /template/ Border#PART_LabelRootBorder">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Height" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="Button.inline">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ListBox#RulesList">
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox#RulesList ListBoxItem">
            <Setter Property="Padding" Value="0,1" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ListBox#RulesList ListBoxItem:selected /template/ Border#PART_RootBorder">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox#RulesList ListBoxItem:selected /template/ Border#PART_HoverEffect">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="ListBox#RulesList ListBoxItem:selected:pointerover /template/ Border#PART_HoverEffect">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="ListBox#RulesList ListBoxItem:selected Border.rule-row">
            <Setter Property="Background" Value="{DynamicResource MaterialPrimaryLightBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialPrimaryMidBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="ListBox#RulesList ListBoxItem:selected Border.rule-accent">
            <Setter Property="Width" Value="5" />
        </Style>
        <Style Selector="ListBox#RulesList Button.cancel-edit">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ListBox#RulesList ListBoxItem:selected Button.cancel-edit">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="TextBlock.rules-hint.editing">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialPrimaryMidBrush}" />
        </Style>
        <Style Selector="Border.form-section">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style Selector="Border.form-section.editing">
            <Setter Property="Background" Value="#F8F5FC" />
            <Setter Property="BorderBrush" Value="#E4D8F5" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBox.outline /template/ TextBlock#PART_PlaceholderText">
            <Setter Property="Foreground" Value="{DynamicResource MaterialBodyLightBrush}" />
        </Style>
        <Style Selector="TextBox.outline /template/ TextBlock#PART_LabelText">
            <Setter Property="Foreground" Value="{DynamicResource MaterialBodyLightBrush}" />
        </Style>
        <Style Selector="TextBox.outline /template/ Border#PART_LabelRootBorder TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MaterialBodyLightBrush}" />
        </Style>
        <Style Selector="TextBox.outline:focus /template/ TextBlock#PART_PlaceholderText">
            <Setter Property="Foreground" Value="{DynamicResource MaterialPrimaryMidBrush}" />
        </Style>
        <Style Selector="TextBox.outline:focus /template/ TextBlock#PART_LabelText">
            <Setter Property="Foreground" Value="{DynamicResource MaterialPrimaryMidBrush}" />
        </Style>
        <Style Selector="TextBox.outline:focus /template/ Border#PART_LabelRootBorder TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MaterialPrimaryMidBrush}" />
        </Style>
    </Window.Styles>
    <ScrollViewer>
        <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock FontWeight="SemiBold"
                       Foreground="{DynamicResource MaterialPrimaryMidBrush}"
                       Text="策略名称" />
            <TextBox Name="NameBox"
                     Grid.Row="1"
                     Margin="0,8,0,16"
                     Classes="outline"
                     Theme="{StaticResource OutlineTextBox}"
                     UseFloatingPlaceholder="True"
                     assists:TextFieldAssist.Label="请输入策略名称" />

            <TextBlock Grid.Row="2"
                       Margin="0,0,0,8"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource MaterialPrimaryMidBrush}"
                       Text="策略条目" />

            <StackPanel Grid.Row="3" Margin="0,0,0,16">
                <ListBox Name="RulesList"
                         MinHeight="120"
                         MaxHeight="220"
                         SelectionMode="Single"
                         SelectionChanged="RulesList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="domain:StrategyRule">
                            <Border Classes="rule-row"
                                    MinHeight="0"
                                    Margin="0,0,0,2"
                                    Padding="8,4"
                                    Background="#F6F3FB"
                                    CornerRadius="6">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                    <Border Classes="rule-accent"
                                            Width="3"
                                            Margin="0,1,8,1"
                                            Background="{DynamicResource MaterialPrimaryMidBrush}"
                                            CornerRadius="1.5" />
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Text="{Binding SummaryLine}" />
                                    <Button Grid.Column="2"
                                            Classes="cancel-edit"
                                            MinHeight="28"
                                            Height="28"
                                            Margin="8,0,0,0"
                                            Padding="8,0"
                                            VerticalAlignment="Center"
                                            Theme="{StaticResource FlatButton}"
                                            Foreground="{DynamicResource MaterialPrimaryMidBrush}"
                                            Content="取消编辑"
                                            Click="CancelRuleEdit_Click" />
                                    <Button Grid.Column="3"
                                            MinHeight="28"
                                            Height="28"
                                            Padding="8,0"
                                            VerticalAlignment="Center"
                                            Theme="{StaticResource FlatButton}"
                                            Foreground="#c62828"
                                            Content="移除"
                                            Tag="{Binding}"
                                            Click="RemoveRule_Click" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Name="RulesHintText"
                           Classes="rules-hint"
                           Margin="0,6,0,0"
                           FontSize="12"
                           Opacity="0.65"
                           TextWrapping="Wrap"
                           Text="点击条目载入到下方对应区域修改，完成后点「保存」；点「取消编辑」或取消选中可退出编辑。" />
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,0,0,16">
                <Rectangle Height="1" Fill="{DynamicResource MaterialDividerBrush}" />
                <TextBlock Margin="0,12,0,12"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource MaterialPrimaryMidBrush}"
                           Text="策略选择" />

                <Border Name="RaritySection" Classes="form-section" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="某星干员总数" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" Text="稀有度：" />
                            <ComboBox Name="StarCombo"
                                      Classes="inline"
                                      Width="100"
                                      ItemsSource="{x:Static models:AppOptions.Stars}" />
                            <TextBox Name="RarityCountBox"
                                     Classes="inline"
                                     Width="88"
                                     PlaceholderText="数量" />
                            <Button Name="RarityRuleSubmitButton"
                                    Classes="inline"
                                    Content="添加"
                                    Click="AddRarityRule_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Name="CareerSection" Classes="form-section" Margin="0,4,0,4">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="某职业总数" />
                        <WrapPanel>
                            <TextBlock Margin="0,0,8,8" VerticalAlignment="Center" Text="职业：" />
                            <ComboBox Name="CareerCombo"
                                      Classes="inline"
                                      Width="120"
                                      Margin="0,0,16,8"
                                      ItemsSource="{x:Static models:AppOptions.Careers}" />
                            <TextBlock Margin="0,0,8,8" VerticalAlignment="Center" Text="方式：" />
                            <ComboBox Name="CareerConstraintModeCombo"
                                      Classes="inline"
                                      Width="100"
                                      Margin="0,0,8,8"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="特定值" />
                                <ComboBoxItem Content="范围" />
                            </ComboBox>
                            <TextBox Name="CareerCountBox"
                                     Classes="inline"
                                     Width="88"
                                     Margin="0,0,8,8"
                                     PlaceholderText="数量" />
                            <TextBox Name="CareerRangeMinBox"
                                     Classes="inline"
                                     Width="88"
                                     Margin="0,0,8,8"
                                     PlaceholderText="最小"
                                     IsVisible="False" />
                            <TextBox Name="CareerRangeMaxBox"
                                     Classes="inline"
                                     Width="88"
                                     Margin="0,0,8,8"
                                     PlaceholderText="最大"
                                     IsVisible="False" />
                            <Button Name="CareerRuleSubmitButton"
                                    Classes="inline"
                                    Margin="0,0,0,8"
                                    Content="添加"
                                    Click="AddCareerConstraint_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Name="StaffSection" Classes="form-section" Margin="0,4,0,0">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="某些干员总数" />
                        <WrapPanel Name="StaffSubsetFlowPanel">
                    <TextBlock Margin="0,0,2,8" VerticalAlignment="Center" Text="从" />
                    <Button Name="StaffSubsetAddButton"
                            Classes="inline"
                            MinWidth="36"
                            Width="36"
                            Margin="0,0,8,8"
                            Padding="0"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="White"
                            ToolTip.Tip="添加干员"
                            Content="+"
                            Click="StaffSubsetAddButton_Click" />
                    <TextBlock Margin="0,0,4,8" VerticalAlignment="Center" Text="列表内选择（" />
                    <ComboBox Name="StaffSubsetModeCombo"
                              Classes="inline"
                              Width="88"
                              Margin="0,0,8,8"
                              SelectedIndex="0">
                        <ComboBoxItem Content="固定值" />
                        <ComboBoxItem Content="范围" />
                    </ComboBox>
                    <TextBox Name="StaffSubsetExactCountBox"
                             Classes="inline"
                             Width="64"
                             Margin="0,0,4,8"
                             PlaceholderText="n" />
                    <StackPanel Name="StaffSubsetRangeInputPanel"
                                Margin="0,0,4,8"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                IsVisible="False">
                        <TextBox Name="StaffSubsetRangeMinBox"
                                 Classes="inline"
                                 Width="64"
                                 PlaceholderText="n" />
                        <TextBlock Margin="6,0" VerticalAlignment="Center" Text="-" />
                        <TextBox Name="StaffSubsetRangeMaxBox"
                                 Classes="inline"
                                 Width="64"
                                 PlaceholderText="m" />
                    </StackPanel>
                    <TextBlock Margin="0,0,8,8" VerticalAlignment="Center" Text="）个" />
                    <Button Name="StaffSubsetRuleSubmitButton"
                            Classes="inline"
                            Margin="0,0,0,8"
                            Content="添加"
                            Click="AddStaffSubsetRule_Click" />
                </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="5"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="8">
                <Button Theme="{StaticResource FlatButton}" Content="取消" Click="Cancel_Click" />
                <Button Content="确定" Click="Ok_Click" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>

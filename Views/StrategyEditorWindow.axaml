<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:domain="clr-namespace:arknights_random_team.Domain"
        xmlns:models="clr-namespace:arknights_random_team.Models"
        mc:Ignorable="d"
        x:Class="arknights_random_team.Views.StrategyEditorWindow"
        Title="编辑随机策略"
        Width="900"
        Height="720"
        MinWidth="760"
        MinHeight="600"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}"
        FontSize="14"
        Background="{StaticResource AppBackgroundBrush}">
    <Window.Styles>
        <Style Selector="TextBox.inline">
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MaxHeight" Value="40" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.inline">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MaxHeight" Value="40" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style Selector="ListBox#RulesList">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBox#RulesList ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ListBox#RulesList ListBoxItem:selected">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox#RulesList ListBoxItem:selected Border.rule-row">
            <Setter Property="Background" Value="{StaticResource AppPrimarySoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="ListBox#RulesList Button.cancel-edit">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ListBox#RulesList ListBoxItem:selected Button.cancel-edit">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="TextBlock.rules-hint.editing">
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.form-section">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style Selector="Border.form-section.editing">
            <Setter Property="Background" Value="{StaticResource AppPrimarySoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="72,*,68">
        <Border Grid.Row="0"
                Padding="24,0"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel VerticalAlignment="Center" Spacing="3">
                <TextBlock FontSize="20" FontWeight="Bold" Text="随机策略编辑器" />
                <TextBlock Classes="caption" Text="配置阵容生成时需要满足的规则" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1"
              Margin="24,20"
              ColumnDefinitions="330,20,*">
            <Grid Grid.Column="0" RowDefinitions="Auto,18,*">
                <Border Grid.Row="0" Classes="surface" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="field-label" Text="策略名称" />
                        <TextBox Name="NameBox"
                                 Classes="form-control dense"
                                 HorizontalAlignment="Stretch"
                                 PlaceholderText="输入策略名称" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Classes="surface" Padding="16">
                    <Grid RowDefinitions="Auto,10,*,10,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <TextBlock Classes="section-title" Text="已有规则" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Classes="caption"
                                       Text="选择后可编辑" />
                        </Grid>

                        <Grid Grid.Row="2">
                            <ListBox Name="RulesList"
                                     SelectionMode="Single"
                                     SelectionChanged="RulesList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="domain:StrategyRule">
                                        <Border Classes="rule-row"
                                                Padding="10,8"
                                                Background="{StaticResource AppSurfaceSubtleBrush}"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <Grid ColumnDefinitions="4,*,Auto">
                                                <Border Width="3"
                                                        Margin="0,1,9,1"
                                                        Background="{StaticResource AppPrimaryBrush}"
                                                        CornerRadius="2" />
                                                <TextBlock Grid.Column="1"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding SummaryLine}"
                                                           TextWrapping="Wrap" />
                                                <StackPanel Grid.Column="2"
                                                            Margin="8,0,0,0"
                                                            Orientation="Horizontal"
                                                            Spacing="2">
                                                    <Button Classes="secondary compact cancel-edit"
                                                            Content="取消编辑"
                                                            Click="CancelRuleEdit_Click" />
                                                    <Button Classes="danger compact"
                                                            Content="移除"
                                                            Tag="{Binding}"
                                                            Click="RemoveRule_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Name="RulesEmptyState"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Classes="muted"
                                       FontWeight="SemiBold"
                                       Text="暂无规则" />
                        </Grid>

                        <TextBlock Name="RulesHintText"
                                   Grid.Row="4"
                                   Classes="caption rules-hint"
                                   Text="未选择规则" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="2" RowDefinitions="Auto,12,*">
                <StackPanel Grid.Row="0" Spacing="3">
                    <TextBlock Classes="section-title" Text="规则构建器" />
                    <TextBlock Classes="caption" Text="稀有度、职业与指定干员" />
                </StackPanel>

                <ScrollViewer Grid.Row="2"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <Border Name="RaritySection" Classes="form-section">
                            <StackPanel Spacing="12">
                                <TextBlock FontWeight="SemiBold" Text="稀有度人数" />
                                <Grid ColumnDefinitions="1.1*,10,*,10,Auto"
                                      RowDefinitions="Auto,6,40">
                                    <TextBlock Grid.Column="0" Classes="caption" Text="稀有度" />
                                    <TextBlock Grid.Column="2" Classes="caption" Text="人数" />
                                    <ComboBox Name="StarCombo"
                                              Grid.Row="2"
                                              Grid.Column="0"
                                              Classes="inline dense"
                                              HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Static models:AppOptions.Stars}" />
                                    <TextBox Name="RarityCountBox"
                                             Grid.Row="2"
                                             Grid.Column="2"
                                             Classes="inline dense"
                                             HorizontalAlignment="Stretch"
                                             PlaceholderText="数量" />
                                    <Button Name="RarityRuleSubmitButton"
                                            Grid.Row="2"
                                            Grid.Column="4"
                                            Classes="primary inline"
                                            Content="添加"
                                            Click="AddRarityRule_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Name="CareerSection" Classes="form-section">
                            <StackPanel Spacing="12">
                                <TextBlock FontWeight="SemiBold" Text="职业人数" />
                                <Grid ColumnDefinitions="1.1*,10,*,10,1.45*,10,Auto"
                                      RowDefinitions="Auto,6,40">
                                    <TextBlock Grid.Column="0" Classes="caption" Text="职业" />
                                    <TextBlock Grid.Column="2" Classes="caption" Text="约束" />
                                    <TextBlock Grid.Column="4" Classes="caption" Text="人数 / 范围" />
                                    <ComboBox Name="CareerCombo"
                                              Grid.Row="2"
                                              Grid.Column="0"
                                              Classes="inline dense"
                                              HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Static models:AppOptions.Careers}" />
                                    <ComboBox Name="CareerConstraintModeCombo"
                                              Grid.Row="2"
                                              Grid.Column="2"
                                              Classes="inline dense"
                                              HorizontalAlignment="Stretch"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="固定值" />
                                        <ComboBoxItem Content="范围" />
                                    </ComboBox>
                                    <Grid Grid.Row="2" Grid.Column="4">
                                        <TextBox Name="CareerCountBox"
                                                 Classes="inline dense"
                                                 HorizontalAlignment="Stretch"
                                                 PlaceholderText="数量" />
                                        <Grid ColumnDefinitions="*,6,*">
                                            <TextBox Name="CareerRangeMinBox"
                                                     Grid.Column="0"
                                                     Classes="inline dense"
                                                     HorizontalAlignment="Stretch"
                                                     PlaceholderText="最小"
                                                     IsVisible="False" />
                                            <TextBox Name="CareerRangeMaxBox"
                                                     Grid.Column="2"
                                                     Classes="inline dense"
                                                     HorizontalAlignment="Stretch"
                                                     PlaceholderText="最大"
                                                     IsVisible="False" />
                                        </Grid>
                                    </Grid>
                                    <Button Name="CareerRuleSubmitButton"
                                            Grid.Row="2"
                                            Grid.Column="6"
                                            Classes="primary inline"
                                            Content="添加"
                                            Click="AddCareerConstraint_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Name="StaffSection" Classes="form-section">
                            <StackPanel Spacing="12">
                                <TextBlock FontWeight="SemiBold" Text="指定干员人数" />
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="caption" Text="干员范围" />
                                    <WrapPanel Name="StaffSubsetFlowPanel" MinHeight="36">
                                        <Button Name="StaffSubsetAddButton"
                                                Classes="secondary inline"
                                                MinWidth="96"
                                                Margin="0,0,8,6"
                                                Content="选择干员"
                                                Click="StaffSubsetAddButton_Click" />
                                    </WrapPanel>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,10,1.45*,10,Auto"
                                      RowDefinitions="Auto,6,40">
                                    <TextBlock Grid.Column="0" Classes="caption" Text="约束" />
                                    <TextBlock Grid.Column="2" Classes="caption" Text="人数 / 范围" />
                                    <ComboBox Name="StaffSubsetModeCombo"
                                              Grid.Row="2"
                                              Grid.Column="0"
                                              Classes="inline dense"
                                              HorizontalAlignment="Stretch"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="固定值" />
                                        <ComboBoxItem Content="范围" />
                                    </ComboBox>
                                    <TextBox Name="StaffSubsetExactCountBox"
                                             Grid.Row="2"
                                             Grid.Column="2"
                                             Classes="inline dense"
                                             HorizontalAlignment="Stretch"
                                             PlaceholderText="数量" />
                                    <Grid Name="StaffSubsetRangeInputPanel"
                                          Grid.Row="2"
                                          Grid.Column="2"
                                          ColumnDefinitions="*,6,*"
                                          IsVisible="False">
                                        <TextBox Name="StaffSubsetRangeMinBox"
                                                 Grid.Column="0"
                                                 Classes="inline dense"
                                                 HorizontalAlignment="Stretch"
                                                 PlaceholderText="最小" />
                                        <TextBox Name="StaffSubsetRangeMaxBox"
                                                 Grid.Column="2"
                                                 Classes="inline dense"
                                                 HorizontalAlignment="Stretch"
                                                 PlaceholderText="最大" />
                                    </Grid>
                                    <Button Name="StaffSubsetRuleSubmitButton"
                                            Grid.Row="2"
                                            Grid.Column="4"
                                            Classes="primary inline"
                                            Content="添加"
                                            Click="AddStaffSubsetRule_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Padding="24,0"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                <Button Classes="secondary" Content="取消" Click="Cancel_Click" />
                <Button Classes="primary" Content="保存策略" Click="Ok_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

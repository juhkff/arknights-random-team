<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:arknights_random_team.Views"
             mc:Ignorable="d"
             x:Class="arknights_random_team.Views.StaffThumb"
             x:Name="Root">
    <UserControl.Styles>
        <!-- 四态靠不透明度 + 重试按钮区分：
             没有图源 = 原样；排队中 = 略淡；加载中 = 明显压暗；失败 = 原样 + 重试按钮。 -->
        <Style Selector="StackPanel.thumb-state.queued">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="StackPanel.thumb-state.loading">
            <Setter Property="Opacity" Value="0.3" />
        </Style>
        <!-- Keep the placeholder's measured size when the bitmap arrives. -->
        <Style Selector="StackPanel.thumb-state.loaded">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Button.thumb-retry">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Padding" Value="6,1" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <views:ArtBitmap Name="ThumbArt"
                         Stretch="{Binding #Root.Stretch}"
                         ArtAlignment="{Binding #Root.VerticalArtAlignment}" />
        <StackPanel Classes="thumb-state"
                    Classes.queued="{Binding (views:ArtImage.LoadState), ElementName=ThumbArt, Converter={x:Static views:StaffCardVisual.IsArtQueued}}"
                    Classes.loading="{Binding (views:ArtImage.LoadState), ElementName=ThumbArt, Converter={x:Static views:StaffCardVisual.IsArtLoading}}"
                    Classes.loaded="{Binding (views:ArtImage.LoadState), ElementName=ThumbArt, Converter={x:Static views:StaffCardVisual.IsArtLoaded}}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="4">
            <views:ArtBitmap Name="ThumbPlaceholder"
                             Width="{Binding #Root.PlaceholderSize}"
                             Height="{Binding #Root.PlaceholderSize}"
                             Opacity="{Binding #Root.PlaceholderOpacity}"
                             Stretch="Uniform"
                             HorizontalAlignment="Center" />
            <!-- 只有「候选地址都失败」才给重试；没有图源（手动录入）重试没有意义。 -->
            <Button Name="ThumbRetry"
                    Classes="text compact thumb-retry"
                    Content="重试"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="重新加载图片"
                    IsVisible="{Binding (views:ArtImage.LoadState), ElementName=ThumbArt, Converter={x:Static views:StaffCardVisual.IsArtFailed}}"
                    Click="Retry_Click" />
        </StackPanel>
    </Panel>
</UserControl>

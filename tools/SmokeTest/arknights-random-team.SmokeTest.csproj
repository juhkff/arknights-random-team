<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>arknights_random_team.SmokeTest</RootNamespace>
        <AssemblyName>arknights-random-team.SmokeTest</AssemblyName>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <!-- 无头运行：不需要显示器或 GPU，用来验证界面真能加载并完成布局。 -->
        <PackageReference Include="Avalonia.Headless" Version="12.1.1" />
        <ProjectReference Include="../../Core/arknights-random-team.Core.csproj" />
    </ItemGroup>
</Project>

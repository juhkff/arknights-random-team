<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>arknights_random_team.Browser</RootNamespace>
        <AssemblyName>arknights-random-team-web</AssemblyName>
        <!-- WebAssembly 宿主默认视为自包含，会拒绝引用非自包含的项目。 -->
        <SelfContained>false</SelfContained>
        <!-- 本项目本身就是浏览器专用，入口点只在 browser 平台可用，无需平台兼容性告警。 -->
        <NoWarn>$(NoWarn);CA1416</NoWarn>
        <!-- 与宿主页通信的 [JSImport] 由 SDK 要求必须开启不安全代码（SYSLIB1074）。
             只影响本浏览器项目，共享库与桌面端不受影响。 -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- 资源全部使用相对路径（wwwroot/main.js 里 import './_framework/dotnet.js'），
             因此既能部署在域名根目录，也能部署在 GitHub Pages 的 /<仓库名>/ 子路径下。 -->
        <!-- 注意：不要开启 InvariantGlobalization。它会裁掉全球化数据，
             Skia 就无法按 Unicode 区段匹配字体回退，中文会全部变成方块。 -->
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>partial</TrimMode>
        <!-- .NET 10 裁剪发布默认关闭 System.Text.Json 反射序列化。
             策略与偏好仍走 JsonSerializer，关掉后 WASM 启动会直接失败。 -->
        <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Browser" Version="12.1.1" />
    </ItemGroup>

    <ItemGroup>
        <!-- 复用共享库里的全部界面与逻辑，只替换入口点。 -->
        <ProjectReference Include="../Core/arknights-random-team.Core.csproj" />
    </ItemGroup>
</Project>

<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:Material.Styles.Themes;assembly=Material.Styles"
             xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             xmlns:assists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             xmlns:dataGrid="clr-namespace:Material.Avalonia.DataGrid;assembly=Material.Avalonia.DataGrid"
             x:Class="arknights_random_team.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <FontFamily x:Key="AppFont">avares://arknights-random-team.Core/Assets/NotoSansSC-App.otf#Noto Sans CJK SC, Inter, Microsoft YaHei UI, Microsoft YaHei, PingFang SC, sans-serif</FontFamily>
        <FontFamily x:Key="AppMonoFont">Cascadia Code, Consolas, Menlo, monospace</FontFamily>

        <!-- 罗德岛作战终端：中性灰层次 + 薄荷主色，普通面板最多一层细描边。 -->
        <!-- 复用色值集中在这里：同一个颜色只写一次，其余令牌引用它，改一处即可全站生效。 -->
        <Color x:Key="AppPrimaryColor">#65E6C4</Color>
        <Color x:Key="AppMutedTextColor">#A5B2BF</Color>
        <Color x:Key="AppHoverSurfaceColor">#202831</Color>
        <Color x:Key="AppWellSurfaceColor">#141A20</Color>

        <!-- 圆角令牌：控件 6、卡片与面板 8、弹层 12。
             发丝线（装饰细条）2、焦点环 10、药丸 999 是有意例外，不算同层级混用。 -->
        <CornerRadius x:Key="AppRadiusControl">6</CornerRadius>
        <CornerRadius x:Key="AppRadiusSurface">8</CornerRadius>
        <CornerRadius x:Key="AppRadiusDialog">12</CornerRadius>
        <CornerRadius x:Key="AppRadiusFocusRing">10</CornerRadius>
        <CornerRadius x:Key="AppRadiusHairline">2</CornerRadius>
        <CornerRadius x:Key="AppRadiusIndicator">0,2,2,0</CornerRadius>
        <CornerRadius x:Key="AppRadiusPill">999</CornerRadius>

        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#101418" />
        <SolidColorBrush x:Key="AppSurfaceBrush" Color="#181E24" />
        <SolidColorBrush x:Key="AppSurfaceSubtleBrush" Color="#1C242C" />
        <SolidColorBrush x:Key="AppBorderBrush" Color="#303A45" />
        <SolidColorBrush x:Key="AppTextBrush" Color="#EDF4FA" />
        <SolidColorBrush x:Key="AppMutedTextBrush" Color="{StaticResource AppMutedTextColor}" />
        <SolidColorBrush x:Key="AppPrimaryBrush" Color="{StaticResource AppPrimaryColor}" />
        <SolidColorBrush x:Key="AppPrimaryHoverBrush" Color="#91F2D8" />
        <SolidColorBrush x:Key="AppPrimaryPressedBrush" Color="#3BBF9F" />
        <SolidColorBrush x:Key="AppPrimarySoftBrush" Color="#183A38" />
        <SolidColorBrush x:Key="AppOnPrimaryBrush" Color="#09251F" />
        <SolidColorBrush x:Key="AppSecondaryBrush" Color="#182D32" />
        <SolidColorBrush x:Key="AppSecondaryHoverBrush" Color="#234448" />
        <SolidColorBrush x:Key="AppSecondaryPressedBrush" Color="#2C5656" />
        <SolidColorBrush x:Key="AppSecondaryBorderBrush" Color="#386663" />
        <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppPrimaryColor}" />
        <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#183A38" />
        <SolidColorBrush x:Key="AppDangerBrush" Color="#FF8294" />
        <SolidColorBrush x:Key="AppDangerSoftBrush" Color="#331E2A" />
        <SolidColorBrush x:Key="AppDangerHoverBrush" Color="#502735" />
        <SolidColorBrush x:Key="AppDangerPressedBrush" Color="#6B3040" />
        <SolidColorBrush x:Key="AppDangerBorderBrush" Color="#7F4352" />
        <SolidColorBrush x:Key="AppSignalBrush" Color="#F3C969" />
        <SolidColorBrush x:Key="AppInputBrush" Color="{StaticResource AppWellSurfaceColor}" />
        <SolidColorBrush x:Key="AppInputHoverBrush" Color="{StaticResource AppHoverSurfaceColor}" />
        <SolidColorBrush x:Key="AppTableHeaderBrush" Color="#1A2128" />
        <SolidColorBrush x:Key="AppTableAlternateBrush" Color="#161C22" />
        <SolidColorBrush x:Key="AppTableHoverBrush" Color="{StaticResource AppHoverSurfaceColor}" />
        <SolidColorBrush x:Key="AppSidebarBrush" Color="#0E1318" />
        <SolidColorBrush x:Key="AppSidebarHoverBrush" Color="#1B242D" />
        <SolidColorBrush x:Key="AppSidebarPressedBrush" Color="#24303A" />
        <SolidColorBrush x:Key="AppSidebarActiveBrush" Color="#183A38" />
        <SolidColorBrush x:Key="AppSidebarActiveHoverBrush" Color="#234C47" />
        <SolidColorBrush x:Key="AppSidebarActivePressedBrush" Color="#2C5B53" />
        <SolidColorBrush x:Key="AppSidebarTextBrush" Color="#C0CEDB" />
        <SolidColorBrush x:Key="AppSidebarMutedBrush" Color="{StaticResource AppMutedTextColor}" />

        <SolidColorBrush x:Key="AppWellBrush" Color="{StaticResource AppWellSurfaceColor}" />
        <SolidColorBrush x:Key="AppCardBrush" Color="#181E24" />
        <SolidColorBrush x:Key="AppCardHoverBrush" Color="{StaticResource AppHoverSurfaceColor}" />
        <SolidColorBrush x:Key="AppGridLineBrush" Color="#24303A" />
        <SolidColorBrush x:Key="AppSignalSoftBrush" Color="#3A2F17" />
        <SolidColorBrush x:Key="AppVeilBrush" Color="#A0101418" />
        <SolidColorBrush x:Key="AppPoolRowBrush" Color="#16262C" />
        <SolidColorBrush x:Key="AppPoolRowHoverBrush" Color="#1C3338" />

        <Color x:Key="MaterialSnackbarBackgroundColor">#243C46</Color>
        <SolidColorBrush x:Key="MaterialSnackbarBackgroundBrush" Color="#243C46" />

        <ControlTheme x:Key="AppActionButtonTheme" TargetType="Button">
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Name="PART_ButtonMotion" RenderTransform="translate(0,0)">
                        <Grid.Transitions>
                            <Transitions>
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                            </Transitions>
                        </Grid.Transitions>
                        <Border Name="PART_FocusRing"
                                Margin="-4"
                                IsHitTestVisible="False"
                                Opacity="0"
                                BorderBrush="{StaticResource AppSignalBrush}"
                                BorderThickness="2"
                                CornerRadius="{StaticResource AppRadiusFocusRing}" />
                        <Border Name="PART_RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <Border.Transitions>
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.14" />
                                    <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
                                </Transitions>
                            </Border.Transitions>
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                                <ContentPresenter.Transitions>
                                    <Transitions>
                                        <BrushTransition Property="Foreground" Duration="0:0:0.14" />
                                    </Transitions>
                                </ContentPresenter.Transitions>
                            </ContentPresenter>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
                <Setter Property="Opacity" Value="1" />
            </Style>
            <Style Selector="^:pressed /template/ Grid#PART_ButtonMotion">
                <Setter Property="RenderTransform" Value="translate(0,1px)" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="AppCaptionButtonTheme" TargetType="Button">
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel Width="30" Height="30" ClipToBounds="False">
                        <Border Name="PART_Glow"
                                Margin="-2"
                                IsHitTestVisible="False"
                                Opacity="0"
                                CornerRadius="4"
                                Background="#183A38"
                                BoxShadow="0 0 16 1 #8065E6C4">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <Panel Name="PART_Motion" RenderTransform="scale(1)">
                            <Panel.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                                </Transitions>
                            </Panel.Transitions>
                            <Path Name="PART_Plate"
                                  Width="30" Height="30"
                                  Stretch="None"
                                  Fill="{TemplateBinding Background}"
                                  Stroke="{TemplateBinding BorderBrush}"
                                  StrokeThickness="1.2"
                                  StrokeJoin="Miter"
                                  Data="M 6,1 H 24 L 29,6 V 24 L 24,29 H 6 L 1,24 V 6 Z">
                                <Path.Transitions>
                                    <Transitions>
                                        <BrushTransition Property="Fill" Duration="0:0:0.12" />
                                        <BrushTransition Property="Stroke" Duration="0:0:0.12" />
                                    </Transitions>
                                </Path.Transitions>
                            </Path>
                            <Path Name="PART_Ticks"
                                  Width="30" Height="30"
                                  Stretch="None"
                                  IsHitTestVisible="False"
                                  Stroke="{StaticResource AppSecondaryBorderBrush}"
                                  StrokeThickness="1.3"
                                  StrokeLineCap="Square"
                                  Opacity="0.55"
                                  Data="M 2,10 V 2 H 10 M 20,2 H 28 V 10 M 2,20 V 28 H 10 M 20,28 H 28 V 20" />
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              HorizontalContentAlignment="Center"
                                              VerticalContentAlignment="Center" />
                        </Panel>
                    </Panel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#PART_Glow">
                <Setter Property="Opacity" Value="1" />
            </Style>
            <Style Selector="^:pointerover /template/ Panel#PART_Motion">
                <Setter Property="RenderTransform" Value="scale(1.08)" />
            </Style>
            <Style Selector="^:pressed /template/ Panel#PART_Motion">
                <Setter Property="RenderTransform" Value="scale(0.94)" />
            </Style>
            <Style Selector="^:pointerover /template/ Path#PART_Ticks">
                <Setter Property="Stroke" Value="{StaticResource AppPrimaryBrush}" />
                <Setter Property="Opacity" Value="1" />
            </Style>
            <Style Selector="^.close:pointerover /template/ Border#PART_Glow">
                <Setter Property="Background" Value="#331E2A" />
                <Setter Property="BoxShadow" Value="0 0 16 1 #80FF8294" />
            </Style>
            <Style Selector="^.close:pointerover /template/ Path#PART_Ticks">
                <Setter Property="Stroke" Value="{StaticResource AppDangerBrush}" />
                <Setter Property="Opacity" Value="1" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="AppRosterCardTheme" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_CardSurface"
                            Background="{StaticResource AppCardBrush}"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource AppRadiusSurface}"
                            ClipToBounds="True">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.16" />
                                <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                            </Transitions>
                        </Border.Transitions>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Margin="12" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#PART_CardSurface">
                <Setter Property="Background" Value="{StaticResource AppCardHoverBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="{x:Type DataGridColumnHeader}" TargetType="DataGridColumnHeader">
            <!-- 键盘可达：Tab 能停在列头上，空格/回车触发排序（排序由 StaffListView 接管）。 -->
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Border Name="PART_HeaderSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource AppGridLineBrush}"
                                BorderThickness="0,0,0,1">
                            <Border.Transitions>
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.14" />
                                </Transitions>
                            </Border.Transitions>
                            <Grid ColumnDefinitions="*,Auto">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                                <Rectangle Name="VerticalSeparator"
                                           Grid.Column="1"
                                           Width="1"
                                           Height="14"
                                           VerticalAlignment="Center"
                                           Opacity="0.45"
                                           Fill="{TemplateBinding SeparatorBrush}" />
                            </Grid>
                        </Border>
                        <Border Name="PART_HoverLine"
                                Height="2"
                                VerticalAlignment="Bottom"
                                IsHitTestVisible="False"
                                Background="Transparent" />
                        <Border Name="PART_FocusRing"
                                Margin="-2"
                                IsHitTestVisible="False"
                                Opacity="0"
                                BorderBrush="{StaticResource AppSignalBrush}"
                                BorderThickness="2"
                                CornerRadius="{StaticResource AppRadiusHairline}" />
                    </Panel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#PART_HoverLine">
                <Setter Property="Background" Value="{StaticResource AppSecondaryBorderBrush}" />
            </Style>
            <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
                <Setter Property="Opacity" Value="1" />
            </Style>
        </ControlTheme>
    </Application.Resources>

    <Application.Styles>
        <themes:MaterialTheme BaseTheme="Dark" PrimaryColor="Teal" SecondaryColor="Amber" />
        <dataGrid:MaterialDataGridStyles />

        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontWeight" Value="Regular" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
            <Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
            <Setter Property="WindowDecorations" Value="BorderOnly" />
        </Style>
        <Style Selector="ScrollBar">
            <Setter Property="Theme" Value="{StaticResource MaterialModernScrollBar}" />
        </Style>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="12" />
            <Setter Property="Margin" Value="0,6,3,6" />
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="12" />
            <Setter Property="Margin" Value="6,0,6,3" />
        </Style>

        <Style Selector="Border.surface">
            <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource AppRadiusSurface}" />
        </Style>
        <Style Selector="Border.surface-subtle">
            <Setter Property="Background" Value="{StaticResource AppSurfaceSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource AppRadiusSurface}" />
        </Style>
        <Style Selector="Border.data-frame">
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="TextBlock.page-title">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}" />
        </Style>

        <!-- Panels and chips used by every screen, so the surfaces read as one system. -->
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="{StaticResource AppSurfaceSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource AppRadiusPill}" />
            <Setter Property="Padding" Value="11,4" />
        </Style>
        <Style Selector="Border.avatar-frame">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="CornerRadius" Value="{StaticResource AppRadiusSurface}" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Background" Value="{StaticResource AppWellBrush}" />
        </Style>
        <Style Selector="Border.filter-chip">
            <Setter Property="Background" Value="{StaticResource AppPrimarySoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppSecondaryBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource AppRadiusControl}" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Stable hit areas; only the artwork shifts by one pixel on press. -->
        <Style Selector="Button">
            <Setter Property="Theme" Value="{StaticResource AppActionButtonTheme}" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{StaticResource AppSurfaceSubtleBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource AppRadiusControl}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextBlock.FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{StaticResource AppInputHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="{StaticResource AppTableHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppOnPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="{StaticResource AppPrimaryHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryHoverBrush}" />
        </Style>
        <Style Selector="Button.primary:pressed">
            <Setter Property="Background" Value="{StaticResource AppPrimaryPressedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryPressedBrush}" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="{StaticResource AppSecondaryBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppSecondaryBorderBrush}" />
        </Style>
        <Style Selector="Button.secondary:pointerover">
            <Setter Property="Background" Value="{StaticResource AppSecondaryHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="Button.secondary:pressed">
            <Setter Property="Background" Value="{StaticResource AppSecondaryPressedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{StaticResource AppDangerSoftBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppDangerBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppDangerBorderBrush}" />
        </Style>
        <Style Selector="Button.danger:pointerover">
            <Setter Property="Background" Value="{StaticResource AppDangerHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppDangerBrush}" />
        </Style>
        <Style Selector="Button.danger:pressed">
            <Setter Property="Background" Value="{StaticResource AppDangerPressedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppDangerBrush}" />
        </Style>
        <Style Selector="Button.danger /template/ Border#PART_FocusRing">
            <Setter Property="BorderBrush" Value="{StaticResource AppDangerBrush}" />
        </Style>
        <Style Selector="Button.text">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="Button.text:pointerover">
            <Setter Property="Background" Value="{StaticResource AppSecondaryHoverBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.text:pressed">
            <Setter Property="Background" Value="{StaticResource AppSecondaryPressedBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.compact">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="{StaticResource AppRadiusControl}" />
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="Width" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource AppRadiusControl}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.icon Path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stroke" Value="{StaticResource AppTextBrush}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
        </Style>
        <Style Selector="Button.icon:pointerover">
            <Setter Property="Background" Value="{StaticResource AppInputHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="Button.icon:pressed">
            <Setter Property="Background" Value="{StaticResource AppTableHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
        </Style>
        <Style Selector="Button.icon:pointerover Path">
            <Setter Property="Stroke" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="Button.caption">
            <Setter Property="Theme" Value="{StaticResource AppCaptionButtonTheme}" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Width" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{StaticResource AppSidebarHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppSecondaryBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.caption Path.caption-icon">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stroke" Value="{StaticResource AppSidebarTextBrush}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
        </Style>
        <Style Selector="Button.caption:pointerover">
            <Setter Property="Background" Value="{StaticResource AppPrimarySoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="Button.caption:pressed">
            <Setter Property="Background" Value="{StaticResource AppSidebarActivePressedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryHoverBrush}" />
        </Style>
        <Style Selector="Button.caption:pointerover Path.caption-icon">
            <Setter Property="Stroke" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="Button.caption:pressed Path.caption-icon">
            <Setter Property="Stroke" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="Button.caption.close:pointerover">
            <Setter Property="Background" Value="{StaticResource AppDangerSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppDangerBrush}" />
        </Style>
        <Style Selector="Button.caption.close:pressed">
            <Setter Property="Background" Value="{StaticResource AppDangerHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppDangerBrush}" />
        </Style>
        <Style Selector="Button.caption.close:pointerover Path.caption-icon">
            <Setter Property="Stroke" Value="{StaticResource AppDangerBrush}" />
        </Style>
        <Style Selector="Button.caption.close:pressed Path.caption-icon">
            <Setter Property="Stroke" Value="{StaticResource AppDangerBrush}" />
        </Style>
        <Style Selector="Button.filter-trigger.active">
            <Setter Property="Background" Value="{StaticResource AppPrimarySoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="Button.filter-trigger.active:pointerover">
            <Setter Property="Background" Value="{StaticResource AppSidebarActiveHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="Button.filter-trigger.active:pressed">
            <Setter Property="Background" Value="{StaticResource AppPrimaryHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
            <Setter Property="assists:SelectionControlAssist.Size" Value="18" />
        </Style>
        <Style Selector="Slider">
            <Setter Property="Focusable" Value="True" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <!-- 紧凑输入：方案 §3.4 要求就地编辑更紧凑；此前 dense 类被用了 24 次却没有定义。 -->
        <Style Selector="TextBox.dense">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MaxHeight" Value="32" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="ComboBox.dense">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MaxHeight" Value="32" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="TextBox.form-control">
            <Setter Property="Theme" Value="{StaticResource SoloTextBox}" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MaxHeight" Value="40" />
            <Setter Property="Padding" Value="12,2" />
            <Setter Property="Background" Value="{StaticResource AppInputBrush}" />
            <Setter Property="PlaceholderForeground" Value="{StaticResource AppMutedTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource AppRadiusControl}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="UseFloatingPlaceholder" Value="False" />
        </Style>
        <Style Selector="TextBox.form-control:pointerover">
            <Setter Property="Background" Value="{StaticResource AppInputHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppSecondaryBorderBrush}" />
        </Style>
        <Style Selector="TextBox.form-control:focus-within">
            <Setter Property="Background" Value="{StaticResource AppInputHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="TextBox.form-control /template/ Panel#PART_TextContainer">
            <Setter Property="Margin" Value="14,0" />
        </Style>
        <!-- 就地校验失败：红色描边优先于悬停/焦点配色，配合 ToolTip 说明期望格式。 -->
        <Style Selector="TextBox.input-error">
            <Setter Property="BorderBrush" Value="{StaticResource AppDangerBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="TextBox.input-error:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource AppDangerBrush}" />
        </Style>
        <Style Selector="TextBox.input-error:focus-within">
            <Setter Property="BorderBrush" Value="{StaticResource AppDangerBrush}" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MaxDropDownHeight" Value="360" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        </Style>
        <Style Selector="ComboBox.form-control">
            <Setter Property="Theme" Value="{StaticResource MaterialComboBox}" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MaxHeight" Value="40" />
            <Setter Property="Padding" Value="12,2" />
            <Setter Property="Background" Value="{StaticResource AppInputBrush}" />
            <Setter Property="PlaceholderForeground" Value="{StaticResource AppMutedTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource AppRadiusControl}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox.form-control:pointerover">
            <Setter Property="Background" Value="{StaticResource AppInputHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppSecondaryBorderBrush}" />
        </Style>
        <Style Selector="ComboBox.form-control:focus-within">
            <Setter Property="Background" Value="{StaticResource AppInputHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="ComboBox.form-control /template/ Panel#PART_RootPanel">
            <Setter Property="Height" Value="40" />
        </Style>
        <Style Selector="ComboBox.form-control /template/ TextBlock#PART_PlaceholderText">
            <Setter Property="Margin" Value="14,0,36,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="ComboBox.form-control /template/ controls|MaterialUnderline#PART_Underline">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontWeight" Value="Regular" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        </Style>
        <Style Selector="TextBox.inline">
            <Setter Property="Theme" Value="{StaticResource SoloTextBox}" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Background" Value="{StaticResource AppInputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource AppRadiusControl}" />
            <Setter Property="UseFloatingPlaceholder" Value="False" />
        </Style>
        <Style Selector="TextBox.inline:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource AppSecondaryBorderBrush}" />
        </Style>
        <Style Selector="TextBox.inline:focus-within">
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="TextBox.inline /template/ Panel#PART_TextContainer">
            <Setter Property="Margin" Value="10,0" />
        </Style>
        <Style Selector="TextBox.staff-editor /template/ Panel#PART_TextContainer">
            <Setter Property="Margin" Value="8,0" />
        </Style>
        <Style Selector="ComboBox.inline">
            <Setter Property="Theme" Value="{StaticResource MaterialComboBox}" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MaxHeight" Value="36" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Background" Value="{StaticResource AppInputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource AppRadiusControl}" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox.inline:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource AppSecondaryBorderBrush}" />
        </Style>
        <Style Selector="ComboBox.inline:focus-within">
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="ComboBox.inline /template/ Panel#PART_RootPanel">
            <Setter Property="Height" Value="36" />
        </Style>
        <Style Selector="ComboBox.inline /template/ TextBlock#PART_PlaceholderText">
            <Setter Property="Margin" Value="10,0,30,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="ComboBox.inline /template/ controls|MaterialUnderline#PART_Underline">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ComboBox.staff-choice /template/ Panel#PART_RootPanel">
            <Setter Property="Height" Value="36" />
        </Style>
        <Style Selector="ComboBox.staff-choice /template/ controls|MaterialUnderline#PART_Underline">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="DataGrid">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource AppGridLineBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="CanUserResizeColumns" Value="False" />
            <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
            <Setter Property="RowBackground" Value="{StaticResource AppSurfaceBrush}" />
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Theme" Value="{StaticResource {x:Type DataGridColumnHeader}}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}" />
            <Setter Property="Background" Value="{StaticResource AppTableHeaderBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SeparatorBrush" Value="{StaticResource AppBorderBrush}" />
        </Style>
        <Style Selector="DataGridColumnHeader:pointerover">
            <Setter Property="Background" Value="{StaticResource AppInputHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        </Style>
        <Style Selector="DataGridColumnHeader:pressed">
            <Setter Property="Background" Value="{StaticResource AppTableHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        </Style>
        <Style Selector="DataGridColumnHeader:focus-visible">
            <Setter Property="Background" Value="{StaticResource AppTableHeaderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        </Style>
        <Style Selector="DataGridRow">
            <Setter Property="MinHeight" Value="56" />
        </Style>
        <Style Selector="DataGridRow:nth-child(even)">
            <Setter Property="Background" Value="{StaticResource AppTableAlternateBrush}" />
        </Style>
        <Style Selector="DataGridRow:pointerover">
            <Setter Property="Background" Value="{StaticResource AppTableHoverBrush}" />
        </Style>
        <Style Selector="DataGridRow:selected">
            <Setter Property="Background" Value="{StaticResource AppTableHoverBrush}" />
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="DataGridCell:focus-within">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="DataGridCell TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="controls|SnackbarHost /template/ ItemsControl#PART_SnackbarHostItemsContainer controls|Card">
            <Setter Property="Background" Value="#243C46" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
            <Setter Property="Padding" Value="24,16" />
            <Setter Property="MinWidth" Value="280" />
            <Setter Property="CornerRadius" Value="{StaticResource AppRadiusSurface}" />
        </Style>
        <Style Selector="TextBlock#PART_SnackbarSupportingText">
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </Application.Styles>
</Application>

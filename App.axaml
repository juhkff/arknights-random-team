<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:Material.Styles.Themes;assembly=Material.Styles"
             xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             xmlns:dataGrid="clr-namespace:Material.Avalonia.DataGrid;assembly=Material.Avalonia.DataGrid"
             x:Class="arknights_random_team.App"
             RequestedThemeVariant="Light">
    <Application.Resources>
        <FontFamily x:Key="AppFont">Microsoft YaHei, PingFang SC, Noto Sans CJK SC, Source Han Sans SC, Inter, sans-serif</FontFamily>

        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F5F7" />
        <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AppSurfaceSubtleBrush" Color="#F8F9FB" />
        <SolidColorBrush x:Key="AppBorderBrush" Color="#DDE2E7" />
        <SolidColorBrush x:Key="AppTextBrush" Color="#20242A" />
        <SolidColorBrush x:Key="AppMutedTextBrush" Color="#68717D" />
        <SolidColorBrush x:Key="AppPrimaryBrush" Color="#5B42C7" />
        <SolidColorBrush x:Key="AppPrimaryHoverBrush" Color="#4C35B1" />
        <SolidColorBrush x:Key="AppPrimaryPressedBrush" Color="#40299D" />
        <SolidColorBrush x:Key="AppPrimarySoftBrush" Color="#EFECFA" />
        <SolidColorBrush x:Key="AppSecondaryBrush" Color="#F4F2FB" />
        <SolidColorBrush x:Key="AppSecondaryHoverBrush" Color="#E9E5F7" />
        <SolidColorBrush x:Key="AppSecondaryPressedBrush" Color="#DED8F1" />
        <SolidColorBrush x:Key="AppSecondaryBorderBrush" Color="#C9C1E7" />
        <SolidColorBrush x:Key="AppAccentBrush" Color="#0E8873" />
        <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#E8F5F1" />
        <SolidColorBrush x:Key="AppDangerBrush" Color="#C43E4D" />
        <SolidColorBrush x:Key="AppDangerSoftBrush" Color="#FCECEF" />
        <SolidColorBrush x:Key="AppDangerHoverBrush" Color="#F8DDE1" />
        <SolidColorBrush x:Key="AppDangerPressedBrush" Color="#F2C9CF" />
        <SolidColorBrush x:Key="AppDangerBorderBrush" Color="#E6A7AF" />
        <SolidColorBrush x:Key="AppSignalBrush" Color="#F2C94C" />
        <SolidColorBrush x:Key="AppInputBrush" Color="#FBFCFD" />
        <SolidColorBrush x:Key="AppInputHoverBrush" Color="#F7F7FB" />
        <SolidColorBrush x:Key="AppTableHeaderBrush" Color="#EEF1F4" />
        <SolidColorBrush x:Key="AppTableAlternateBrush" Color="#FAFBFC" />
        <SolidColorBrush x:Key="AppTableHoverBrush" Color="#F3F1FA" />
        <SolidColorBrush x:Key="AppSidebarBrush" Color="#20242B" />
        <SolidColorBrush x:Key="AppSidebarItemBrush" Color="#262C34" />
        <SolidColorBrush x:Key="AppSidebarHoverBrush" Color="#343D49" />
        <SolidColorBrush x:Key="AppSidebarPressedBrush" Color="#404B59" />
        <SolidColorBrush x:Key="AppSidebarActiveBrush" Color="#4A426E" />
        <SolidColorBrush x:Key="AppSidebarActiveHoverBrush" Color="#554B7E" />
        <SolidColorBrush x:Key="AppSidebarActivePressedBrush" Color="#403960" />
        <SolidColorBrush x:Key="AppSidebarTextBrush" Color="#C6CBD2" />
        <SolidColorBrush x:Key="AppSidebarMutedBrush" Color="#8E97A3" />

        <Color x:Key="MaterialSnackbarBackgroundColor">#30343B</Color>
        <SolidColorBrush x:Key="MaterialSnackbarBackgroundBrush" Color="#30343B" />

        <ControlTheme x:Key="AppActionButtonTheme" TargetType="Button">
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <Border Name="PART_FocusRing"
                                Margin="-3"
                                IsHitTestVisible="False"
                                Opacity="0"
                                BorderBrush="{StaticResource AppPrimaryBrush}"
                                BorderThickness="2"
                                CornerRadius="8" />
                        <Border Name="PART_RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <Border.Transitions>
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.14" />
                                    <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
                                </Transitions>
                            </Border.Transitions>
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                                <ContentPresenter.Transitions>
                                    <Transitions>
                                        <BrushTransition Property="Foreground" Duration="0:0:0.14" />
                                    </Transitions>
                                </ContentPresenter.Transitions>
                            </ContentPresenter>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
                <Setter Property="Opacity" Value="1" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="{x:Type DataGridColumnHeader}" TargetType="DataGridColumnHeader">
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="*,Auto" Background="{TemplateBinding Background}">
                        <Panel>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                            <Path Name="SortIcon"
                                  Width="8"
                                  Height="8"
                                  Margin="0,0,8,0"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Stretch="Uniform"
                                  IsVisible="False"
                                  Fill="{TemplateBinding Foreground}"
                                  Data="F1 M -5.215,6.099L 5.215,6.099L 0,0L -5.215,6.099 Z " />
                        </Panel>
                        <Rectangle Name="VerticalSeparator"
                                   Grid.Column="1"
                                   Width="1"
                                   Height="16"
                                   VerticalAlignment="Center"
                                   Fill="{TemplateBinding SeparatorBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:sortascending /template/ Path#SortIcon">
                <Setter Property="IsVisible" Value="True" />
                <Setter Property="RenderTransform" Value="scale(0.85,0.85)" />
            </Style>
            <Style Selector="^:sortdescending /template/ Path#SortIcon">
                <Setter Property="IsVisible" Value="True" />
                <Setter Property="RenderTransform" Value="scale(0.85,-0.85)" />
            </Style>
        </ControlTheme>
    </Application.Resources>

    <Application.Styles>
        <themes:MaterialTheme BaseTheme="Light"
                              PrimaryColor="DeepPurple"
                              SecondaryColor="Teal" />
        <dataGrid:MaterialDataGridStyles />

        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontWeight" Value="Regular" />
            <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        </Style>

        <Style Selector="ScrollBar">
            <Setter Property="Theme" Value="{StaticResource MaterialModernScrollBar}" />
        </Style>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="10" />
            <Setter Property="Margin" Value="0,6,4,6" />
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="10" />
            <Setter Property="Margin" Value="6,0,6,4" />
        </Style>

        <Style Selector="Border.surface">
            <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BoxShadow" Value="0 1 3 0 #12000000" />
        </Style>
        <Style Selector="Border.surface-subtle">
            <Setter Property="Background" Value="{StaticResource AppSurfaceSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Border.input-shell">
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="{StaticResource AppInputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Border.data-frame">
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="Border.status-accent">
            <Setter Property="Background" Value="{StaticResource AppAccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="#B8DDD5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="MinHeight" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}" />
        </Style>

        <Style Selector="Button">
            <Setter Property="Theme" Value="{StaticResource AppActionButtonTheme}" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
            <Setter Property="BorderBrush" Value="#CDD3DA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="TextBlock.FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{StaticResource AppSurfaceSubtleBrush}" />
            <Setter Property="BorderBrush" Value="#B9C1CA" />
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="#ECEFF2" />
            <Setter Property="BorderBrush" Value="#AEB7C1" />
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Opacity" Value="0.46" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="Button.primary /template/ Border#PART_RootBorder">
            <Setter Property="BoxShadow" Value="0 2 5 0 #29000000" />
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="{StaticResource AppPrimaryHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryHoverBrush}" />
        </Style>
        <Style Selector="Button.primary:pressed">
            <Setter Property="Background" Value="{StaticResource AppPrimaryPressedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryPressedBrush}" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ Border#PART_RootBorder">
            <Setter Property="BoxShadow" Value="0 1 2 0 #24000000" />
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="{StaticResource AppSecondaryBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppSecondaryBorderBrush}" />
        </Style>
        <Style Selector="Button.secondary:pointerover">
            <Setter Property="Background" Value="{StaticResource AppSecondaryHoverBrush}" />
            <Setter Property="BorderBrush" Value="#AFA3DA" />
        </Style>
        <Style Selector="Button.secondary:pressed">
            <Setter Property="Background" Value="{StaticResource AppSecondaryPressedBrush}" />
            <Setter Property="BorderBrush" Value="#9789CF" />
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{StaticResource AppDangerSoftBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppDangerBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppDangerBorderBrush}" />
        </Style>
        <Style Selector="Button.danger:pointerover">
            <Setter Property="Background" Value="{StaticResource AppDangerHoverBrush}" />
            <Setter Property="BorderBrush" Value="#D97C87" />
        </Style>
        <Style Selector="Button.danger:pressed">
            <Setter Property="Background" Value="{StaticResource AppDangerPressedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppDangerBrush}" />
        </Style>
        <Style Selector="Button.danger /template/ Border#PART_FocusRing">
            <Setter Property="BorderBrush" Value="{StaticResource AppDangerBrush}" />
        </Style>

        <Style Selector="Button.icon">
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="Width" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{StaticResource AppSurfaceSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
        </Style>
        <Style Selector="Button.icon:pointerover">
            <Setter Property="Background" Value="{StaticResource AppPrimarySoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppSecondaryBorderBrush}" />
        </Style>
        <Style Selector="Button.text">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="Button.text:pointerover">
            <Setter Property="Background" Value="{StaticResource AppPrimarySoftBrush}" />
        </Style>
        <Style Selector="Button.text:pressed">
            <Setter Property="Background" Value="{StaticResource AppSecondaryPressedBrush}" />
        </Style>
        <Style Selector="Button.compact">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="40" />
        </Style>
        <Style Selector="TextBox.form-control">
            <Setter Property="Theme" Value="{StaticResource SoloTextBox}" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="MaxHeight" Value="44" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Background" Value="{StaticResource AppInputBrush}" />
            <Setter Property="PlaceholderForeground" Value="{StaticResource AppMutedTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="UseFloatingPlaceholder" Value="False" />
        </Style>
        <Style Selector="TextBox.form-control:pointerover">
            <Setter Property="Background" Value="{StaticResource AppInputHoverBrush}" />
            <Setter Property="BorderBrush" Value="#C6CBD3" />
        </Style>
        <Style Selector="TextBox.form-control:focus-within">
            <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="TextBox.form-control /template/ Panel#PART_TextContainer">
            <Setter Property="Margin" Value="12,0" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="MaxDropDownHeight" Value="300" />
        </Style>
        <Style Selector="ComboBox.form-control">
            <Setter Property="Theme" Value="{StaticResource MaterialComboBox}" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="MaxHeight" Value="44" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Background" Value="{StaticResource AppInputBrush}" />
            <Setter Property="PlaceholderForeground" Value="{StaticResource AppMutedTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox.form-control:pointerover">
            <Setter Property="Background" Value="{StaticResource AppInputHoverBrush}" />
            <Setter Property="BorderBrush" Value="#C6CBD3" />
        </Style>
        <Style Selector="ComboBox.form-control:focus-within">
            <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="ComboBox.form-control /template/ Panel#PART_RootPanel">
            <Setter Property="Height" Value="44" />
        </Style>
        <Style Selector="ComboBox.form-control /template/ TextBlock#PART_PlaceholderText">
            <Setter Property="Margin" Value="12,0,34,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="ComboBox.form-control /template/ controls|MaterialUnderline#PART_Underline">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="FontWeight" Value="Regular" />
        </Style>
        <Style Selector="TextBox.inline">
            <Setter Property="Theme" Value="{StaticResource SoloTextBox}" />
            <Setter Property="Background" Value="{StaticResource AppInputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="UseFloatingPlaceholder" Value="False" />
        </Style>
        <Style Selector="TextBox.inline:pointerover">
            <Setter Property="BorderBrush" Value="#C6CBD3" />
        </Style>
        <Style Selector="TextBox.inline:focus-within">
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="TextBox.inline /template/ Panel#PART_TextContainer">
            <Setter Property="Margin" Value="10,0" />
        </Style>
        <Style Selector="TextBox.staff-editor /template/ Panel#PART_TextContainer">
            <Setter Property="Margin" Value="8,0" />
        </Style>
        <Style Selector="ComboBox.inline">
            <Setter Property="Theme" Value="{StaticResource MaterialComboBox}" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MaxHeight" Value="40" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Background" Value="{StaticResource AppInputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox.inline:pointerover">
            <Setter Property="BorderBrush" Value="#C6CBD3" />
        </Style>
        <Style Selector="ComboBox.inline:focus-within">
            <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="ComboBox.inline /template/ Panel#PART_RootPanel">
            <Setter Property="Height" Value="40" />
        </Style>
        <Style Selector="ComboBox.inline /template/ TextBlock#PART_PlaceholderText">
            <Setter Property="Margin" Value="10,0,30,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="ComboBox.inline /template/ controls|MaterialUnderline#PART_Underline">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ComboBox.staff-choice /template/ Panel#PART_RootPanel">
            <Setter Property="Height" Value="36" />
        </Style>
        <Style Selector="ComboBox.staff-choice /template/ controls|MaterialUnderline#PART_Underline">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="DataGrid">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E8EC" />
            <Setter Property="VerticalGridLinesBrush" Value="#E5E8EC" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="CanUserResizeColumns" Value="False" />
            <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
            <Setter Property="RowBackground" Value="{StaticResource AppSurfaceBrush}" />
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Theme" Value="{StaticResource {x:Type DataGridColumnHeader}}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
            <Setter Property="Background" Value="{StaticResource AppTableHeaderBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="SeparatorBrush" Value="#D9DEE4" />
        </Style>
        <Style Selector="DataGridColumnHeader:pointerover">
            <Setter Property="Background" Value="{StaticResource AppPrimarySoftBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="DataGridRow">
            <Setter Property="MinHeight" Value="46" />
        </Style>
        <Style Selector="DataGridRow:nth-child(even)">
            <Setter Property="Background" Value="{StaticResource AppTableAlternateBrush}" />
        </Style>
        <Style Selector="DataGridRow:pointerover">
            <Setter Property="Background" Value="{StaticResource AppTableHoverBrush}" />
        </Style>
        <Style Selector="DataGridRow:selected">
            <Setter Property="Background" Value="{StaticResource AppPrimarySoftBrush}" />
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="DataGridCell:focus-within">
            <Setter Property="Background" Value="#F7F5FD" />
        </Style>
        <Style Selector="DataGridCell TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="controls|SnackbarHost /template/ ItemsControl#PART_SnackbarHostItemsContainer controls|Card">
            <Setter Property="Background" Value="#30343B" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="22,14" />
            <Setter Property="MinWidth" Value="280" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="TextBlock#PART_SnackbarSupportingText">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </Application.Styles>
</Application>

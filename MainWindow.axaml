<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:arknights_random_team.Views"
        x:Class="arknights_random_team.MainWindow"
        Title="明日方舟随机阵容"
        Width="1240"
        Height="880"
        MinWidth="768"
        MinHeight="740"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}">
    <DockPanel>
        <views:ThemedTitleBar DockPanel.Dock="Top" />
        <views:MainView />
    </DockPanel>
</Window>

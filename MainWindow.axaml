<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
        mc:Ignorable="d"
        d:DesignWidth="1000"
        d:DesignHeight="760"
        x:Class="arknights_random_team.MainWindow"
        Title="明日方舟随机阵容"
        Width="1000"
        Height="760"
        MinWidth="800"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}"
        FontSize="14"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource AppTextBrush}">
    <Window.Styles>
        <Style Selector="Button.nav-item">
            <Setter Property="Theme" Value="{StaticResource AppActionButtonTheme}" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="10,2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{StaticResource AppSidebarItemBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppSidebarTextBrush}" />
            <Setter Property="BorderBrush" Value="#303741" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.nav-item:pointerover">
            <Setter Property="Background" Value="{StaticResource AppSidebarHoverBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#4A5665" />
        </Style>
        <Style Selector="Button.nav-item:pressed">
            <Setter Property="Background" Value="{StaticResource AppSidebarPressedBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#5A6675" />
        </Style>
        <Style Selector="Button.nav-item.active">
            <Setter Property="Background" Value="{StaticResource AppSidebarActiveBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#68609A" />
        </Style>
        <Style Selector="Button.nav-item.active:pointerover">
            <Setter Property="Background" Value="{StaticResource AppSidebarActiveHoverBrush}" />
            <Setter Property="BorderBrush" Value="#776EAB" />
        </Style>
        <Style Selector="Button.nav-item.active:pressed">
            <Setter Property="Background" Value="{StaticResource AppSidebarActivePressedBrush}" />
            <Setter Property="BorderBrush" Value="#5E568B" />
        </Style>
        <Style Selector="Button.nav-item /template/ Border#PART_FocusRing">
            <Setter Property="BorderBrush" Value="{StaticResource AppSignalBrush}" />
        </Style>
        <Style Selector="Button.nav-item Border.nav-indicator">
            <Setter Property="Background" Value="{StaticResource AppSignalBrush}" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nav-item.active Border.nav-indicator">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.nav-item TextBlock.nav-index">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AppSidebarMutedBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.14" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nav-item:pointerover TextBlock.nav-index">
            <Setter Property="Foreground" Value="#C4CCD7" />
        </Style>
        <Style Selector="Button.nav-item.active TextBlock.nav-index">
            <Setter Property="Foreground" Value="{StaticResource AppSignalBrush}" />
        </Style>
        <Style Selector="Button.nav-item TextBlock.nav-label">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.nav-item.active TextBlock.nav-label">
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Styles>

    <controls:SnackbarHost HostName="MainSnackbar"
                           SnackbarHorizontalAlignment="Center"
                           SnackbarVerticalAlignment="Bottom">
        <Grid ColumnDefinitions="196,*">
            <Border Grid.Column="0"
                    Background="{StaticResource AppSidebarBrush}"
                    BorderBrush="#343A43"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Margin="20,24,16,22"
                          ColumnDefinitions="44,12,*">
                        <Border Grid.Column="0"
                                Width="44"
                                Height="44"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="{StaticResource AppSignalBrush}"
                                CornerRadius="6">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="#20242B"
                                       Text="RT" />
                        </Border>
                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                            <TextBlock FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Text="明日方舟" />
                            <TextBlock FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AppSidebarMutedBrush}"
                                       Text="RANDOM TEAM OPS" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,8" Spacing="2">
                        <TextBlock Margin="22,0,0,8"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppSidebarMutedBrush}"
                                   Text="OPERATIONS / 功能" />
                        <Button Name="GenerateNavButton"
                                Classes="nav-item"
                                Click="ChangeToGenerate">
                            <Grid ColumnDefinitions="4,38,*">
                                <Border Classes="nav-indicator" CornerRadius="2" />
                                <TextBlock Grid.Column="1"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Classes="nav-index"
                                           Text="01" />
                                <TextBlock Grid.Column="2"
                                           Margin="4,0,12,0"
                                           VerticalAlignment="Center"
                                           Classes="nav-label"
                                           Text="阵容生成" />
                            </Grid>
                        </Button>
                        <Button Name="InputNavButton"
                                Classes="nav-item"
                                Click="ChangeToInput">
                            <Grid ColumnDefinitions="4,38,*">
                                <Border Classes="nav-indicator" CornerRadius="2" />
                                <TextBlock Grid.Column="1"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Classes="nav-index"
                                           Text="02" />
                                <TextBlock Grid.Column="2"
                                           Margin="4,0,12,0"
                                           VerticalAlignment="Center"
                                           Classes="nav-label"
                                           Text="干员录入" />
                            </Grid>
                        </Button>
                        <Button Name="ListNavButton"
                                Classes="nav-item"
                                Click="ChangeToList">
                            <Grid ColumnDefinitions="4,38,*">
                                <Border Classes="nav-indicator" CornerRadius="2" />
                                <TextBlock Grid.Column="1"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Classes="nav-index"
                                           Text="03" />
                                <TextBlock Grid.Column="2"
                                           Margin="4,0,12,0"
                                           VerticalAlignment="Center"
                                           Classes="nav-label"
                                           Text="干员列表" />
                            </Grid>
                        </Button>
                        <Button Name="StrategyNavButton"
                                Classes="nav-item"
                                Click="ChangeToRandomStrategy">
                            <Grid ColumnDefinitions="4,38,*">
                                <Border Classes="nav-indicator" CornerRadius="2" />
                                <TextBlock Grid.Column="1"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Classes="nav-index"
                                           Text="04" />
                                <TextBlock Grid.Column="2"
                                           Margin="4,0,12,0"
                                           VerticalAlignment="Center"
                                           Classes="nav-label"
                                           Text="随机策略" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <Border Grid.Row="2"
                            Margin="16,12,16,20"
                            Padding="12,10"
                            Background="#29332F"
                            BorderBrush="#36463F"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid ColumnDefinitions="4,10,*">
                            <Border Width="4"
                                    Background="{StaticResource AppAccentBrush}"
                                    CornerRadius="2" />
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#75D4C3"
                                           Text="LOCAL / 本地数据" />
                                <TextBlock FontSize="11"
                                           Foreground="{StaticResource AppSidebarMutedBrush}"
                                           Text="退出时自动保存" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="72,*">
                <Border Grid.Row="0"
                        Padding="26,0"
                        Background="{StaticResource AppSurfaceBrush}"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="4,14,*">
                        <Border Width="4"
                                Height="36"
                                VerticalAlignment="Center"
                                Background="{StaticResource AppPrimaryBrush}"
                                CornerRadius="2" />
                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Spacing="3">
                            <TextBlock Name="WindowTitle"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AppTextBrush}"
                                       Text="阵容生成" />
                            <TextBlock Name="WindowSubtitle"
                                       Classes="caption"
                                       Text="从已启用的干员中生成一支阵容" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ContentControl Name="PageHost"
                                Grid.Row="1"
                                Margin="24"
                                ClipToBounds="False" />
            </Grid>
        </Grid>
    </controls:SnackbarHost>
</Window>
